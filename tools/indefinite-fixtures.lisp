(in-package #:coalton-linalg/tools)

;;; Optional artifact driver for the dense symmetric indefinite factorization. For every
;;; <name>.S.txt in a folder it factors at each shift named by <name>.meta.txt, solves with
;;; <name>.b.txt, and writes files an independent reviewer can recompute from. See
;;; docs/indefinite-ldlt.md, Artifact driver, for the file protocol.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (sb-ext:add-package-local-nickname "IL" "COALTON-LINALG/DENSE/INDEFINITE-LDLT"))

(defun read-dense-symmetric (directory name)
  "Read <name>.S.txt: n, then n*n values in column-major order."
  (with-open-file (in (fixture-path directory name ".S.txt"))
    (let ((n (read-numeric in)))
      (unless (and (integerp n) (>= n 0)) (error "Invalid dense header: ~A" name))
      (let ((a (darray (* n n))))
        (dotimes (q (* n n))
          (let ((v (read-numeric in)))
            (unless (realp v) (error "Malformed dense entry ~A/~D." name q))
            (setf (aref a q) (coerce v 'double-float))))
        (when (read-numeric in) (error "Trailing dense entries: ~A" name))
        (values n a)))))

(defun read-right-hand-side (directory name n)
  (let ((b (darray n)))
    (with-open-file (in (fixture-path directory name ".b.txt"))
      (dotimes (i n)
        (let ((v (read-numeric in)))
          (unless (realp v) (error "Malformed right-hand side ~A/~D." name i))
          (setf (aref b i) (coerce v 'double-float))))
      (when (read-numeric in) (error "Trailing right-hand side entries: ~A" name)))
    b))

(defun meta-shifts (directory name)
  "Every `shift: <value>` line of <name>.meta.txt in order; one zero shift when there is none."
  (let ((path (fixture-path directory name ".meta.txt")) (prefix "shift: ") (shifts '()))
    (when (probe-file path)
      (with-open-file (in path)
        (loop for line = (read-line in nil nil) while line
              when (and (<= (length prefix) (length line)) (string= prefix line :end2 (length prefix)))
                do (let ((value (let ((*read-default-float-format* 'double-float) (*read-eval* nil))
                                  (read-from-string line nil nil :start (length prefix)))))
                     (unless (realp value) (error "Malformed shift line in ~A: ~A" name line))
                     (push (coerce value 'double-float) shifts)))))
    (or (nreverse shifts) (list 0d0))))

(defun factor-status-name (status)
  (cond ((eq status (coalton:coalton il:FactorSuccess)) "FactorSuccess")
        ((eq status (coalton:coalton il:FactorNonFinite)) "FactorNonFinite")
        ((eq status (coalton:coalton il:FactorBadSize)) "FactorBadSize")
        ((eq status (coalton:coalton il:FactorBadShift)) "FactorBadShift")
        (t (error "Unnamed factor status ~S." status))))

(defun solve-status-name (status)
  (cond ((eq status (coalton:coalton il:SolveSuccess)) "SolveSuccess")
        ((eq status (coalton:coalton il:SolveInvalidFactor)) "SolveInvalidFactor")
        ((eq status (coalton:coalton il:SolveBadSize)) "SolveBadSize")
        ((eq status (coalton:coalton il:SolveSingular)) "SolveSingular")
        ((eq status (coalton:coalton il:SolveNonFiniteRhs)) "SolveNonFiniteRhs")
        ((eq status (coalton:coalton il:SolveNonFiniteResult)) "SolveNonFiniteResult")
        (t (error "Unnamed solve status ~S." status))))

(defun indexed-path (output name index suffix)
  (fixture-path output name (format nil ".~D~A" index suffix)))

(defun delete-indexed-artifacts (output name suffixes)
  "Remove every <name>.<index><suffix> left by an earlier run of this system, for the given suffixes."
  (dolist (path (directory (merge-pathnames "*.out.txt" (uiop:ensure-directory-pathname output))))
    (let* ((file (file-namestring path)) (prefix (concatenate 'string name ".")))
      (when (and (< (length prefix) (length file)) (string= prefix file :end2 (length prefix)))
        (let* ((rest (subseq file (length prefix))) (dot (position #\. rest)))
          (when (and dot (plusp dot) (every #'digit-char-p (subseq rest 0 dot))
                     (member (subseq rest dot) suffixes :test #'string=))
            (delete-file path)))))))

(defun write-line-file (path line)
  (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (write-line line out)))

(defun write-indefinite-factor (path factor)
  (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (format out "~D~%" (il:dimension factor))
    (loop for v across (il:factor-permutation factor) do (format out "~D~%" v))
    (loop for v across (il:factor-block-sizes factor) do (format out "~D~%" v))
    (loop for v across (il:factor-diagonal factor) do (write-line (f64-string v) out))
    (loop for v across (il:factor-subdiagonal factor) do (write-line (f64-string v) out))
    (loop for v across (il:factor-lower factor) do (write-line (f64-string v) out))
    (format out "counts ~D ~D ~D~%" (il:positive-count factor) (il:negative-count factor)
            (il:zero-count factor))))

(defun run-indefinite-fixtures (input output &key (repeats 20) (allocation-repeats 20))
  "Write each system's factor, inertia and solution at every named shift, and one measurement line."
  (ensure-directories-exist (uiop:ensure-directory-pathname output))
  (let ((paths (sort (directory (merge-pathnames "*.S.txt" (uiop:ensure-directory-pathname input)))
                     #'string< :key #'namestring))
        (failures 0) (count 0))
    (with-open-file (table (merge-pathnames "indefinite-table.txt" (uiop:ensure-directory-pathname output))
                           :direction :output :if-exists :supersede :if-does-not-exist :create)
      (format table "name shift n positive negative zero factor_ms solve_ms factor_bytes~%")
      (dolist (path paths)
        (let* ((file (file-namestring path))
               (name (subseq file 0 (- (length file) (length ".S.txt")))))
          (incf count)
          (delete-indexed-artifacts output name
                                    '(".factor.out.txt" ".x.out.txt" ".solve.out.txt" ".refused.out.txt"))
          (handler-case
              (multiple-value-bind (n a) (read-dense-symmetric input name)
                (let ((b (read-right-hand-side input name n))
                      (factor (il:make-factor n)) (x (darray n)) (index 0))
                  (dolist (shift (meta-shifts input name))
                    (let ((status (il:factor! factor a shift)))
                      (if (not (eq status (coalton:coalton il:FactorSuccess)))
                          (let ((line (format nil "~A ~A ~D refused ~A" name (f64-string shift) n
                                              (factor-status-name status))))
                            (write-line-file (indexed-path output name index ".refused.out.txt")
                                             (factor-status-name status))
                            (write-line line) (write-line line table))
                          (let* ((solved (il:solve! factor b x))
                                 (success (eq solved (coalton:coalton il:SolveSuccess))))
                            (write-indefinite-factor (indexed-path output name index ".factor.out.txt") factor)
                            (if success
                                (write-array-file (indexed-path output name index ".x.out.txt") x)
                                (write-line-file (indexed-path output name index ".solve.out.txt")
                                                 (solve-status-name solved)))
                            (let* ((positive (il:positive-count factor)) (negative (il:negative-count factor))
                                   (zero (il:zero-count factor))
                                   (factor-thunk (lambda () (il:factor! factor a shift)))
                                   (factor-ms (best-ms factor-thunk repeats))
                                   (solve-ms (and success (best-ms (lambda () (il:solve! factor b x)) repeats)))
                                   (bytes (bytes-for factor-thunk (max 10 allocation-repeats)))
                                   (line (format nil "~A ~A ~D ~D ~D ~D ~,6F ~:[NA~;~:*~,6F~] ~D" name
                                                 (f64-string shift) n positive negative zero factor-ms
                                                 solve-ms bytes)))
                              (unless (zerop bytes) (incf failures))
                              (write-line line) (write-line line table)))))
                    (incf index))))
            (error (condition)
              (incf failures)
              (format t "INDEFINITE-DRIVER-ERROR ~A ~A~%" name condition))))))
    (if (zerop failures)
        (format t "INDEFINITE-FIXTURES-PASS ~D~%" count)
        (error "INDEFINITE-FIXTURES-FAIL ~D of ~D" failures count))))
