(defpackage #:coalton-linalg/tools
  (:use #:cl)
  (:export #:run-fixtures #:run-gram-fixtures #:small-tests))
(in-package #:coalton-linalg/tools)
(declaim (optimize (speed 3) (safety 1)))

(defun small-tests ()
  (let* ((p (coalton-linalg/sparse/spd-ldlt:pattern 2
             (make-array 3 :element-type '(unsigned-byte 62) :initial-contents '(0 2 3))
             (make-array 3 :element-type '(unsigned-byte 62) :initial-contents '(0 1 1))))
         (s (coalton-linalg/sparse/spd-ldlt:analyze p))
         (a (make-array 3 :element-type 'double-float :initial-contents '(4d0 2d0 3d0)))
         (r (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0)))
    (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess) r) () "SPD factor must succeed.")
    (let ((f (coalton-linalg/sparse/spd-ldlt:symbolic-factor s))
          (b (make-array 2 :element-type 'double-float :initial-contents '(8d0 8d0)))
          (out (make-array 2 :element-type 'double-float :initial-element 0d0)))
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveSuccess) (coalton-linalg/sparse/spd-ldlt:solve! f b out)))
      (assert (< (abs (- (aref out 0) 1d0)) 1d-14))
      (assert (< (abs (- (aref out 1) 2d0)) 1d-14))
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorNonPositive) (coalton-linalg/sparse/spd-ldlt:factor! s a 2d0)))
      (assert (not (coalton-linalg/sparse/spd-ldlt:factor-ready? f)))
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveInvalidFactor) (coalton-linalg/sparse/spd-ldlt:solve! f b out)))))
  (format t "SMALL-TESTS-PASS~%"))
(defun uarray (n &optional (initial 0))
  (make-array n :element-type '(unsigned-byte 62) :initial-element initial))
(defun darray (n) (make-array n :element-type 'double-float :initial-element 0d0))

(defun read-numeric (stream)
  (let ((*read-default-float-format* 'double-float) (*read-eval* nil))
    (read stream nil nil)))

(defun fixture-path (directory name suffix)
  (merge-pathnames (concatenate 'string name suffix) (uiop:ensure-directory-pathname directory)))

(defun read-fixture (directory name)
  (with-open-file (in (fixture-path directory name ".A.txt"))
    (let* ((n (read-numeric in)) (nz (read-numeric in))
           (valid (unless (and (integerp n) (integerp nz) (>= n 1) (>= nz n))
                    (error "Invalid matrix header: ~A" name)))
           (ptr (uarray (1+ n))) (rows (uarray nz)) (vals (darray nz))
           (last-row -1) (last-column -1))
      (declare (ignore valid))
      (loop :for q :below nz :do
        (let ((i (read-numeric in)) (j (read-numeric in)) (v (read-numeric in)))
          (unless (and (integerp i) (integerp j) (<= 0 j i) (< i n) (realp v))
            (error "Malformed matrix entry ~A/~D." name q))
          (unless (or (> j last-column) (and (= j last-column) (> i last-row)))
            (error "Matrix triplets must strictly increase by column then row: ~A/~D" name q))
          (setf last-row i last-column j)
          (setf (aref rows q) i (aref vals q) (coerce v 'double-float))
          (incf (aref ptr (1+ j)))))
      (when (read-numeric in) (error "Trailing matrix entries: ~A" name))
      (loop :for j :below n :do (incf (aref ptr (1+ j)) (aref ptr j)))
      (let ((b (darray n)))
        (with-open-file (rhs (fixture-path directory name ".b.txt"))
          (dotimes (i n) (setf (aref b i) (coerce (read-numeric rhs) 'double-float)))
          (when (read-numeric rhs) (error "Trailing RHS entries.")))
        (values (coalton-linalg/sparse/spd-ldlt:pattern n ptr rows) vals b ptr rows)))))

(defun meta-number (directory name prefix)
  (let ((path (fixture-path directory name ".meta.txt")))
    (when (probe-file path)
      (with-open-file (in path)
        (loop :for line := (read-line in nil nil) :while line
              :when (and (<= (length prefix) (length line))
                        (string= prefix line :end2 (length prefix)))
                :return (let ((*read-default-float-format* 'double-float) (*read-eval* nil))
                         (read-from-string line nil nil :start (length prefix))))))))

(defun f64-string (x)
  (substitute #\e #\d (string-downcase (format nil "~,17E" x))))

(defun write-array-file (path array)
  (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (loop :for x :across array :do
      (write-line (if (floatp x) (f64-string x) (format nil "~D" x)) out))))

(defun write-factor-files (output name f &optional (tag ""))
  (write-array-file (fixture-path output name (concatenate 'string tag ".perm.out.txt"))
                    (coalton-linalg/sparse/spd-ldlt:factor-permutation f))
  (write-array-file (fixture-path output name (concatenate 'string tag ".D.out.txt"))
                    (coalton-linalg/sparse/spd-ldlt:factor-diagonal f))
  (let ((cp (coalton-linalg/sparse/spd-ldlt:factor-columns f)) (ri (coalton-linalg/sparse/spd-ldlt:factor-rows f))
        (lv (coalton-linalg/sparse/spd-ldlt:factor-values f)))
    (with-open-file (out (fixture-path output name (concatenate 'string tag ".L.out.txt"))
                        :direction :output :if-exists :supersede :if-does-not-exist :create)
      (format out "~D ~D~%" (1- (length cp)) (length ri))
      (loop :for j :below (1- (length cp)) :do
        (loop :for q :from (aref cp j) :below (aref cp (1+ j)) :do
          (format out "~D ~D ~A~%" (aref ri q) j (f64-string (aref lv q))))))))

(defun residual-check (cp ri vals b x)
  (declare (type (simple-array double-float (*)) vals b x))
  (let* ((n (length b)) (ax (darray n)) (rowsums (darray n))
         (bnorm 0d0) (xnorm 0d0) (anorm 0d0) (res 0d0))
    (declare (type double-float bnorm xnorm anorm res))
    (dotimes (j n)
      (loop :for q :from (aref cp j) :below (aref cp (1+ j)) :do
        (let ((i (aref ri q)) (v (aref vals q)))
          (incf (aref ax i) (* v (aref x j)))
          (incf (aref rowsums i) (abs v))
          (unless (= i j)
            (incf (aref ax j) (* v (aref x i)))
            (incf (aref rowsums j) (abs v))))))
    (dotimes (i n)
      (setf res (max res (abs (- (aref ax i) (aref b i))))
            anorm (max anorm (aref rowsums i))
            bnorm (max bnorm (abs (aref b i)))
            xnorm (max xnorm (abs (aref x i)))))
    (let ((scale (+ (* anorm xnorm) bnorm)))
      (if (zerop scale) res (/ res scale)))))

(defun reconstruction-check (cp ri vals f &optional (shift 0d0))
  (declare (type (simple-array double-float (*)) vals))
  (let* ((perm (coalton-linalg/sparse/spd-ldlt:factor-permutation f))
         (n (length perm)) (inv (uarray n))
         (lp (coalton-linalg/sparse/spd-ldlt:factor-columns f)) (lr (coalton-linalg/sparse/spd-ldlt:factor-rows f))
         (lv (coalton-linalg/sparse/spd-ldlt:factor-values f)) (d (coalton-linalg/sparse/spd-ldlt:factor-diagonal f))
         (rebuilt (darray (* n n))) (amax 0d0) (error-max 0d0))
    (declare (type (simple-array double-float (*)) lv d rebuilt)
             (type double-float amax error-max))
    (dotimes (k n)
      (setf (aref inv (aref perm k)) k)
      (incf (aref rebuilt (+ (* k n) k)) (aref d k))
      (loop :for a :from (aref lp k) :below (aref lp (1+ k)) :do
        (let ((i (aref lr a)) (ld (* (aref lv a) (aref d k))))
          (incf (aref rebuilt (+ (* i n) k)) ld)
          (loop :for z :from (aref lp k) :to a :do
            (incf (aref rebuilt (+ (* i n) (aref lr z))) (* ld (aref lv z)))))))
    (dotimes (j n)
      (loop :for q :from (aref cp j) :below (aref cp (1+ j)) :do
        (let* ((perm-i (aref inv (aref ri q))) (pj (aref inv j)) (v (aref vals q)))
          (setf amax (max amax (abs v)))
          (decf (aref rebuilt (+ (* n (max perm-i pj)) (min perm-i pj)))
                (if (= perm-i pj) (- v shift) v)))))
    (loop :for v :of-type double-float :across rebuilt :do (setf error-max (max error-max (abs v))))
    (if (zerop amax) error-max (/ error-max amax))))

#+win32
(sb-alien:define-alien-routine ("QueryPerformanceCounter" qpc) sb-alien:int
  (counter (* sb-alien:long-long)))
#+win32
(sb-alien:define-alien-routine ("QueryPerformanceFrequency" qpf) sb-alien:int
  (counter (* sb-alien:long-long)))
#+win32
(defparameter *qpc-frequency*
  (sb-alien:with-alien ((value sb-alien:long-long)) (qpf (sb-alien:addr value)) value))
#+win32
(defun ticks ()
  (sb-alien:with-alien ((value sb-alien:long-long)) (qpc (sb-alien:addr value)) value))

#-win32
(defparameter *qpc-frequency* internal-time-units-per-second)
#-win32
(defun ticks () (get-internal-real-time))

(defun best-ms (thunk repeats)
  (funcall thunk)
  (loop :repeat repeats
        :minimize (let ((start (ticks))) (funcall thunk)
                      (* 1000d0 (/ (- (ticks) start) *qpc-frequency*)))))

(defun bytes-for (thunk repeats)
  (dotimes (i 10) (funcall thunk))
  (sb-ext:gc :full t)
  (let ((before (sb-ext:get-bytes-consed)))
    (dotimes (i repeats) (funcall thunk))
    (- (sb-ext:get-bytes-consed) before)))

(defun run-fixtures (input output &key (repeats 20) (allocation-repeats 100))
  "Write reviewable factors; assert correctness and warmed-up zero allocation."
  (ensure-directories-exist (uiop:ensure-directory-pathname output))
  (let ((paths (sort (directory (merge-pathnames "*.A.txt" (uiop:ensure-directory-pathname input)))
                     #'string< :key #'namestring))
        (failures 0))
    (unless paths (error "No matrix fixtures found in ~A." input))
    (with-open-file (table (merge-pathnames "table.txt" (uiop:ensure-directory-pathname output))
                          :direction :output :if-exists :supersede)
      (format table "name n nnzA nnzL analyze_ms factor_ms solve_ms residual rebuild shift_kept shift_refused~%")
      (dolist (path paths)
        (let* ((base (pathname-name path)) (name (subseq base 0 (- (length base) 2))))
          (dolist (suffix '(".x.out.txt" ".perm.out.txt" ".L.out.txt" ".D.out.txt"
                            ".refused.out.txt" ".shift-kept.perm.out.txt" ".shift-kept.L.out.txt"
                            ".shift-kept.D.out.txt" ".shift-refused.out.txt" ".allocation.txt"))
            (let ((owned-path (fixture-path output name suffix)))
              (when (probe-file owned-path) (delete-file owned-path))))
          (multiple-value-bind (pattern vals b cp ri) (read-fixture input name)
            (let* ((s (coalton-linalg/sparse/spd-ldlt:analyze pattern))
                   (result (coalton-linalg/sparse/spd-ldlt:factor! s vals 0d0))
                   (n (length b)))
              (cond
                ((not (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess) result))
                 (unless (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorNonPositive) result)
                   (error "Unexpected refusal kind in ~A." name))
                 (write-array-file (fixture-path output name ".refused.out.txt")
                                   (vector (coalton-linalg/sparse/spd-ldlt:refused-column s)))
                 (format t "~A ~D ~D refused ~D~%" name n (length vals)
                         (coalton-linalg/sparse/spd-ldlt:refused-column s))
                 (format table "~A ~D ~D refused ~D~%" name n (length vals)
                         (coalton-linalg/sparse/spd-ldlt:refused-column s)))
                (t
                 (let* ((f (coalton-linalg/sparse/spd-ldlt:symbolic-factor s)) (x (darray n))
                        (keep (let ((v (meta-number input name "shift that must still factorise with every pivot positive: "))) (when v (coerce v 'double-float))))
                        (refuse (let ((v (meta-number input name "shift that must be refused: "))) (when v (coerce v 'double-float))))
                        (reference-fill (meta-number input name "reference fill: "))
                        (nnzl (+ n (length (coalton-linalg/sparse/spd-ldlt:factor-rows f))))
                        (factor-thunk (lambda () (coalton-linalg/sparse/spd-ldlt:factor! s vals 0d0)))
                        (solve-thunk (lambda () (coalton-linalg/sparse/spd-ldlt:solve! f b x))))
                   (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveSuccess) (funcall solve-thunk)))
                   (write-factor-files output name f)
                   (write-array-file (fixture-path output name ".x.out.txt") x)
                   (let ((res (residual-check cp ri vals b x))
                         (rebuild (reconstruction-check cp ri vals f))
                         (kept "NA") (refused "NA"))
                     (unless (and (<= res 1d-12) (<= rebuild 1d-12)) (incf failures))
                     (when keep
                       (setf kept (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess) (coalton-linalg/sparse/spd-ldlt:factor! s vals keep)))
                       (cond
                         (kept
                          (write-factor-files output name f ".shift-kept")
                          (assert (<= (reconstruction-check cp ri vals f keep) 1d-12)))
                         (t (incf failures))))
                     (when refuse
                       (let ((r (coalton-linalg/sparse/spd-ldlt:factor! s vals refuse)))
                         (setf refused (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorNonPositive) r))
                         (if refused
                             (write-array-file (fixture-path output name ".shift-refused.out.txt")
                                               (vector (coalton-linalg/sparse/spd-ldlt:refused-column s)))
                             (incf failures))))
                     (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess) (funcall factor-thunk)))
                     (let ((an-ms (best-ms (lambda () (coalton-linalg/sparse/spd-ldlt:analyze pattern)) repeats))
                           (fa-ms (best-ms factor-thunk repeats))
                           (so-ms (best-ms solve-thunk repeats))
                           (fa-bytes (bytes-for factor-thunk allocation-repeats))
                           (so-bytes (bytes-for solve-thunk allocation-repeats)))
                       (with-open-file (allocation (fixture-path output name ".allocation.txt")
                                                   :direction :output :if-exists :supersede)
                         (format allocation "repeats ~D~%factor_bytes ~D~%solve_bytes ~D~%"
                                 allocation-repeats fa-bytes so-bytes))
                       (unless (and (zerop fa-bytes) (zerop so-bytes)) (incf failures))
                       (when (and reference-fill
                                  (> nnzl (* 1.25d0 reference-fill)))
                         (format t "FILL-TARGET-MISS ~A ~D/~D~%" name nnzl reference-fill))
                       (let ((line (format nil "~A ~D ~D ~D ~,6F ~,6F ~,6F ~,5E ~,5E ~A ~A"
                                           name n (length vals) nnzl an-ms fa-ms so-ms res rebuild kept refused)))
                         (write-line line table)
                         (write-line line))))))))))))
    (unless (zerop failures) (error "~D fixture checks failed." failures))
    (format t "FIXTURES-PASS ~D~%" (length paths))))
