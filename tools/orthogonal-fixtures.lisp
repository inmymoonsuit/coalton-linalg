(in-package #:coalton-linalg/tools)

;;; Optional artifact driver for the orthogonal decompositions. For every <name>.M.txt in a
;;; folder it factors once, then for each run named by <name>.meta.txt selects a rank, solves
;;; with <name>.b.txt, and writes files an independent reviewer can recompute from. See
;;; docs/orthogonal.md, Artifact driver, for the file protocol.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (sb-ext:add-package-local-nickname "OG" "COALTON-LINALG/DENSE/ORTHOGONAL"))

(defun read-dense-rectangular (directory name)
  "Read <name>.M.txt: m and n, then m*n values in column-major order."
  (with-open-file (in (fixture-path directory name ".M.txt"))
    (let ((m (read-numeric in)) (n (read-numeric in)))
      (unless (and (integerp m) (integerp n) (>= m 0) (>= n 0)) (error "Invalid dense header: ~A" name))
      (let ((a (darray (* m n))))
        (dotimes (q (* m n))
          (let ((v (read-numeric in)))
            (unless (realp v) (error "Malformed dense entry ~A/~D." name q))
            (setf (aref a q) (coerce v 'double-float))))
        (when (read-numeric in) (error "Trailing dense entries: ~A" name))
        (values m n a)))))

(defun meta-rank-runs (directory name)
  "Each `threshold: <relative value>` or `rank: <r>` line of <name>.meta.txt, in order; one 1e-10 threshold when none."
  (let ((path (fixture-path directory name ".meta.txt")) (runs '()))
    (when (probe-file path)
      (with-open-file (in path)
        (loop :for line := (read-line in nil nil) :while line :do
          (loop :for (prefix kind) :in '(("threshold: " :threshold) ("rank: " :rank))
                :when (and (<= (length prefix) (length line)) (string= prefix line :end2 (length prefix)))
                  :do (let ((value (let ((*read-default-float-format* 'double-float) (*read-eval* nil))
                                    (read-from-string line nil nil :start (length prefix)))))
                       (unless (if (eq kind ':rank) (and (integerp value) (>= value 0)) (realp value))
                         (error "Malformed run line in ~A: ~A" name line))
                       (push (list kind value) runs))))))
    (or (nreverse runs) (list (list ':threshold 1d-10)))))

(defun orthogonal-status-name (status)
  (loop :for (value name) :in (list (list (coalton:coalton og:FactorSuccess) "FactorSuccess")
                                  (list (coalton:coalton og:FactorNonFinite) "FactorNonFinite")
                                  (list (coalton:coalton og:FactorBadSize) "FactorBadSize")
                                  (list (coalton:coalton og:RankSuccess) "RankSuccess")
                                  (list (coalton:coalton og:RankInvalidFactor) "RankInvalidFactor")
                                  (list (coalton:coalton og:RankTooLarge) "RankTooLarge")
                                  (list (coalton:coalton og:RankSingular) "RankSingular")
                                  (list (coalton:coalton og:RankNonFinite) "RankNonFinite")
                                  (list (coalton:coalton og:SolveSuccess) "SolveSuccess")
                                  (list (coalton:coalton og:SolveInvalidFactor) "SolveInvalidFactor")
                                  (list (coalton:coalton og:SolveNoRank) "SolveNoRank")
                                  (list (coalton:coalton og:SolveBadSize) "SolveBadSize")
                                  (list (coalton:coalton og:SolveBadIndex) "SolveBadIndex")
                                  (list (coalton:coalton og:SolveNonFiniteRhs) "SolveNonFiniteRhs")
                                  (list (coalton:coalton og:SolveNonFiniteResult) "SolveNonFiniteResult"))
        :when (eq status value) :return name
        :finally (error "Unnamed orthogonal status ~S." status)))

(defun write-qr-file (path decomposition)
  "m, n, the permutation, the upper trapezoid R (k by n), then the thin Q (m by k), column-major."
  (let* ((m (og:row-count decomposition)) (n (og:column-count decomposition))
         (k (og:step-count decomposition)) (work (og:factor-work decomposition)) (column (darray m)))
    (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create)
      (format out "~D~%~D~%" m n)
      (loop :for v :across (og:factor-permutation decomposition) :do (format out "~D~%" v))
      (dotimes (j n)
        (dotimes (i k)
          (write-line (f64-string (if (<= i j) (aref work (+ i (* j m))) 0d0)) out)))
      (dotimes (j k)
        (fill column 0d0)
        (setf (aref column j) 1d0)
        (unless (eq (og:apply-q! decomposition column) (coalton:coalton og:SolveSuccess))
          (error "Q could not be read back."))
        (loop :for v :across column :do (write-line (f64-string v) out))))))

(defun run-orthogonal-fixtures (input output &key (repeats 20) (allocation-repeats 20))
  "Write each system's QR once and, for every run, its rank, solution, residual and nullspace basis."
  (ensure-directories-exist (uiop:ensure-directory-pathname output))
  (let ((paths (sort (directory (merge-pathnames "*.M.txt" (uiop:ensure-directory-pathname input)))
                     #'string< :key #'namestring))
        (failures 0) (count 0)
        (indexed '(".x.out.txt" ".null.out.txt" ".run.out.txt" ".refused.out.txt")))
    (with-open-file (table (merge-pathnames "orthogonal-table.txt" (uiop:ensure-directory-pathname output))
                           :direction :output :if-exists :supersede :if-does-not-exist :create)
      (format table "name run m n rank factor_ms solve_ms factor_bytes solve_bytes~%")
      (dolist (path paths)
        (let* ((file (file-namestring path))
               (name (subseq file 0 (- (length file) (length ".M.txt")))))
          (incf count)
          (delete-indexed-artifacts output name indexed)
          (dolist (suffix '(".qr.out.txt" ".refused.out.txt"))
            (let ((stale (fixture-path output name suffix)))
              (when (probe-file stale) (delete-file stale))))
          (handler-case
              (multiple-value-bind (m n a) (read-dense-rectangular input name)
                (let* ((b (read-right-hand-side input name m)) (runs (meta-rank-runs input name))
                       (decomposition (og:make-decomposition m n)) (x (darray n)) (basis (darray n))
                       (factor-thunk (lambda () (og:factor! decomposition a)))
                       (status (funcall factor-thunk)))
                  (if (not (eq status (coalton:coalton og:FactorSuccess)))
                      (let ((line (format nil "~A factor ~D ~D refused ~A" name m n (orthogonal-status-name status))))
                        (write-line-file (fixture-path output name ".refused.out.txt")
                                         (orthogonal-status-name status))
                        (write-line line) (write-line line table))
                      (let ((factor-ms (best-ms factor-thunk repeats))
                            (factor-bytes (bytes-for factor-thunk (max 10 allocation-repeats))))
                        (unless (zerop factor-bytes) (incf failures))
                        (write-qr-file (fixture-path output name ".qr.out.txt") decomposition)
                        (loop :for (kind value) :in runs :for index :from 0 :do
                          (let* ((rank (if (eq kind ':rank)
                                           value
                                           (og:rank-above decomposition
                                                          (* (coerce value 'double-float)
                                                             (og:pivot-magnitude decomposition 0)))))
                                 (ranked (og:set-rank! decomposition rank))
                                 (solved (and (eq ranked (coalton:coalton og:RankSuccess))
                                              (og:solve! decomposition b x))))
                            (if (not (eq solved (coalton:coalton og:SolveSuccess)))
                                (let* ((refusal (orthogonal-status-name (or solved ranked)))
                                       (line (format nil "~A ~D ~D ~D refused ~A" name index m n refusal)))
                                  (write-line-file (indexed-path output name index ".refused.out.txt") refusal)
                                  (write-line line) (write-line line table))
                                (let ((residual (og:solve-residual-norm decomposition)))
                                  (write-array-file (indexed-path output name index ".x.out.txt") x)
                                  (with-open-file (out (indexed-path output name index ".null.out.txt")
                                                       :direction :output :if-exists :supersede
                                                       :if-does-not-exist :create)
                                    (dotimes (j (- n rank))
                                      (unless (eq (og:nullspace-vector! decomposition j basis)
                                                  (coalton:coalton og:SolveSuccess))
                                        (error "Nullspace vector ~D of ~A could not be read." j name))
                                      (loop :for v :across basis :do (write-line (f64-string v) out))))
                                  (with-open-file (out (indexed-path output name index ".run.out.txt")
                                                       :direction :output :if-exists :supersede
                                                       :if-does-not-exist :create)
                                    (format out "rank ~D~%residual ~A~%" rank (f64-string residual)))
                                  (let* ((solve-thunk (lambda () (og:solve! decomposition b x)))
                                         (solve-ms (best-ms solve-thunk repeats))
                                         (solve-bytes (bytes-for solve-thunk (max 10 allocation-repeats)))
                                         (line (format nil "~A ~D ~D ~D ~D ~,6F ~,6F ~D ~D" name index m n rank
                                                       factor-ms solve-ms factor-bytes solve-bytes)))
                                    (unless (zerop solve-bytes) (incf failures))
                                    (write-line line) (write-line line table))))))))))
            (error (condition)
              (incf failures)
              (format t "ORTHOGONAL-DRIVER-ERROR ~A ~A~%" name condition))))))
    (if (zerop failures)
        (format t "ORTHOGONAL-FIXTURES-PASS ~D~%" count)
        (error "ORTHOGONAL-FIXTURES-FAIL ~D of ~D" failures count))))
