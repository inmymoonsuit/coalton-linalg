(in-package #:coalton-linalg/tests)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (sb-ext:add-package-local-nickname "GRAM" "COALTON-LINALG/SPARSE/GRAM")
  (sb-ext:add-package-local-nickname "GRAM-CALLER" "COALTON-LINALG/TESTS/GRAM-CALLERS"))

(defun gram-analyze (matrix aat &optional limit)
  (if aat
      (if limit (gram:analyze-aat-with-limit matrix limit) (gram:analyze-aat matrix))
      (if limit (gram:analyze-ata-with-limit matrix limit) (gram:analyze-ata matrix))))

(defun gram-limit-code (matrix aat limit requested)
  (funcall (if aat #'gram-caller:aat-limit-error #'gram-caller:ata-limit-error)
           matrix limit requested))

(defun gram-with-values (matrix values)
  (csc:from-csc (csc:row-count matrix) (csc:column-count matrix)
                (csc:column-pointers matrix) (csc:row-indices matrix) values))

(defun gram-observe (label plan input output checked expected &key (preserve-output t))
  "Exercise a real external typed call and snapshot source/output bits and borrowed plan structure."
  (let* ((values (if checked (csc:entries input) input))
         (values-before (copy-seq values))
         (output-before (copy-seq output))
         (source-columns (when checked (copy-seq (csc:column-pointers input))))
         (source-rows (when checked (copy-seq (csc:row-indices input))))
         (columns (gram:column-pointers plan))
         (rows (gram:row-indices plan))
         (columns-before (copy-seq columns))
         (rows-before (copy-seq rows))
         (dimension (gram:dimension plan))
         (count (gram:entry-count plan))
         (actual (funcall (if checked #'gram-caller:matrix-error #'gram-caller:raw-error)
                          plan input output)))
    (assert (= expected actual) () "~A expected typed code ~D, got ~D." label expected actual)
    (assert (same-bits-p values values-before) () "~A changed source values." label)
    (when checked
      (assert (equalp source-columns (csc:column-pointers input)) () "~A changed source pointers." label)
      (assert (equalp source-rows (csc:row-indices input)) () "~A changed source rows." label))
    (assert (eq columns (gram:column-pointers plan)) () "~A replaced borrowed plan pointers." label)
    (assert (eq rows (gram:row-indices plan)) () "~A replaced borrowed plan rows." label)
    (assert (equalp columns-before columns) () "~A changed plan pointers." label)
    (assert (equalp rows-before rows) () "~A changed plan rows." label)
    (assert (= dimension (gram:dimension plan)))
    (assert (= count (gram:entry-count plan)))
    (when preserve-output
      (assert (same-bits-p output output-before) () "~A changed output on preflight refusal." label))
    actual))

(defun gram-success (label plan input output checked expected)
  (gram-observe label plan input output checked 0 :preserve-output nil)
  (assert (same-bits-p output expected) () "~A produced ~S, expected ~S." label output expected))

(defun gram-check-diagonal-structure (plan dimension)
  (assert (= dimension (gram:dimension plan)))
  (assert (= dimension (gram:entry-count plan)))
  (assert (= (1+ dimension) (length (gram:column-pointers plan))))
  (assert (= dimension (length (gram:row-indices plan))))
  (dotimes (i (1+ dimension)) (assert (= i (aref (gram:column-pointers plan) i))))
  (dotimes (i dimension) (assert (= i (aref (gram:row-indices plan) i)))))

(defun gram-lifetime-tests ()
  (let* ((matrix (buffered-rectangle))
         (changed (gram-with-values matrix (doubles 1d0 2d0 -1d0 0d0 3d0))))
    (dolist (aat '(nil t))
      (let* ((plan (gram-analyze matrix aat))
             (initial (if aat (doubles 5d0 -4d0 25d0) (doubles 4d0 0d0 -2d0 9d0 12d0 17d0)))
             (updated (if aat (doubles 1d0 2d0 14d0) (doubles 5d0 -2d0 6d0 1d0 -3d0 9d0)))
             (output (buffered-output (length initial)))
             (other-output (buffered-output (length initial)))
             (input (copy-seq (csc:entries changed))))
        (assert (= (if aat 2 3) (gram:dimension plan)))
        (assert (equalp (if aat #(0 2 3) #(0 3 5 6)) (gram:column-pointers plan)))
        (assert (equalp (if aat #(0 1 1) #(0 1 2 1 2 2)) (gram:row-indices plan)))
        (assert (= (length initial) (gram:entry-count plan)))
        (gram-success "initial raw refill" plan (csc:entries matrix) output nil initial)
        (gram-success "same pattern, new checked values" plan changed other-output t updated)
        (assert (same-bits-p output initial) () "A later refill changed an earlier caller output.")
        (let* ((small (csc:from-csc 1 1 (indices 0 1) (indices 0) (doubles 2d0)))
               (other-plan (gram-analyze small aat)))
          (gram-success "independent interleaved plan" other-plan small (buffered-output 1) t (doubles 4d0)))
        (gram-success "changed raw numeric values" plan input output nil updated)
        (fill input 0d0)
        (assert (same-bits-p output updated) () "Later input mutation changed an earlier computed output.")
        (gram-success "zero refill preserves structural entries" plan input other-output nil
                      (make-array (length initial) :element-type 'double-float :initial-element 0d0))
        (gram-success "original checked values after raw refills" plan matrix output t initial))))
  (dolist (shape '((0 0) (0 3) (4 0) (2 3)))
    (destructuring-bind (m n) shape
      (let ((matrix (csc:from-csc m n
                     (make-array (1+ n) :element-type '(unsigned-byte 62) :initial-element 0)
                     (indices) (doubles))))
        (dolist (aat '(nil t))
          (let* ((dimension (if aat m n))
                 (plan (gram-analyze matrix aat dimension))
                 (expected (make-array dimension :element-type 'double-float :initial-element 0d0)))
            (gram-check-diagonal-structure plan dimension)
            (gram-success "empty source retains every diagonal, raw" plan (doubles)
                          (buffered-output dimension) nil expected)
            (gram-success "empty source retains every diagonal, checked" plan matrix
                          (buffered-output dimension) t expected))))))
  (format t "GRAM-LIFETIME-PASS orientations=2 empty-shapes=4~%"))

(defun gram-preflight-tests ()
  (let ((matrix (buffered-rectangle)))
    (dolist (aat '(nil t))
      (let* ((plan (gram-analyze matrix aat))
             (count (gram:entry-count plan)))
        (gram-observe "wrong raw input count" plan (doubles 1d0) (buffered-output count) nil 2)
        (gram-observe "wrong raw output count" plan (csc:entries matrix) (buffered-output (1+ count)) nil 2)
        (gram-observe "wrong checked output count" plan matrix (buffered-output (1+ count)) t 2)
        (dolist (bad (list sb-ext:double-float-positive-infinity
                          sb-ext:double-float-negative-infinity
                          (sb-kernel:make-double-float #x7ff80000 43)))
          (let ((input (copy-seq (csc:entries matrix))))
            (setf (aref input (1- (length input))) bad)
            (gram-observe "nonfinite raw input before writes" plan input (buffered-output count) nil 5)))
        (gram-success "recovery after preflight refusals" plan matrix (buffered-output count) t
                      (if aat (doubles 5d0 -4d0 25d0) (doubles 4d0 0d0 -2d0 9d0 12d0 17d0))))))
  (let ((matrix (csc:from-csc 2 2 (indices 0 1 2) (indices 0 1) (doubles 2d0 3d0))))
    (dolist (aat '(nil t))
      (let ((plan (gram-analyze matrix aat)))
        (let ((input (doubles 2d0 3d0)))
          (gram-observe "raw output/input identity" plan input input nil 9))
        (gram-observe "checked output/matrix-entry identity" plan matrix (csc:entries matrix) t 9)
        (let ((input (buffered-output 2)))
          (gram-observe "raw alias precedes finite validation" plan input input nil 9))
        (let ((input (buffered-output 1)))
          (gram-observe "raw dimensions precede aliasing" plan input input nil 2))
        (gram-success "distinct equal raw arrays" plan (doubles 2d0 3d0) (doubles 2d0 3d0)
                      nil (doubles 4d0 9d0))
        (gram-success "checked distinct array equal to matrix values" plan matrix (doubles 2d0 3d0)
                      t (doubles 4d0 9d0)))))
  (let ((matrix (csc:from-csc 0 0 (indices 0) (indices) (doubles))))
    (dolist (aat '(nil t))
      (let ((plan (gram-analyze matrix aat 0))
            (input (doubles)))
        (gram-observe "empty raw alias" plan input input nil 9)
        (gram-observe "empty checked alias" plan matrix (csc:entries matrix) t 9))))
  (let* ((original (csc:from-csc 2 3 (indices 0 1 2 3) (indices 0 1 0) (doubles 2d0 3d0 4d0)))
         (new-values (gram-with-values original (doubles 1d0 -2d0 3d0)))
         (different-rows (csc:from-csc 2 3 (indices 0 1 2 3) (indices 1 1 0) (doubles 2d0 3d0 4d0)))
         (different-pointers (csc:from-csc 2 3 (indices 0 0 2 3) (indices 0 1 0) (doubles 2d0 3d0 4d0)))
         (different-height (csc:from-csc 3 3 (indices 0 1 2 3) (indices 0 1 0) (doubles 2d0 3d0 4d0)))
         (different-width (csc:from-csc 2 4 (indices 0 1 2 3 3) (indices 0 1 0) (doubles 2d0 3d0 4d0))))
    (dolist (aat '(nil t))
      (let* ((plan (gram-analyze original aat))
             (count (gram:entry-count plan)))
        (gram-success "same exact source pattern accepted" plan new-values (buffered-output count) t
                      (if aat (doubles 10d0 4d0) (doubles 1d0 3d0 4d0 9d0)))
        (dolist (changed (list different-rows different-pointers))
          (gram-observe "same size/nnz, different pattern" plan changed (buffered-output count) t 1)
          (gram-observe "pattern mismatch before output validation" plan changed (doubles) t 1))
        (dolist (changed (list different-height different-width))
          (gram-observe "changed source dimensions" plan changed (buffered-output count) t 2))
        (gram-success "original source works after mismatch refusal" plan original (buffered-output count) t
                      (if aat (doubles 20d0 9d0) (doubles 4d0 8d0 9d0 16d0))))))
  (format t "GRAM-PREFLIGHT-PASS raw-and-checked=both orientations=2~%"))

(defun gram-limit-tests ()
  (let ((maximum (coalton:coalton gram:maximum-analysis-size))
        (default (coalton:coalton gram:default-analysis-entry-limit)))
    (assert (= maximum (coalton:coalton ldlt:maximum-analysis-size)))
    (assert (= default (coalton:coalton ldlt:default-analysis-entry-limit)))
    (assert (= default 1048576))
    (let ((diagonal (csc:from-csc 4 4 (indices 0 1 2 3 4) (indices 0 1 2 3)
                                  (doubles 1d0 1d0 1d0 1d0))))
      (dolist (aat '(nil t))
        (assert (= 8 (gram-limit-code diagonal aat 3 4)))
        (assert (= 0 (gram-limit-code diagonal aat 4 4)))
        (gram-check-diagonal-structure (gram-analyze diagonal aat 4) 4)
        (gram-check-diagonal-structure (gram-analyze diagonal aat most-positive-fixnum) 4)))
    (dolist (aat '(nil t))
      (let* ((matrix (if aat
                         (csc:from-csc 3 1 (indices 0 3) (indices 0 1 2) (doubles 1d0 2d0 3d0))
                         (csc:from-csc 1 3 (indices 0 1 2 3) (indices 0 0 0) (doubles 1d0 2d0 3d0))))
             (zero-matrix (gram-with-values matrix (doubles 0d0 0d0 0d0))))
        (assert (= 8 (gram-limit-code matrix aat 2 3)))
        (assert (= 8 (gram-limit-code matrix aat 3 5)))
        (assert (= 8 (gram-limit-code matrix aat 5 6)))
        (assert (= 0 (gram-limit-code matrix aat 6 6)))
        (assert (= 8 (gram-limit-code zero-matrix aat 5 6)))
        (let ((plan (gram-analyze matrix aat 6)))
          (assert (= 3 (gram:dimension plan)))
          (assert (= 6 (gram:entry-count plan)))
          (assert (equalp #(0 3 5 6) (gram:column-pointers plan)))
          (assert (equalp #(0 1 2 1 2 2) (gram:row-indices plan))))
        ;; The opposite orientation has one output entry but three source entries.
        (let ((plan (gram-analyze matrix (not aat) 1)))
          (gram-check-diagonal-structure plan 1)
          (gram-success "source nnz exceeds output budget" plan matrix (buffered-output 1) t (doubles 14d0)))))
    ;; Two shared source groups contribute to each coordinate, but consume one
    ;; structural budget entry per distinct coordinate.
    (dolist (aat '(nil t))
      (let* ((matrix (if aat
                         (csc:from-csc 3 2 (indices 0 3 6) (indices 0 1 2 0 1 2)
                                       (doubles 1d0 1d0 1d0 1d0 1d0 1d0))
                         (csc:from-csc 2 3 (indices 0 2 4 6) (indices 0 1 0 1 0 1)
                                       (doubles 1d0 1d0 1d0 1d0 1d0 1d0))))
             (plan (gram-analyze matrix aat 6)))
        (assert (= 6 (gram:entry-count plan)))
        (gram-success "repeated contributions do not spend budget twice" plan matrix
                      (buffered-output 6) t (doubles 2d0 2d0 2d0 2d0 2d0 2d0))))
    ;; These checked matrices need only one pointer and no entries; output
    ;; dimensions are refused before any dimension-sized allocation.
    (dolist (n (list (1+ maximum) most-positive-fixnum))
      (let ((matrix (csc:from-csc n 0 (indices 0) (indices) (doubles))))
        (assert (= 7 (gram-caller:aat-limit-error matrix 0 n)))
        (assert (= 7 (gram-caller:aat-limit-error matrix most-positive-fixnum n)))
        (assert (= 7 (gram-caller:aat-default-error matrix n)))))
    (let ((matrix (csc:from-csc maximum 0 (indices 0) (indices) (doubles))))
      (assert (= 8 (gram-caller:aat-limit-error matrix 0 maximum))))
    (let ((matrix (csc:from-csc (1+ default) 0 (indices 0) (indices) (doubles))))
      (assert (= 8 (gram-caller:aat-default-error matrix (1+ default))))
      (assert (= 0 (gram-caller:ata-default-error matrix 0))))
    ;; A huge source height is legal when the chosen Gram dimension is one.
    ;; The lone stored row is near maxUFix, so dense row-sized scratch is exposed.
    (let* ((matrix (csc:from-csc most-positive-fixnum 1 (indices 0 1)
                                 (indices (1- most-positive-fixnum)) (doubles 2d0)))
           (plan (gram:analyze-ata-with-limit matrix 1)))
      (gram-check-diagonal-structure plan 1)
      (gram-success "maxUFix source height, tiny ATA" plan (csc:entries matrix)
                    (buffered-output 1) nil (doubles 4d0))
      (gram-success "maxUFix source height, checked refill" plan matrix
                    (buffered-output 1) t (doubles 4d0))
      (assert (= 7 (gram-caller:aat-limit-error matrix 1 most-positive-fixnum))))
    (format t "GRAM-LIMIT-PASS maximum=~D default=~D huge-source-height=maxUFix~%" maximum default)))

(defun gram-overflow-recovery-tests ()
  (dolist (aat '(nil t))
    (let* ((matrix (csc:from-csc 1 1 (indices 0 1) (indices 0) (doubles 2d0)))
           (plan (gram-analyze matrix aat))
           (bad-matrix (gram-with-values matrix (doubles most-positive-double-float))))
      (gram-observe "raw product overflow" plan (doubles most-positive-double-float)
                    (buffered-output 1) nil 6 :preserve-output nil)
      (gram-success "raw recovery after product overflow" plan (doubles 3d0)
                    (buffered-output 1) nil (doubles 9d0))
      (gram-observe "checked product overflow" plan bad-matrix
                    (buffered-output 1) t 6 :preserve-output nil)
      (gram-success "checked recovery after product overflow" plan matrix
                    (buffered-output 1) t (doubles 4d0)))
    (let* ((large (scale-float 1d0 511))
           (large-values (doubles large large large large))
           (matrix (if aat
                       (csc:from-csc 1 4 (indices 0 1 2 3 4) (indices 0 0 0 0) large-values)
                       (csc:from-csc 4 1 (indices 0 4) (indices 0 1 2 3) large-values)))
           (plan (gram-analyze matrix aat 1))
           (normal-values (doubles 1d0 1d0 1d0 1d0))
           (normal-matrix (gram-with-values matrix normal-values)))
      ;; Each square is 2^1022 and finite; only their accumulation overflows.
      (gram-observe "raw sum overflow" plan large-values (buffered-output 1) nil 6 :preserve-output nil)
      (gram-success "raw recovery after sum overflow" plan normal-values (buffered-output 1) nil (doubles 4d0))
      (gram-observe "checked sum overflow" plan matrix (buffered-output 1) t 6 :preserve-output nil)
      (gram-success "checked recovery after sum overflow" plan normal-matrix (buffered-output 1) t (doubles 4d0))))
  (format t "GRAM-OVERFLOW-RECOVERY-PASS arithmetic-refusals=8 recoveries=8~%"))

(defun gram-allocation-case (label plan input output checked expected)
  "Measure actual external Coalton refill loops; typed refusals are outside the allocation claim."
  (let* ((caller (if checked #'gram-caller:repeat-matrix! #'gram-caller:repeat-raw!))
         (values (if checked (csc:entries input) input))
         (values-before (copy-seq values))
         (columns-before (copy-seq (gram:column-pointers plan)))
         (rows-before (copy-seq (gram:row-indices plan))))
    (sb-ext:gc :full t)
    (let ((before-warmup (sb-ext:get-bytes-consed)))
      (funcall caller plan input output 10000)
      (let ((after-warmup (sb-ext:get-bytes-consed)))
        (funcall caller plan input output 10000)
        (let ((after-measurement (sb-ext:get-bytes-consed)))
          (format t "GRAM-ALLOCATION ~A warmup-calls=10000 warmup-bytes=~D calls=10000 bytes=~D~%"
                  label (- after-warmup before-warmup) (- after-measurement after-warmup))
          (assert (zerop (- after-measurement after-warmup)) ()
                  "~A allocated ~D bytes during 10000 successful Coalton calls."
                  label (- after-measurement after-warmup)))))
    (assert (same-bits-p values values-before))
    (assert (equalp columns-before (gram:column-pointers plan)))
    (assert (equalp rows-before (gram:row-indices plan)))
    (assert (same-bits-p output expected) () "~A lost the computed output." label)))

(defun gram-allocation-tests ()
  (let ((matrix (buffered-rectangle)))
    (dolist (aat '(nil t))
      (let* ((plan (gram-analyze matrix aat))
             (expected (if aat (doubles 5d0 -4d0 25d0) (doubles 4d0 0d0 -2d0 9d0 12d0 17d0))))
        (dolist (checked '(nil t))
          (gram-allocation-case (format nil "~A-~A" (if aat "AAT" "ATA") (if checked "checked" "raw"))
                                plan (if checked matrix (csc:entries matrix))
                                (buffered-output (length expected)) checked expected)))))
  (let ((matrix (csc:from-csc 0 0 (indices 0) (indices) (doubles))))
    (dolist (aat '(nil t))
      (let ((plan (gram-analyze matrix aat 0)))
        (dolist (checked '(nil t))
          (gram-allocation-case (format nil "~A-~A-empty" (if aat "AAT" "ATA") (if checked "checked" "raw"))
                                plan (if checked matrix (doubles)) (doubles) checked (doubles)))))))

(defun gram-encapsulation-tests ()
  "Use the existing external compiler harness; public construction/refill must work before negative probes."
  (coalton-linalg/tests/encapsulation::require-accepted-control
   "gram-public-control"
   "(declare probe (Void -> UFix))
    (define (probe)
      (let cp = (arr:make 2 (the UFix 0)))
      (arr:set! cp 1 1)
      (let matrix = (coalton-linalg/sparse/csc:from-csc
                     1 1 cp (arr:make 1 (the UFix 0)) (arr:make 1 2.0d0)))
      (let plan = (coalton-linalg/sparse/gram:analyze-ata matrix))
      (let output = (arr:make 1 0.0d0))
      (coalton-linalg/sparse/gram:refill-csc! plan matrix output)
      (unless (== (arr:aref output 0) 4.0d0)
        (lisp (-> Void) () (cl:error \"External Gram caller computed the wrong result.\")))
      (coalton-linalg/sparse/gram:dimension plan))"
   :execute t)
  (coalton-linalg/tests/encapsulation::require-rejected-probes
   '(("gram-hidden-construction" .
      "(declare probe (coalton-linalg/sparse/gram:GramPlan -> coalton-linalg/sparse/gram:GramPlan))
       (define (probe plan)
         (match plan
           ((coalton-linalg/sparse/gram:MkGramPlan storage)
            (coalton-linalg/sparse/gram:MkGramPlan storage))))")
     ("gram-hidden-destructuring" .
      "(declare probe (coalton-linalg/sparse/gram:GramPlan -> UFix))
       (define (probe plan)
         (match plan ((coalton-linalg/sparse/gram:MkGramPlan _) 0)))")
     ("gram-hidden-field-access" .
      "(declare probe (coalton-linalg/sparse/gram:GramPlan -> UFix))
       (define (probe plan) (arr:length (.scatter plan)))")))
  (dolist (name '("MKGRAMPLAN" "GRAMPLANSTORAGE" "PLAN-STORAGE"))
    (multiple-value-bind (symbol visibility) (find-symbol name "COALTON-LINALG/SPARSE/GRAM")
      (assert (and symbol (eq visibility :internal)) ()
              "Gram implementation symbol ~A must remain internal; got ~S." name visibility)))
  (format t "GRAM-ENCAPSULATION-PASS negative-probes=3 public-control=1 private-symbols=3~%"))

(defun run-gram-runtime-tests ()
  (gram-lifetime-tests)
  (gram-preflight-tests)
  (gram-limit-tests)
  (gram-overflow-recovery-tests)
  (gram-allocation-tests)
  (gram-encapsulation-tests)
  (format t "GRAM-RUNTIME-PASS~%")
  t)