(in-package #:coalton-linalg/tests)

;;; Jacobi symmetric eigenvalues and singular values against exact rational arithmetic on the
;;; stored F64 values. Every computed eigenvalue and singular value is bracketed by an exact
;;; count of the eigenvalues below two rational shifts (Sylvester's law of inertia), which
;;; uses no eigenvalue routine at all; vectors are multiplied out exactly.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (sb-ext:add-package-local-nickname "JC" "COALTON-LINALG/DENSE/JACOBI")
  (sb-ext:add-package-local-nickname "JC-CALLER" "COALTON-LINALG/TESTS/JACOBI-CALLERS"))

(defvar *jc-worst-orthogonality* 0)
(defvar *jc-worst-residual* 0)
(defvar *jc-most-sweeps* 0)

(defun count-below (exact shift)
  "The exact number of eigenvalues of a symmetric rational matrix strictly below a rational shift."
  (let ((n (array-dimension exact 0)))
    (multiple-value-bind (positive negative zero)
        (exact-inertia (build-matrix n (lambda (i j) (- (aref exact i j) (if (= i j) shift 0)))))
      (declare (ignore positive zero))
      negative)))

(defun count-at-or-below (exact shift)
  "The exact number of eigenvalues of a symmetric rational matrix at or below a rational shift."
  (let ((n (array-dimension exact 0)))
    (multiple-value-bind (positive negative zero)
        (exact-inertia (build-matrix n (lambda (i j) (- (aref exact i j) (if (= i j) shift 0)))))
      (declare (ignore positive))
      (+ negative zero))))

(defun check-eigen (label matrix &key relative)
  "Compute through the public interface and check order, orthogonality, residual and every eigenvalue's bracket."
  (let* ((n (array-dimension matrix 0)) (eigen (jc:make-symmetric-eigen n))
         (exact (stored-shifted matrix 0)))
    (assert (= 0 (jc-caller:observe-eigen eigen (column-major matrix :junk-upper t))) ()
            "~A: eigenvalue computation refused." label)
    (assert (jc:eigen-ready? eigen))
    ;; A pinned observation, far inside the default limit: these small matrices converge in few sweeps.
    (assert (<= (jc:eigen-sweeps eigen) 15) () "~A took ~D sweeps." label (jc:eigen-sweeps eigen))
    (setf *jc-most-sweeps* (max *jc-most-sweeps* (jc:eigen-sweeps eigen)))
    (let* ((values (jc:eigenvalues eigen)) (vectors (jc:eigenvectors eigen))
           (v (build-matrix n (lambda (i j) (rational (aref vectors (+ i (* j n)))))))
           (scale (* *unit-roundoff* (max 1 n) (matrix-max exact))))
      (loop for k from 1 below n do
        (assert (<= (aref values (1- k)) (aref values k)) () "~A: eigenvalues are not ascending: ~S." label values))
      (let* ((gram (matrix-product (matrix-transpose v) v))
             (defect (matrix-max (build-matrix n (lambda (i j) (- (aref gram i j) (if (= i j) 1 0)))))))
        (assert (<= defect (* 8 (1+ n) *unit-roundoff*)) ()
                "~A: V^T V differs from the identity by ~E." label (float defect 1d0))
        (setf *jc-worst-orthogonality* (max *jc-worst-orthogonality* (/ defect *unit-roundoff*))))
      (let* ((av (matrix-product exact v))
             (residual (matrix-max (build-matrix n (lambda (i j) (- (aref av i j)
                                                                    (* (aref v i j) (rational (aref values j)))))))))
        (assert (<= residual (* 16 scale)) ()
                "~A: A V differs from V diag(values) by ~E, allowed ~E." label (float residual 1d0)
                (float (* 16 scale) 1d0))
        (when (plusp scale) (setf *jc-worst-residual* (max *jc-worst-residual* (/ residual scale)))))
      ;; At most k eigenvalues lie below value - delta, and at least k + 1 at or below value + delta.
      (dotimes (k n)
        (let* ((value (rational (aref values k)))
               (delta (if relative (* relative (abs value)) (* 16 scale))))
          (assert (<= (count-below exact (- value delta)) k) ()
                  "~A: eigenvalue ~D = ~S is too high." label k (aref values k))
          (assert (>= (count-at-or-below exact (+ value delta)) (1+ k)) ()
                  "~A: eigenvalue ~D = ~S is too low." label k (aref values k)))))
    eigen))

(defun check-svd (label matrix &key relative)
  "Compute through the public interface and check order, both factors, A V = U S, the rank, and every bracket."
  (let* ((m (array-dimension matrix 0)) (n (array-dimension matrix 1))
         (svd (jc:make-svd m n)) (exact (rect-stored matrix))
         (gram (rect-product (rect-transpose exact) exact)))
    (assert (= 0 (jc-caller:observe-svd svd (rect-column-major matrix))) () "~A: decomposition refused." label)
    (assert (jc:svd-ready? svd))
    (assert (<= (jc:svd-sweeps svd) 15) () "~A took ~D sweeps." label (jc:svd-sweeps svd))
    (setf *jc-most-sweeps* (max *jc-most-sweeps* (jc:svd-sweeps svd)))
    (let* ((sigma (jc:singular-values svd)) (left (jc:left-vectors svd)) (right (jc:right-vectors svd))
           (u (rect m n (lambda (i j) (rational (aref left (+ i (* j m)))))))
           (v (rect n n (lambda (i j) (rational (aref right (+ i (* j n)))))))
           (scale (* *unit-roundoff* (max 1 n) (largest-column-norm exact)))
           (kept (if (plusp n) (* 1d-9 (aref sigma 0)) 0d0)))
      (dotimes (j n)
        (assert (>= (aref sigma j) 0d0))
        (when (plusp j) (assert (>= (aref sigma (1- j)) (aref sigma j)) () "~A: values are not descending." label)))
      (let* ((product (rect-product (rect-transpose v) v))
             (defect (rect-max (rect n n (lambda (i j) (- (aref product i j) (if (= i j) 1 0)))))))
        (assert (<= defect (* 8 (1+ n) *unit-roundoff*)) ()
                "~A: V^T V differs from the identity by ~E." label (float defect 1d0))
        (setf *jc-worst-orthogonality* (max *jc-worst-orthogonality* (/ defect *unit-roundoff*))))
      (let* ((av (rect-product exact v))
             (residual (rect-max (rect m n (lambda (i j) (- (aref av i j)
                                                           (* (aref u i j) (rational (aref sigma j)))))))))
        (assert (<= residual (* 16 scale)) ()
                "~A: A V differs from U diag(values) by ~E, allowed ~E." label (float residual 1d0)
                (float (* 16 scale) 1d0))
        (when (plusp scale) (setf *jc-worst-residual* (max *jc-worst-residual* (/ residual scale)))))
      ;; Left vectors of the kept values are orthonormal; a zero value has a zero left vector.
      (dotimes (j n)
        (when (= 0d0 (aref sigma j))
          (dotimes (i m) (assert (= 0 (aref u i j)) () "~A: a zero value has a nonzero left vector." label)))
        (when (> (aref sigma j) kept)
          (dotimes (other n)
            (when (> (aref sigma other) kept)
              (assert (<= (abs (- (loop for i below m sum (* (aref u i j) (aref u i other)))
                                  (if (= j other) 1 0)))
                          (* 16 (1+ m) *unit-roundoff*))
                      () "~A: left vectors ~D and ~D are not orthonormal." label j other)))))
      ;; The graded case spans more than the threshold's nine decimal orders by design.
      (unless relative
        (assert (= (jc:rank-above svd kept) (length (exact-basis-columns exact))) ()
                "~A: rank ~D by threshold, exact rank ~D." label (jc:rank-above svd kept)
                (length (exact-basis-columns exact))))
      ;; Value j, counted from the largest, squares to eigenvalue n - 1 - j of A^T A.
      (dotimes (j n)
        (let* ((value (rational (aref sigma j)))
               (delta (if relative (* relative value) (* 16 scale))))
          (when (> value delta)
            (assert (<= (count-below gram (expt (- value delta) 2)) (- n 1 j)) ()
                    "~A: singular value ~D = ~S is too high." label j (aref sigma j)))
          (assert (>= (count-at-or-below gram (expt (+ value delta) 2)) (- n j)) ()
                  "~A: singular value ~D = ~S is too low." label j (aref sigma j)))))
    svd))

(defun run-jacobi-eigen-tests ()
  (setf *jc-worst-orthogonality* 0 *jc-worst-residual* 0 *jc-most-sweeps* 0)
  (let ((cases 0))
    (flet ((check (label matrix &rest keys)
             (incf cases)
             (apply #'check-eigen label (if (listp matrix) (rows-matrix matrix) matrix) keys)))
      (check "empty" '())
      (check "one" '((-3)))
      (check "exchange" '((0 1) (1 0)))
      (check "two" '((2 1) (1 2)))
      (check "zero matrix" '((0 0 0) (0 0 0) (0 0 0)))
      (check "repeated" (build-matrix 4 (lambda (i j) (if (= i j) 3 1))))
      (check "rank one" (build-matrix 5 (lambda (i j) (* (1+ i) (1+ j)))))
      ;; An already diagonal matrix needs one sweep that rotates nothing, and comes back sorted.
      (let ((eigen (check "diagonal" '((3 0 0) (0 1 0) (0 0 2)))))
        (assert (= 1 (jc:eigen-sweeps eigen)))
        (assert (equalp (jc:eigenvalues eigen) (doubles 1d0 2d0 3d0)))
        (assert (equalp (jc:eigenvectors eigen) (doubles 0d0 1d0 0d0  0d0 0d0 1d0  1d0 0d0 0d0))))
      ;; The second-difference matrix has eigenvalues 2 - 2 cos(k pi / (n + 1)).
      (let* ((n 7) (eigen (check "second difference"
                                 (build-matrix n (lambda (i j) (cond ((= i j) 2) ((= 1 (abs (- i j))) -1) (t 0)))))))
        (dotimes (k n)
          (assert (< (abs (- (aref (jc:eigenvalues eigen) k) (- 2 (* 2 (cos (/ (* (1+ k) pi) (1+ n)))))))
                     1d-14))))
      (let ((state (sb-ext:seed-random-state 20261123)))
        (loop for n from 1 to 8 do
          (dotimes (repeat 6)
            (dolist (zero-diagonal '(nil t))
              (check (format nil "seeded n=~D #~D zero-diagonal=~A" n repeat zero-diagonal)
                     (seeded-symmetric state n zero-diagonal)))))
        ;; Positive semidefinite matrices of low rank: exact zero eigenvalues, computed at rounding level.
        (loop for n from 2 to 7 do
          (loop for rank from 0 below n do
            (let ((factor (seeded-product state 5 n rank)))
              (check (format nil "semidefinite n=~D rank<=~D" n rank)
                     (rect-product (rect-transpose factor) factor))))))
      ;; A graded positive definite matrix: every eigenvalue, across 80 binary orders, to a relative 2^-40.
      (check "graded"
             (build-matrix 5 (lambda (i j) (* (if (= i j) 4 1) (expt 2 (* -10 (+ i j))))))
             :relative (expt 2 -40)))
    (format t "JACOBI-EIGEN-PASS cases=~D most-sweeps=~D worst-orthogonality=~,3F worst-residual=~,3F ~
               (units of roundoff, and of roundoff times n max|A|)~%"
            cases *jc-most-sweeps* (float *jc-worst-orthogonality* 1d0) (float *jc-worst-residual* 1d0))))

(defun run-jacobi-svd-tests ()
  (setf *jc-worst-orthogonality* 0 *jc-worst-residual* 0 *jc-most-sweeps* 0)
  (let ((cases 0))
    (flet ((check (label matrix &rest keys)
             (incf cases)
             (apply #'check-svd label (if (listp matrix) (rect-of-rows matrix) matrix) keys)))
      (let ((svd (check "diagonal" '((3 0) (0 4)))))
        (assert (equalp (jc:singular-values svd) (doubles 4d0 3d0)))
        (assert (= 1 (jc:svd-sweeps svd))))
      (check "line fit" '((1 0) (1 1) (1 2)))
      (check "rank one" '((1 2) (2 4)))
      (check "one by one" '((-5)))
      ;; A wide matrix has a complete right factor: its last column spans the nullspace.
      (let ((svd (check "one constraint" '((1 1)))))
        (assert (< (abs (- (aref (jc:singular-values svd) 0) (sqrt 2d0))) 1d-15))
        (assert (= 0d0 (aref (jc:singular-values svd) 1)))
        (assert (< (abs (+ (aref (jc:right-vectors svd) 2) (aref (jc:right-vectors svd) 3))) 1d-15) ()
                "The nullspace vector of [1 1] is ~S." (subseq (jc:right-vectors svd) 2 4)))
      (let ((svd (check "zero matrix" '((0 0 0) (0 0 0)))))
        (assert (= 1 (jc:svd-sweeps svd)))
        (assert (every #'zerop (jc:singular-values svd)))
        (assert (every #'zerop (jc:left-vectors svd)))
        (assert (equalp (jc:right-vectors svd) (doubles 1d0 0d0 0d0  0d0 1d0 0d0  0d0 0d0 1d0))))
      (check "no rows" (rect 0 3 (lambda (i j) (declare (ignore i j)) 0)))
      (check "no columns" (rect 3 0 (lambda (i j) (declare (ignore i j)) 0)))
      (check "nothing" (rect 0 0 (lambda (i j) (declare (ignore i j)) 0)))
      (let ((state (sb-ext:seed-random-state 20261124)))
        (loop for (m n) in '((1 1) (2 1) (1 3) (2 2) (3 2) (2 4) (3 3) (5 3) (3 6) (4 4) (6 4) (4 7)
                             (5 5) (7 5) (5 8) (6 6))
              do (loop for rank from 0 to (min m n) do
                   (dotimes (repeat 2)
                     (check (format nil "seeded ~Dx~D rank<=~D #~D" m n rank repeat)
                            (seeded-product state m n rank))))))
      ;; Graded columns: every singular value, across 40 binary orders, to a relative 2^-30.
      (check "graded columns"
             (rect 4 3 (lambda (i j) (* (nth j (nth i '((2 1 0) (1 3 1) (0 1 2) (1 1 1)))) (expt 2 (* -20 j)))))
             :relative (expt 2 -30)))
    (format t "JACOBI-SVD-PASS cases=~D most-sweeps=~D worst-orthogonality=~,3F worst-residual=~,3F ~
               (units of roundoff, and of roundoff times n times the largest column norm)~%"
            cases *jc-most-sweeps* (float *jc-worst-orthogonality* 1d0) (float *jc-worst-residual* 1d0))))

(defun run-jacobi-identity-tests ()
  ;; Scaling by a power of four scales the values exactly and leaves the vectors unchanged,
  ;; including where a sum of squares would overflow or underflow unscaled.
  (let* ((symmetric (rows-matrix '((2 3 1 -2) (3 0 2 1) (1 2 1 0) (-2 1 0 -1))))
         (rectangular (rect-of-rows '((3 1 -2) (1 0 2) (-2 2 1) (1 1 1))))
         (base-eigen (jc:make-symmetric-eigen 4)) (base-svd (jc:make-svd 4 3)))
    (assert (= 0 (jc-caller:observe-eigen base-eigen (column-major symmetric))))
    (assert (= 0 (jc-caller:observe-svd base-svd (rect-column-major rectangular))))
    (dolist (power '(-600 -30 28 600))
      (let ((eigen (jc:make-symmetric-eigen 4)) (svd (jc:make-svd 4 3)) (factor (expt 2 power)))
        (assert (= 0 (jc-caller:observe-eigen
                      eigen (column-major (matrix-map (lambda (v) (* v factor)) symmetric)))))
        (assert (equalp (jc:eigenvectors eigen) (jc:eigenvectors base-eigen)) ()
                "Scaling by 2^~D changed the eigenvectors." power)
        (dotimes (k 4)
          (assert (= (aref (jc:eigenvalues eigen) k) (scale-float (aref (jc:eigenvalues base-eigen) k) power))))
        (assert (= 0 (jc-caller:observe-svd
                      svd (rect-column-major (rect 4 3 (lambda (i j) (* (aref rectangular i j) factor)))))))
        (assert (equalp (jc:left-vectors svd) (jc:left-vectors base-svd)) ()
                "Scaling by 2^~D changed the left vectors." power)
        (assert (equalp (jc:right-vectors svd) (jc:right-vectors base-svd)))
        (dotimes (k 3)
          (assert (= (aref (jc:singular-values svd) k)
                     (scale-float (aref (jc:singular-values base-svd) k) power))))))
    ;; A repeated call repeats every bit.
    (let ((values (copy-seq (jc:eigenvalues base-eigen))) (vectors (copy-seq (jc:eigenvectors base-eigen)))
          (sigma (copy-seq (jc:singular-values base-svd))) (right (copy-seq (jc:right-vectors base-svd))))
      (assert (= 0 (jc-caller:observe-eigen base-eigen (column-major symmetric))))
      (assert (= 0 (jc-caller:observe-svd base-svd (rect-column-major rectangular))))
      (assert (and (equalp values (jc:eigenvalues base-eigen)) (equalp vectors (jc:eigenvectors base-eigen))))
      (assert (and (equalp sigma (jc:singular-values base-svd)) (equalp right (jc:right-vectors base-svd)))))
    ;; The transpose has the same nonzero singular values.
    (let ((transposed (jc:make-svd 3 4)))
      (assert (= 0 (jc-caller:observe-svd transposed (rect-column-major (rect-transpose rectangular)))))
      (dotimes (k 3)
        (assert (< (abs (- (aref (jc:singular-values transposed) k) (aref (jc:singular-values base-svd) k)))
                   (* 1d-14 (aref (jc:singular-values base-svd) 0)))))
      (assert (< (aref (jc:singular-values transposed) 3) (* 1d-14 (aref (jc:singular-values base-svd) 0)))))
    ;; For a positive semidefinite matrix the singular values are the eigenvalues, largest first.
    (let* ((factor (rect-of-rows '((1 2 0) (0 1 1) (2 0 1) (1 1 1))))
           (psd (rect-product (rect-transpose factor) factor))
           (eigen (jc:make-symmetric-eigen 3)) (svd (jc:make-svd 3 3)))
      (assert (= 0 (jc-caller:observe-eigen eigen (column-major psd))))
      (assert (= 0 (jc-caller:observe-svd svd (rect-column-major psd))))
      (dotimes (k 3)
        (assert (< (abs (- (aref (jc:singular-values svd) k) (aref (jc:eigenvalues eigen) (- 2 k))))
                   (* 1d-13 (aref (jc:singular-values svd) 0)))))))
  ;; The two rank-revealing routines agree: the minimum-norm solution through the singular
  ;; vectors equals the one through the orthogonal decomposition.
  (let ((state (sb-ext:seed-random-state 5150)))
    (loop for (m n rank) in '((5 3 2) (3 6 2) (4 4 3) (6 4 4) (4 7 4)) do
      (let* ((matrix (seeded-product state m n rank))
             (a (rect-column-major matrix))
             (b (make-array m :element-type 'double-float
                              :initial-contents (loop repeat m collect (coerce (- (random 9 state) 4) 'double-float))))
             (svd (jc:make-svd m n)) (decomposition (og:make-decomposition m n))
             (x (zero-vector n)) (y (zero-vector n)))
        (assert (= 0 (jc-caller:observe-svd svd a)))
        (assert (= 0 (og-caller:observe-factor decomposition a)))
        (let ((kept (jc:rank-above svd (* 1d-9 (aref (jc:singular-values svd) 0)))))
          (assert (= kept (og:rank-above decomposition (* 1d-9 (og:pivot-magnitude decomposition 0)))))
          (assert (= 0 (og-caller:observe-rank decomposition kept)))
          (assert (= 0 (og-caller:observe-solve decomposition b x)))
          (dotimes (j kept)
            (let ((projection (/ (loop for i below m sum (* (aref (jc:left-vectors svd) (+ i (* j m))) (aref b i)))
                                 (aref (jc:singular-values svd) j))))
              (dotimes (i n)
                (incf (aref y i) (* projection (aref (jc:right-vectors svd) (+ i (* j n))))))))
          (dotimes (i n)
            (assert (< (abs (- (aref x i) (aref y i))) (* 1d-10 (+ 1 (abs (aref x i))))) ()
                    "~Dx~D: solutions differ at ~D: ~S and ~S." m n i (aref x i) (aref y i)))))))
  (format t "JACOBI-IDENTITIES-PASS~%"))

(defun run-jacobi-lifetime-tests ()
  (let* ((matrix (rows-matrix '((4 -2 0 1) (-2 5 1 0) (0 1 3 2) (1 0 2 6))))
         (a (column-major matrix)) (eigen (jc:make-symmetric-eigen 4)) (svd (jc:make-svd 4 4))
         (infinity sb-ext:double-float-positive-infinity))
    (assert (and (not (jc:eigen-ready? eigen)) (not (jc:svd-ready? svd))))
    (assert (= 0 (jc:rank-above svd 0d0)) () "A rank was reported before any decomposition.")
    ;; The sweep limit is the bound on work: reaching it is a named outcome, never a silent result.
    (dolist (limit '(0 1))
      (assert (= 1 (jc-caller:observe-eigen-limit eigen a limit)))
      (assert (not (jc:eigen-ready? eigen)))
      (assert (= limit (jc:eigen-sweeps eigen)))
      (assert (= 1 (jc-caller:observe-svd-limit svd a limit)))
      (assert (not (jc:svd-ready? svd)))
      (assert (= limit (jc:svd-sweeps svd))))
    (assert (= 0 (jc-caller:observe-eigen eigen a)))
    (assert (= 0 (jc-caller:observe-svd svd a)))
    (assert (<= 2 (jc:eigen-sweeps eigen) (coalton:coalton jc:default-sweep-limit)))
    (assert (= 0 (jc-caller:observe-eigen-limit eigen a (jc:eigen-sweeps eigen))) ()
            "The reported sweep count is not enough to converge again.")
    ;; Every refusal withdraws what stood before.
    (dolist (attempt (list (lambda () (jc-caller:observe-eigen eigen (doubles 1d0 2d0 3d0)))
                           (lambda () (let ((bad (copy-seq a))) (setf (aref bad 6) infinity)
                                        (jc-caller:observe-eigen eigen bad)))
                           (lambda () (let ((bad (copy-seq a))) (setf (aref bad 0) (not-a-number))
                                        (jc-caller:observe-eigen eigen bad)))
                           (lambda () (jc-caller:observe-eigen-limit eigen a 1))))
      (assert (= 0 (jc-caller:observe-eigen eigen a)))
      (assert (/= 0 (funcall attempt)))
      (assert (not (jc:eigen-ready? eigen)) () "A refused eigenvalue computation left a result standing."))
    (dolist (attempt (list (lambda () (jc-caller:observe-svd svd (doubles 1d0 2d0 3d0)))
                           (lambda () (let ((bad (copy-seq a))) (setf (aref bad 1) infinity)
                                        (jc-caller:observe-svd svd bad)))
                           (lambda () (let ((bad (copy-seq a))) (setf (aref bad 0) (not-a-number))
                                        (jc-caller:observe-svd svd bad)))
                           (lambda () (jc-caller:observe-svd-limit svd a 1))))
      (assert (= 0 (jc-caller:observe-svd svd a)))
      (assert (/= 0 (funcall attempt)))
      (assert (and (not (jc:svd-ready? svd)) (= 0 (jc:rank-above svd 0d0))) ()
              "A refused decomposition left a result standing."))
    (assert (= 3 (jc-caller:observe-eigen eigen (doubles 1d0 2d0 3d0))))
    (assert (= 2 (jc-caller:observe-eigen eigen (let ((bad (copy-seq a))) (setf (aref bad 6) infinity) bad))))
    (assert (= 3 (jc-caller:observe-svd svd (doubles 1d0 2d0 3d0))))
    (assert (= 2 (jc-caller:observe-svd svd (let ((bad (copy-seq a))) (setf (aref bad 1) infinity) bad)))))
  ;; Results that overflow are refusals.
  (let ((big (/ most-positive-double-float 1.2d0)))
    (assert (= 2 (jc-caller:observe-eigen (jc:make-symmetric-eigen 2) (doubles big big big big))))
    (assert (= 2 (jc-caller:observe-svd (jc:make-svd 2 1) (doubles big big)))))
  ;; Rank thresholds are absolute and strict.
  (let ((svd (jc:make-svd 3 3)))
    (assert (= 0 (jc-caller:observe-svd svd (doubles 1d0 0d0 0d0  0d0 4d0 0d0  0d0 0d0 2d0))))
    (loop for (threshold expected) in '((-1d0 3) (0d0 3) (0.999d0 3) (1d0 2) (2d0 1) (4d0 0))
          do (assert (= expected (jc:rank-above svd threshold)) ()
                     "Threshold ~S gave rank ~D." threshold (jc:rank-above svd threshold))))
  ;; Storage is refused by name before it is allocated.
  (let ((limit (coalton:coalton jc:maximum-dimension)) (budget (coalton:coalton jc:default-entry-limit)))
    (assert (= 0 (jc-caller:eigen-storage-error 3 9)))
    (assert (= 4 (jc-caller:eigen-storage-error 3 8)))
    (assert (= 3 (jc-caller:eigen-storage-error (1+ limit) budget)))
    (assert (= 4 (jc-caller:eigen-storage-error 4097 budget)))
    (assert (= 0 (jc-caller:svd-storage-error 2 3 9)))
    (assert (= 4 (jc-caller:svd-storage-error 2 3 8)) () "The right factor's n * n entries were not budgeted.")
    (assert (= 4 (jc-caller:svd-storage-error 4 3 11)))
    (assert (= 3 (jc-caller:svd-storage-error (1+ limit) 1 budget)))
    (assert (= 3 (jc-caller:svd-storage-error 1 (1+ limit) budget))))
  (format t "JACOBI-LIFETIME-PASS~%"))

(defparameter *jacobi-public-control*
  "(declare inspect (coalton-linalg/dense/jacobi:SymmetricEigen * coalton-linalg/dense/jacobi:Svd -> UFix))
   (define (inspect eigen svd)
     (+ (coalton-linalg/dense/jacobi:eigen-dimension eigen) (coalton-linalg/dense/jacobi:svd-columns svd)))
   (declare probe (Void -> UFix))
   (define (probe)
     (inspect (coalton-linalg/dense/jacobi:make-symmetric-eigen 3) (coalton-linalg/dense/jacobi:make-svd 3 2)))")

(defparameter *jacobi-encapsulation-probes*
  '(("jacobi-eigen-construction" .
     "(declare probe (Void -> coalton-linalg/dense/jacobi:SymmetricEigen))
      (define (probe)
        (coalton-linalg/dense/jacobi:SymmetricEigen
          0 (arr:make 0 0.0d0) (arr:make 0 0.0d0) (arr:make 0 0.0d0) (arr:make 2 (the UFix 0))))")
    ("jacobi-eigen-state-access" .
     "(declare probe (coalton-linalg/dense/jacobi:SymmetricEigen -> UFix))
      (define (probe eigen) (arr:aref (.state eigen) 0))")
    ("jacobi-svd-destructuring" .
     "(declare probe (coalton-linalg/dense/jacobi:Svd -> UFix))
      (define (probe svd)
        (match svd
          ((coalton-linalg/dense/jacobi:Svd rows _ _ _ _ _) rows)))")
    ("jacobi-svd-work-access" .
     "(declare probe (coalton-linalg/dense/jacobi:Svd -> arr:LispArray F64))
      (define (probe svd) (.left svd))")
    ("jacobi-handle-confusion" .
     "(declare probe (coalton-linalg/dense/jacobi:SymmetricEigen -> coalton-linalg/dense/jacobi:Svd))
      (define (probe eigen) eigen)")))

(defun run-jacobi-encapsulation-tests ()
  "External Coalton callers can use the two handles only through their public operations."
  (multiple-value-bind (accepted diagnostics)
      (coalton-linalg/tests/encapsulation::compile-probe "jacobi-public-control" *jacobi-public-control*
                                                         :execute t)
    (assert accepted () "The valid Jacobi external caller failed:~%~A" diagnostics))
  (dolist (probe *jacobi-encapsulation-probes*)
    (assert (not (coalton-linalg/tests/encapsulation::compile-probe (car probe) (cdr probe))) ()
            "External caller ~A compiled despite required rejection." (car probe)))
  (dolist (name '("MKSYMMETRICEIGEN" "EIGENSTORAGE" "MKSVD" "SVDSTORAGE"))
    (multiple-value-bind (symbol visibility) (find-symbol name "COALTON-LINALG/DENSE/JACOBI")
      (assert (and symbol (eq visibility :internal)) ()
              "Storage constructor ~A must exist and remain internal; visibility is ~S." name visibility)))
  (format t "JACOBI-ENCAPSULATION-PASS rejected=~D public-control=1~%" (length *jacobi-encapsulation-probes*)))

(defun run-jacobi-tests ()
  (run-jacobi-eigen-tests)
  (run-jacobi-svd-tests)
  (run-jacobi-identity-tests)
  (run-jacobi-lifetime-tests)
  (run-jacobi-encapsulation-tests)
  ;; Warmed repeated work through compiled Coalton callers allocates nothing.
  (let* ((state (sb-ext:seed-random-state 88))
         (symmetric (column-major (seeded-symmetric state 10 nil)))
         (rectangular (rect-column-major (seeded-product state 8 10 5)))
         (eigen (jc:make-symmetric-eigen 10)) (svd (jc:make-svd 8 10)))
    (assert (= 0 (jc-caller:eigen-loop eigen symmetric 2)) () "The eigenvalue allocation case does not run.")
    (assert (= 5 (jc-caller:svd-loop svd rectangular 1d-9 2)) () "The SVD allocation case has rank ~D."
            (jc-caller:svd-loop svd rectangular 1d-9 1))
    (allocation-check "jacobi-eigen" (lambda () (jc-caller:eigen-loop eigen symmetric 1)) 2000)
    (allocation-check "jacobi-svd" (lambda () (jc-caller:svd-loop svd rectangular 1d-9 1)) 2000))
  (format t "JACOBI-TESTS-PASS~%"))
