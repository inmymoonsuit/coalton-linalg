(in-package #:coalton-linalg/tools)

(defun parser-order-regression (directory)
  (handler-case
      (progn (read-fixture directory "unsorted")
             (error "UNSORTED-TRIPLETS-WERE-ACCEPTED"))
    (error (e)
      (when (search "UNSORTED-TRIPLETS-WERE-ACCEPTED" (princ-to-string e))
        (error e)))))

(defun run-tools-tests ()
(let* ((base (asdf:system-source-directory "coalton-linalg"))
       (dir (merge-pathnames "build/runner-input/" base))
       (output (merge-pathnames "build/runner-output/" base)))
  (ensure-directories-exist dir)
  (with-open-file (f (merge-pathnames "unsorted.A.txt" dir) :direction :output :if-exists :supersede)
    (format f "2 3~%0 0 4~%1 1 3~%1 0 2~%"))
  (with-open-file (f (merge-pathnames "unsorted.b.txt" dir) :direction :output :if-exists :supersede)
    (format f "8~%8~%"))
  (parser-order-regression dir)
  (format t "PARSER-ORDER-GREEN~%")
  (let ((original (symbol-function 'read-fixture)) (form nil))
    (unwind-protect
         (progn
           (let ((*package* (find-package :coalton-linalg/tools)) (*read-eval* nil))
           (with-open-file (source (merge-pathnames "tools/fixtures.lisp" base))
             (loop :for candidate := (read source nil nil) :while candidate
                   :when (and (consp candidate) (eq (first candidate) 'defun)
                             (eq (second candidate) 'read-fixture))
                     :do (setf form candidate) (return))))
           (unless form (error "Fixture reader definition was not found."))
           (labels ((remove-order-guard (tree)
                      (cond
                        ((atom tree) tree)
                        ((and (eq (first tree) 'unless)
                              (equal (second tree)
                                     '(or (> j last-column) (and (= j last-column) (> i last-row)))))
                         nil)
                        (t (mapcar #'remove-order-guard tree)))))
             (eval (remove-order-guard form)))
           (handler-case
               (progn (parser-order-regression dir) (error "MUTANT-NOT-DETECTED"))
             (error (e)
               (unless (search "UNSORTED-TRIPLETS-WERE-ACCEPTED" (princ-to-string e))
                 (error e))
               (format t "PARSER-ORDER-MUTANT-RED ~A~%" e))))
      (setf (symbol-function 'read-fixture) original)))
  (parser-order-regression dir)
  ;; The malformed fixture is not passed to the numerical runner.
  (let ((rerun (merge-pathnames "rerun/" dir)))
    (ensure-directories-exist rerun)
    (with-open-file (f (merge-pathnames "same.b.txt" rerun) :direction :output :if-exists :supersede)
      (format f "2~%"))
    (flet ((matrix (value)
             (with-open-file (f (merge-pathnames "same.A.txt" rerun) :direction :output :if-exists :supersede)
               (format f "1 1~%0 0 ~D~%" value))))
      (matrix 2)
      (run-fixtures rerun output :repeats 1 :allocation-repeats 1)
      (assert (probe-file (merge-pathnames "same.x.out.txt" output)))
      (matrix -2)
      (run-fixtures rerun output :repeats 1 :allocation-repeats 1)
      (assert (probe-file (merge-pathnames "same.refused.out.txt" output)))
      (assert (not (probe-file (merge-pathnames "same.x.out.txt" output))))
      (matrix 2)
      (run-fixtures rerun output :repeats 1 :allocation-repeats 1)
      (assert (not (probe-file (merge-pathnames "same.refused.out.txt" output))))
      (format t "RERUN-ARTIFACTS-PASS~%"))))
(format t "RUNNER-TESTS-PASS~%"))
