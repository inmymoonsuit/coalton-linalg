(in-package #:coalton-linalg/tests)
(export 'run-tests)

(defun run-tests ()
  "Signal an error on failure; callable through ASDF:TEST-SYSTEM."
  (allocation-control-test)
  (run-interface-tests)
  (run-runtime-tests)
  (run-property-tests)
  (run-primitive-tests)
  (run-buffered-product-tests)
  (run-buffered-property-tests)
  (run-gram-runtime-tests)
  (run-gram-property-tests)
  (run-condition-tests)
  (run-indefinite-tests)
  (run-orthogonal-tests)
  (run-jacobi-tests)
  (run-cholesky-form-tests)
  (run-quasidefinite-tests)
  (run-ordering-tests)
  (run-scaling-tests)
  (run-refinement-tests)
  (run-dependent-rows-tests)
  (run-lu-tests)
  (coalton-linalg/tests/typed-errors:run-typed-error-tests)
  (coalton-linalg/tests/encapsulation:run-encapsulation-tests)
  (coalton-linalg/tests/encapsulation:run-status-type-tests)
  (coalton-linalg/tests/encapsulation:run-typed-status-tests)
  (assert (close-vector-p (coalton-linalg/examples:solve-2x2) (doubles 1d0 2d0)))
  (assert (close-vector-p (coalton-linalg/examples/sparse:normal-product) (doubles -2d0 54d0 73d0)))
  (assert (close-vector-p (coalton-linalg/examples/normal-equations:fit-line) (doubles 1d0 2d0)))
  (assert (close-vector-p (coalton-linalg/examples/minimum-norm:minimum-norm-solution) (doubles 1d0 1d0 2d0 2d0)))
  (assert (close-vector-p (coalton-linalg/examples/dependent-constraints:shortest-solution)
                          (doubles 1d0 1d0 2d0 2d0)))
  (assert (= 2 (coalton-linalg/examples/singular-rank:constraint-rank)))
  (assert (close-vector-p (coalton-linalg/examples/augmented-minimum-norm:sparse-shortest-solution)
                          (doubles 1d0 1d0 2d0 2d0) 1d-9))
  (assert (close-vector-p (coalton-linalg/examples/scaled-solve:scaled-solution)
                          (doubles (scale-float 1d0 20) 1d0 (scale-float 1d0 -20))))
  (assert (= 1 (coalton-linalg/examples/redundant-rows:redundant-row-count)))
  (assert (<= 0d0 (coalton-linalg/examples/redundant-rows:redundant-row-product) 1d-12))
  (assert (close-vector-p (coalton-linalg/examples/nonsymmetric-solve:nonsymmetric-solution)
                          (doubles 1d0 2d0 3d0)))
  (assert (close-vector-p (coalton-linalg/examples/nonsymmetric-solve:transposed-solution)
                          (doubles 5d0 (/ 24d0 11d0) (/ 5d0 11d0))))
  (format t "COALTON-EXAMPLE-PASS~%LIBRARY-TESTS-PASS~%"))