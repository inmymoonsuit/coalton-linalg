(cl:defpackage #:coalton-linalg/tests/cholesky-callers
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:ldlt #:coalton-linalg/sparse/spd-ldlt)
                    (#:arr #:coalton/lisparray) (#:cell #:coalton/cell))
  (:export #:observe-cholesky #:cholesky-loop #:cholesky-solve-loop))
(cl:in-package #:coalton-linalg/tests/cholesky-callers)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety 1)))

(coalton-toplevel
  (declare observe-cholesky (ldlt:Symbolic * arr:LispArray F64 * F64 -> UFix))
  (define (observe-cholesky symbolic values shift)
    "Exhaustively matched outcome: success 0, non-positive 1, non-finite 2, values 3, shift 4."
    (match (ldlt:factor-cholesky! symbolic values shift)
      ((ldlt:FactorSuccess) 0)
      ((ldlt:FactorNonPositive) 1)
      ((ldlt:FactorNonFinite) 2)
      ((ldlt:FactorBadValues) 3)
      ((ldlt:FactorBadShift) 4)))

  (declare cholesky-loop (ldlt:Symbolic * arr:LispArray F64 * F64 * UFix -> UFix))
  (define (cholesky-loop symbolic values shift count)
    "A real external caller: the proof factorization at a shift, then the solving factorization; count what goes wrong."
    (let failures = (cell:new (the UFix 0)))
    (let factor = (ldlt:symbolic-factor symbolic))
    (for ((i 0 (+ i 1))) :while (< i count)
      (unless (== (ldlt:factor-cholesky! symbolic values shift) ldlt:FactorSuccess)
        (cell:write! failures (+ (cell:read failures) 1)))
      (unless (and (ldlt:cholesky-ready? factor) (not (ldlt:factor-ready? factor)))
        (cell:write! failures (+ (cell:read failures) 1)))
      (unless (== (ldlt:factor! symbolic values 0.0d0) ldlt:FactorSuccess)
        (cell:write! failures (+ (cell:read failures) 1))))
    (cell:read failures))

  (declare cholesky-solve-loop (ldlt:Symbolic * arr:LispArray F64 * F64 * arr:LispArray F64 * arr:LispArray F64 * UFix
                                -> UFix))
  (define (cholesky-solve-loop symbolic values shift rhs out count)
    "A real external caller: the proof factorization at a shift, then two solves with that same factor."
    (let failures = (cell:new (the UFix 0)))
    (let factor = (ldlt:symbolic-factor symbolic))
    (for ((i 0 (+ i 1))) :while (< i count)
      (unless (== (ldlt:factor-cholesky! symbolic values shift) ldlt:FactorSuccess)
        (cell:write! failures (+ (cell:read failures) 1)))
      (unless (== (ldlt:solve-cholesky! factor rhs out) ldlt:SolveSuccess)
        (cell:write! failures (+ (cell:read failures) 1)))
      (unless (== (ldlt:solve-cholesky! factor out out) ldlt:SolveSuccess)
        (cell:write! failures (+ (cell:read failures) 1))))
    (cell:read failures)))
