(cl:defpackage #:coalton-linalg/tests/rank-deficient-callers
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:rd #:coalton-linalg/sparse/rank-deficient)
                    (#:csc #:coalton-linalg/sparse/csc)
                    (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:err #:coalton-linalg/errors))
  (:export #:find-code #:reprove-code #:certify-code #:bounds-code #:analysis-code #:kept-loop
           #:step-code #:step-loop #:refresh-code #:refresh-to-code #:refresh-loop))
(cl:in-package #:coalton-linalg/tests/rank-deficient-callers)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety 1)))

(coalton-toplevel
  (declare error-code (err:LinalgError -> UFix))
  (define (error-code problem)
    "Test-only categories: structure 91, dimensions 92, aliasing 93, input 95, result 96, dimension limit 97, storage 98."
    (match problem
      ((err:InvalidStructure _) 91)
      ((err:InvalidDimensions _) 92)
      ((err:InvalidAliasing _) 93)
      ((err:NonFiniteInput _) 95)
      ((err:NonFiniteResult _) 96)
      ((err:AnalysisLimitExceeded _ _) 97)
      ((err:AnalysisStorageExceeded _ _) 98)
      (_ 99)))

  (declare find-status-code (rd:FindStatus -> UFix))
  (define (find-status-code status)
    (match status
      ((rd:FindFound) 0)
      ((rd:FindNonFinite) 1)
      ((rd:FindUnderflow) 2)
      ((rd:FindBadThreshold) 3)
      ((rd:FindBadDrop) 4)
      ((rd:FindVectorRefused) 5)))

  (declare find-code (rd:KeptRows * csc:Matrix * F64 * F64 -> UFix))
  (define (find-code kept matrix threshold drop)
    "Exhaustively matched outcome: found 0, non-finite 1, underflow 2, threshold 3, drop 4, vector 5; a typed error's category from 91."
    (catch (find-status-code (rd:find-kept-rows! kept matrix threshold drop))
      ((the err:LinalgError problem) (error-code problem))
      (_ 99)))

  (declare reprove-status-code (rd:ReproveStatus -> UFix))
  (define (reprove-status-code status)
    (match status
      ((rd:Reproved) 0)
      ((rd:ReproveNothingKept) 1)
      ((rd:ReproveNonFinite) 2)))

  (declare reprove-code (rd:KeptRows * csc:Matrix -> UFix))
  (define (reprove-code kept matrix)
    "Exhaustively matched outcome: reproved 0, nothing kept 1, non-finite 2; a typed error's category from 91."
    (catch (reprove-status-code (rd:reprove! kept matrix))
      ((the err:LinalgError problem) (error-code problem))
      (_ 99)))

  (declare certify-code (rd:KeptRows * F64 * F64 -> UFix))
  (define (certify-code kept lower-floor upper-floor)
    "Exhaustively matched outcome: certified 0, gap above floor 1, kept not above floor 2, unresolved 3, bad floor 4, nothing kept 5."
    (match (rd:certify! kept lower-floor upper-floor)
      ((rd:Certified) 0)
      ((rd:CertificateGapAboveFloor) 1)
      ((rd:CertificateKeptNotAboveFloor) 2)
      ((rd:CertificateUnresolved) 3)
      ((rd:CertificateBadFloor) 4)
      ((rd:CertificateNothingKept) 5)))

  (declare bounds-code (csc:Matrix * UFix * arr:LispArray F64 * arr:LispArray F64 * arr:LispArray F64 -> UFix))
  (define (bounds-code matrix steps work-columns work-rows out)
    "0 when the two bounds were written; a typed error's category from 91."
    (catch (progn (rd:largest-singular-bounds! matrix steps work-columns work-rows out) 0)
      ((the err:LinalgError problem) (error-code problem))
      (_ 99)))

  (declare analysis-code (csc:Matrix * UFix -> UFix))
  (define (analysis-code matrix limit)
    "0 when the analysis was made under the budget; a typed error's category from 91."
    (catch (progn (rd:analyze-with-limit matrix limit) 0)
      ((the err:LinalgError problem) (error-code problem))
      (_ 99)))

  (declare kept-loop (rd:KeptRows * csc:Matrix * F64 * F64 * UFix -> UFix))
  (define (kept-loop kept matrix lower-floor upper-floor repeats)
    "A real external caller, as a step taken many times on one kept set is: prove the bounds again for the values, then ask for the certificate; count what goes wrong."
    (let failures = (cell:new (the UFix 0)))
    (for ((k 0 (+ k 1))) :while (< k repeats)
      (unless (== (rd:reprove! kept matrix) rd:Reproved)
        (cell:write! failures (+ (cell:read failures) 1)))
      (unless (== (rd:certify! kept lower-floor upper-floor) rd:Certified)
        (cell:write! failures (+ (cell:read failures) 1))))
    (cell:read failures))

  (declare step-code (rd:KeptRows * arr:LispArray F64 * arr:LispArray F64 -> UFix))
  (define (step-code kept r out)
    "Exhaustively matched outcome: taken 0, no certificate 1, bad size 2, non-finite residual 3, factor refused 4, bound not reached 5, non-finite result 6."
    (match (rd:step! kept r out)
      ((rd:StepTaken) 0)
      ((rd:StepNoCertificate) 1)
      ((rd:StepBadSize) 2)
      ((rd:StepNonFiniteRhs) 3)
      ((rd:StepFactorRefused) 4)
      ((rd:StepBoundNotReached) 5)
      ((rd:StepNonFiniteResult) 6)))

  (declare step-loop (rd:KeptRows * csc:Matrix * F64 * F64 * arr:LispArray F64 * arr:LispArray F64 * UFix -> UFix))
  (define (step-loop kept matrix lower-floor upper-floor r out repeats)
    "A real external caller, as a solver's iteration is: prove the bounds again for the values, ask for the certificate, take the step twice, the second on the factor the first left; count what goes wrong."
    (let failures = (cell:new (the UFix 0)))
    (for ((k 0 (+ k 1))) :while (< k repeats)
      (unless (== (rd:reprove! kept matrix) rd:Reproved)
        (cell:write! failures (+ (cell:read failures) 1)))
      (unless (== (rd:certify! kept lower-floor upper-floor) rd:Certified)
        (cell:write! failures (+ (cell:read failures) 1)))
      (unless (== (rd:step! kept r out) rd:StepTaken)
        (cell:write! failures (+ (cell:read failures) 1)))
      (unless (== (rd:step! kept r out) rd:StepTaken)
        (cell:write! failures (+ (cell:read failures) 1))))
    (cell:read failures))

  (declare refresh-status-code (rd:RefreshStatus -> UFix))
  (define (refresh-status-code status)
    (match status
      ((rd:Refreshed) 0)
      ((rd:RefreshNothingKept) 1)
      ((rd:RefreshBadTarget) 2)
      ((rd:RefreshNoShift) 3)
      ((rd:RefreshFactorRefused) 4)
      ((rd:RefreshNonFinite) 5)))

  (declare refresh-code (rd:KeptRows * csc:Matrix * F64 -> UFix))
  (define (refresh-code kept matrix gap-target)
    "Exhaustively matched outcome: refreshed 0, nothing kept 1, bad target 2, no shift 3, factor refused 4, non-finite 5; a typed error's category from 91."
    (catch (refresh-status-code (rd:refresh! kept matrix gap-target))
      ((the err:LinalgError problem) (error-code problem))
      (_ 99)))

  (declare refresh-to-code (rd:KeptRows * csc:Matrix * F64 * F64 -> UFix))
  (define (refresh-to-code kept matrix gap-target fraction)
    "refresh-code for the form that takes the fraction of its share a replaced vector is corrected to."
    (catch (refresh-status-code (rd:refresh-to! kept matrix gap-target fraction))
      ((the err:LinalgError problem) (error-code problem))
      (_ 99)))

  (declare refresh-turn (rd:KeptRows * csc:Matrix * F64 * arr:LispArray F64 * arr:LispArray F64 -> UFix))
  (define (refresh-turn kept matrix floor r out)
    "One iteration on rows that change: refresh the kept vectors for the values, ask for the certificate, take the step; count what goes wrong, a refresh that replaced nothing included."
    (let failures = (cell:new (the UFix 0)))
    (unless (== (rd:refresh! kept matrix floor) rd:Refreshed)
      (cell:write! failures (+ (cell:read failures) 1)))
    (when (== (rd:refreshed-count kept) 0)
      (cell:write! failures (+ (cell:read failures) 1)))
    (unless (== (rd:certify! kept floor floor) rd:Certified)
      (cell:write! failures (+ (cell:read failures) 1)))
    (unless (== (rd:step! kept r out) rd:StepTaken)
      (cell:write! failures (+ (cell:read failures) 1)))
    (cell:read failures))

  (declare refresh-loop (rd:KeptRows * csc:Matrix * csc:Matrix * F64 * arr:LispArray F64 * arr:LispArray F64 * UFix -> UFix))
  (define (refresh-loop kept one other floor r out repeats)
    "A real external caller, as a solver's iteration on rows that change is: the two matrices in turn, each refreshed for, certified and stepped on."
    (let failures = (cell:new (the UFix 0)))
    (for ((k 0 (+ k 1))) :while (< k repeats)
      (cell:write! failures (+ (cell:read failures) (refresh-turn kept other floor r out)))
      (cell:write! failures (+ (cell:read failures) (refresh-turn kept one floor r out))))
    (cell:read failures)))
