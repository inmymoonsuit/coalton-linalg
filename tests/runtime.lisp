(in-package #:coalton-linalg/tests)

(defun handle-identity-tests ()
  "Compare actual raw Lisp, cross-file direct, and runtime-supplied first-class calls."
  (let* ((s (ldlt:analyze (ldlt:Pattern 2 (indices 0 2 3) (indices 0 1 1))))
         (other (ldlt:analyze (ldlt:Pattern 2 (indices 0 2 3) (indices 0 1 1))))
         (owned (ldlt:symbolic-factor s))
         (accessor (coalton:coalton ldlt:symbolic-factor))
         (raw-accessor (symbol-function 'ldlt:symbolic-factor))
         (values (doubles 4d0 2d0 3d0)))
    (assert (not (eq owned (ldlt:symbolic-factor other))))
    (flet ((check ()
             (assert (eq owned (funcall raw-accessor s)))
             (assert (eq owned (coalton-linalg/tests/callers:direct-handle s)))
             (assert (eq owned (coalton-linalg/tests/callers:first-class-handle accessor s)))))
      (check)
      (expected-status (ldlt:factor! s values 0d0) (coalton:coalton ldlt:FactorSuccess))
      (check)
      (expected-status (ldlt:factor! s values 10d0) (coalton:coalton ldlt:FactorNonPositive))
      (assert (not (ldlt:factor-ready? owned)))
      (check)
      (expected-status (ldlt:factor! s values 0d0) (coalton:coalton ldlt:FactorSuccess))
      (assert (ldlt:factor-ready? owned))
      (check))
    (allocation-check "handle-raw-lisp" (lambda () (funcall raw-accessor s)))
    (allocation-check "handle-cross-file-direct"
                      (lambda () (coalton-linalg/tests/callers:direct-handle s)))
    (allocation-check "handle-first-class"
                      (lambda () (coalton-linalg/tests/callers:first-class-handle accessor s))))
  (format t "HANDLE-IDENTITY-PASS paths=3 workspaces=2~%"))

(defun resource-limit-tests ()
  "Exercise the real gate, its precedence and exact supported boundary without giant inputs."
  (assert (= 4096 (coalton:coalton ldlt:maximum-analysis-size)))
  (flet ((pattern-error (n pointers rows)
           (uiop:symbol-call :coalton-linalg/tests/typed-status :analysis-pattern-error
                             n pointers rows)))
    (assert (= 7 (pattern-error 4097 (indices) (indices))))
    (assert (= 7 (pattern-error most-positive-fixnum (indices) (indices))))
    (assert (= 1 (pattern-error 1 (indices 0) (indices))))
    (assert (= 0 (pattern-error 0 (indices 0) (indices))))
    (let* ((n 4097)
           (pointers (make-array (1+ n) :element-type '(unsigned-byte 62)))
           (rows (make-array n :element-type '(unsigned-byte 62))))
      (dotimes (i (1+ n)) (setf (aref pointers i) i))
      (dotimes (i n) (setf (aref rows i) i))
      (assert (= 7 (pattern-error n pointers rows)))
      (let ((matrix (coalton-linalg/sparse/csc:from-csc
                     n n pointers rows (make-array n :element-type 'double-float :initial-element 1d0))))
        (assert (= 7 (uiop:symbol-call :coalton-linalg/tests/typed-status
                                       :analysis-csc-error matrix))))))
  (let ((rectangle (coalton-linalg/sparse/csc:from-csc
                     1 2 (indices 0 0 0) (indices) (doubles))))
    (assert (= 2 (uiop:symbol-call :coalton-linalg/tests/typed-status
                                   :analysis-csc-error rectangle))))
  (let* ((n 4096)
         (pointers (make-array (1+ n) :element-type '(unsigned-byte 62)))
         (rows (make-array n :element-type '(unsigned-byte 62))))
    (dotimes (i (1+ n)) (setf (aref pointers i) i))
    (dotimes (i n) (setf (aref rows i) i))
    (let* ((symbolic (ldlt:analyze (ldlt:Pattern n pointers rows)))
           (factor (ldlt:symbolic-factor symbolic)))
      (assert (= -1 (ldlt:refused-column symbolic)))
      (assert (not (ldlt:factor-ready? factor)))
      (assert (equalp rows (ldlt:factor-permutation factor)))
      (assert (= 0 (length (ldlt:factor-rows factor))))
      (assert (= (1+ n) (length (ldlt:factor-columns factor))))
      (assert (every #'zerop (ldlt:factor-columns factor)))))
  (format t "ANALYSIS-LIMIT-PASS maximum=4096 oversized=4097,max-ufix~%"))

(defun run-runtime-tests ()
  (let* ((s (ldlt:analyze (ldlt:Pattern 2 (indices 0 2 3) (indices 0 1 1))))
         (a (doubles 4d0 2d0 3d0)))
    (sb-ext:gc :full t)
    (coalton-linalg/tests/callers:dynamic-shifts s a 10000)
    (let* ((before (sb-ext:get-bytes-consed))
           (status (coalton-linalg/tests/callers:dynamic-shifts s a 10000))
           (bytes (- (sb-ext:get-bytes-consed) before)))
      (format t "DYNAMIC-SHIFT status=~D calls=10000 bytes=~D~%" status bytes)
      (assert (zerop status))
      (assert (zerop bytes))))
  (let* ((a (doubles))
         (s (ldlt:analyze (ldlt:Pattern 0 (indices 0) (indices))))
         (status (ldlt:factor! s a 0d0)))
    (assert (eq (coalton:coalton ldlt:FactorSuccess) status))
    (assert (= -1 (ldlt:refused-column s)))
    (assert (eq (coalton:coalton ldlt:SolveSuccess) (ldlt:solve! (ldlt:symbolic-factor s) a a)))
    (format t "EMPTY-SYSTEM-PASS~%"))
  (handle-identity-tests)
  (resource-limit-tests))
