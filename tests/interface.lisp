(defpackage #:coalton-linalg/tests
  (:use #:cl)
  (:local-nicknames (#:ldlt #:coalton-linalg/sparse/spd-ldlt))
  (:export #:run-interface-tests))
(in-package #:coalton-linalg/tests)
(declaim (optimize (speed 3) (safety 1)))

(defun indices (&rest contents)
  (make-array (length contents) :element-type '(unsigned-byte 62) :initial-contents contents))
(defun doubles (&rest contents)
  (make-array (length contents) :element-type 'double-float :initial-contents contents))
(defun close-vector-p (actual expected &optional (relative 1d-13))
  (and (= (length actual) (length expected))
       (loop :for a :across actual :for b :across expected
             :always (<= (abs (- a b)) (* relative (max 1d0 (abs b)))))))
(defun same-bits-p (left right)
  (and (= (length left) (length right))
       (loop :for a :across left :for b :across right
             :always (and (= (sb-kernel:double-float-high-bits a) (sb-kernel:double-float-high-bits b))
                         (= (sb-kernel:double-float-low-bits a) (sb-kernel:double-float-low-bits b))))))
(defun signal-error-p (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))
(defun expected-status (actual expected)
  (assert (eq expected actual) () "Expected factor status ~S, got ~S." expected actual)
  actual)

(defun allocation-check (label thunk &optional (repeats 10000))
  "Measure steady state after fixed warmup; report startup allocation separately."
  (sb-ext:gc :full t)
  (let ((before-warmup (sb-ext:get-bytes-consed)))
    (dotimes (i 10000) (funcall thunk))
    (let* ((after-warmup (sb-ext:get-bytes-consed))
           (warmup-bytes (- after-warmup before-warmup)))
      (dotimes (i repeats) (funcall thunk))
      (let ((bytes (- (sb-ext:get-bytes-consed) after-warmup)))
        (format t "API-ALLOCATION ~A warmup-calls=10000 warmup-bytes=~D calls=~D bytes=~D~%"
                label warmup-bytes repeats bytes)
        (assert (zerop bytes) () "~A allocated ~D bytes across ~D calls." label bytes repeats)))))

(defvar *allocation-control* nil)

(defun allocation-control-test ()
  (let ((caught nil))
    (handler-case
        (allocation-check "planted-cons"
                          (lambda () (setf *allocation-control* (cons 1 2))))
      (simple-error (condition)
        (unless (search "allocated" (princ-to-string condition)) (error condition))
        (setf caught t)))
    (assert caught () "The allocation check accepted an allocating control.")
    (format t "ALLOCATION-CONTROL-RED-PASS~%")))
(defun malformed-pattern-tests ()
  (flet ((bad (n pointers rows)
           (assert (signal-error-p
                    (lambda ()
                      (coalton-linalg/sparse/spd-ldlt:analyze (coalton-linalg/sparse/spd-ldlt:pattern n pointers rows)))))))
    (bad 2 (indices 0 3) (indices 0 1 1))
    (bad 2 (indices 1 2 3) (indices 0 1 1))
    (bad 2 (indices 0 2 2) (indices 0 1 1))
    (bad 2 (indices 0 0 1) (indices 1))
    (bad 3 (indices 0 3 4 5) (indices 0 2 1 1 2))
    (bad 2 (indices 0 3 4) (indices 0 1 1 1))
    (bad 2 (indices 0 2 3) (indices 0 2 1))
    (bad 2 (indices 0 1 2) (indices 0 0)))
  (format t "API-PATTERN-VALIDATION-PASS~%"))

(defun lifecycle-tests ()
  (let* ((cp (indices 0 3 4 5))
         (ri (indices 0 1 2 1 2))
         (p (coalton-linalg/sparse/spd-ldlt:pattern 3 cp ri))
         (s (coalton-linalg/sparse/spd-ldlt:analyze p))
         (f (coalton-linalg/sparse/spd-ldlt:symbolic-factor s))
         (a (doubles 5d0 1d0 1d0 2d0 2d0))
         (a2 (doubles 7d0 0d0 1d0 3d0 4d0))
         (rhs (doubles 10d0 5d0 7d0))
         (rhs2 (doubles 10d0 6d0 13d0))
         (answer (doubles 1d0 2d0 3d0))
         (out (doubles 42d0 42d0 42d0))
         (bad-values (doubles 1d0))
         (bad-size (doubles 0d0))
         (infinity sb-ext:double-float-positive-infinity)
         (nan (sb-kernel:make-double-float #x7ff80000 0))
         (bad-rhs (doubles 1d0 infinity 2d0))
         (bad-a (doubles 5d0 1d0 1d0 infinity 2d0)))
    (assert (not (coalton-linalg/sparse/spd-ldlt:factor-ready? f)))
    (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveInvalidFactor) (coalton-linalg/sparse/spd-ldlt:solve! f rhs out)))
    (assert (every (lambda (x) (= x 42d0)) out))

    ;; The analysis owns its structure after this return.
    (fill cp 0)
    (fill ri 0)
    (let* ((success (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess)))
           (saved-perm (copy-seq (coalton-linalg/sparse/spd-ldlt:factor-permutation f)))
           (saved-columns (copy-seq (coalton-linalg/sparse/spd-ldlt:factor-columns f)))
           (saved-rows (copy-seq (coalton-linalg/sparse/spd-ldlt:factor-rows f)))
           (saved-diagonal (copy-seq (coalton-linalg/sparse/spd-ldlt:factor-diagonal f)))
           (saved-values (copy-seq (coalton-linalg/sparse/spd-ldlt:factor-values f))))
      (declare (ignore success))
      (assert (eq f (coalton-linalg/sparse/spd-ldlt:symbolic-factor s)))
      (assert (equalp saved-perm (indices 1 0 2)))
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveSuccess) (coalton-linalg/sparse/spd-ldlt:solve! f rhs out)))
      (assert (close-vector-p out answer))
      (let ((again (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a2 0d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess))))
        (declare (ignore again))
        (assert (eq f (coalton-linalg/sparse/spd-ldlt:symbolic-factor s)))
        (assert (equalp saved-perm (coalton-linalg/sparse/spd-ldlt:factor-permutation f)))
        (assert (equalp saved-columns (coalton-linalg/sparse/spd-ldlt:factor-columns f)))
        (assert (equalp saved-rows (coalton-linalg/sparse/spd-ldlt:factor-rows f)))
        (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveSuccess) (coalton-linalg/sparse/spd-ldlt:solve! f rhs2 out)))
        (assert (close-vector-p out answer)))

      ;; A failure invalidates every borrowed handle to the reused factor.
      (let ((failure (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a 2d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorNonPositive))))
        (declare (ignore failure))
        (assert (= 1 (coalton-linalg/sparse/spd-ldlt:refused-column s)))
        (assert (not (coalton-linalg/sparse/spd-ldlt:factor-ready? (coalton-linalg/sparse/spd-ldlt:symbolic-factor s))))
        (fill out 42d0)
        (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveInvalidFactor) (coalton-linalg/sparse/spd-ldlt:solve! f rhs out)))
        (assert (every (lambda (x) (= x 42d0)) out)))
      (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess))
      (assert (same-bits-p saved-diagonal (coalton-linalg/sparse/spd-ldlt:factor-diagonal f)))
      (assert (same-bits-p saved-values (coalton-linalg/sparse/spd-ldlt:factor-values f)))

      (flet ((invalidates (values shift status)
               (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess))
               (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s values shift) status)
               (assert (not (coalton-linalg/sparse/spd-ldlt:factor-ready? f)))
               (fill out 42d0)
               (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveInvalidFactor) (coalton-linalg/sparse/spd-ldlt:solve! f rhs out)))
               (assert (every (lambda (x) (= x 42d0)) out))))
        (invalidates bad-values 0d0 (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorBadValues))
        (invalidates a infinity (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorBadShift))
        (invalidates a nan (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorBadShift))
        (invalidates bad-a 0d0 (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorNonFinite))
        (setf (aref bad-a 3) nan)
        (invalidates bad-a 0d0 (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorNonFinite))
        (setf (aref bad-a 3) infinity))

      (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess))
      (fill out 42d0)
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveBadSize) (coalton-linalg/sparse/spd-ldlt:solve! f bad-size out)))
      (assert (every (lambda (x) (= x 42d0)) out))
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveBadSize) (coalton-linalg/sparse/spd-ldlt:solve! f rhs bad-size)))
      (assert (= (aref bad-size 0) 0d0))
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveNonFiniteRhs) (coalton-linalg/sparse/spd-ldlt:solve! f bad-rhs out)))
      (assert (every (lambda (x) (= x 42d0)) out))
      (setf (aref bad-rhs 1) nan)
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveNonFiniteRhs) (coalton-linalg/sparse/spd-ldlt:solve! f bad-rhs out)))
      (assert (every (lambda (x) (= x 42d0)) out))
      (setf (aref bad-rhs 1) infinity)

      ;; b/out may alias; output aliasing factor-owned arrays is outside the API contract.
      (let ((aliased (copy-seq rhs)))
        (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveSuccess) (coalton-linalg/sparse/spd-ldlt:solve! f aliased aliased)))
        (assert (close-vector-p aliased answer)))
      (allocation-check "factor-success" (lambda () (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0)))
      (allocation-check "solve-success" (lambda () (coalton-linalg/sparse/spd-ldlt:solve! f rhs out)))
      (allocation-check "solve-bad-size" (lambda () (coalton-linalg/sparse/spd-ldlt:solve! f bad-size out)))
      (allocation-check "solve-nonfinite-rhs" (lambda () (coalton-linalg/sparse/spd-ldlt:solve! f bad-rhs out)))
      (allocation-check "factor-nonpositive" (lambda () (coalton-linalg/sparse/spd-ldlt:factor! s a 2d0)))
      (allocation-check "solve-invalid-factor" (lambda () (coalton-linalg/sparse/spd-ldlt:solve! f rhs out)))
      (allocation-check "factor-bad-values" (lambda () (coalton-linalg/sparse/spd-ldlt:factor! s bad-values 0d0)))
      (allocation-check "factor-bad-shift" (lambda () (coalton-linalg/sparse/spd-ldlt:factor! s a infinity)))
      (allocation-check "factor-nonfinite-input" (lambda () (coalton-linalg/sparse/spd-ldlt:factor! s bad-a 0d0)))
      (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess))
      (assert (same-bits-p saved-diagonal (coalton-linalg/sparse/spd-ldlt:factor-diagonal f)))
      (assert (same-bits-p saved-values (coalton-linalg/sparse/spd-ldlt:factor-values f)))
      (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveSuccess) (coalton-linalg/sparse/spd-ldlt:solve! f rhs out)))
      (assert (close-vector-p out answer))))
  (format t "API-LIFECYCLE-PASS~%"))

(defun arithmetic-tests ()
  (let ((traps (getf (sb-int:get-floating-point-modes) :traps)))
    (format t "API-AMBIENT-FLOAT-TRAPS ~S~%" traps)
    (dolist (kind '(:overflow :invalid :divide-by-zero))
      (assert (not (member kind traps)) ()
              "This test expects the pinned Coalton setup's disabled ~A trap." kind)))
  (let* ((s (coalton-linalg/sparse/spd-ldlt:analyze (coalton-linalg/sparse/spd-ldlt:pattern 1 (indices 0 1) (indices 0))))
         (a (doubles 1d-300))
         (f (coalton-linalg/sparse/spd-ldlt:symbolic-factor s))
         (huge (doubles 1d100))
         (ordinary (doubles 1d0))
         (out (doubles 42d0)))
    (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorSuccess))
    (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveNonFiniteResult) (coalton-linalg/sparse/spd-ldlt:solve! f huge out)))
    (assert (= (aref out 0) 42d0))
    (allocation-check "solve-nonfinite-result" (lambda () (coalton-linalg/sparse/spd-ldlt:solve! f huge out)))
    (assert (= (aref out 0) 42d0))
    (assert (eq (coalton:coalton coalton-linalg/sparse/spd-ldlt:SolveSuccess) (coalton-linalg/sparse/spd-ldlt:solve! f ordinary out)))
    (assert (< (abs (- (/ (aref out 0) 1d300) 1d0)) 1d-14)))
  (let* ((s (coalton-linalg/sparse/spd-ldlt:analyze
              (coalton-linalg/sparse/spd-ldlt:pattern 2 (indices 0 2 3) (indices 0 1 1))))
         (a (doubles 1d-300 1d300 1d300)))
    (expected-status (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0) (coalton:coalton coalton-linalg/sparse/spd-ldlt:FactorNonFinite))
    (assert (not (coalton-linalg/sparse/spd-ldlt:factor-ready? (coalton-linalg/sparse/spd-ldlt:symbolic-factor s))))
    (allocation-check "factor-nonfinite-result" (lambda () (coalton-linalg/sparse/spd-ldlt:factor! s a 0d0))))
  (format t "API-ARITHMETIC-PASS~%"))


(defun latest-diagnostic-tests ()
  "Check each latest-column transition, original numbering, and independent workspaces."
  (let* ((a (ldlt:analyze (ldlt:Pattern 3 (indices 0 3 4 5) (indices 0 1 2 1 2))))
         (b (ldlt:analyze (ldlt:Pattern 4 (indices 0 1 2 3 4) (indices 0 1 2 3))))
         (good-a (doubles 5d0 1d0 1d0 2d0 2d0))
         (bad-a (doubles 5d0 1d0 1d0 2d0 sb-ext:double-float-positive-infinity))
         (bad-b (doubles 2d0 3d0 -1d0 5d0))
         (good-b (doubles 2d0 3d0 4d0 5d0))
         (out (doubles 42d0 42d0 42d0)))
    (flet ((columns (expected-a expected-b)
             (assert (= expected-a (ldlt:refused-column a)))
             (assert (= expected-b (ldlt:refused-column b))))
           (refuse-a ()
             (expected-status (ldlt:factor! a good-a 2d0) (coalton:coalton ldlt:FactorNonPositive))))
      (columns -1 -1)
      (refuse-a)
      (columns 1 -1)
      (assert (eq (coalton:coalton ldlt:SolveInvalidFactor)
                  (ldlt:solve! (ldlt:symbolic-factor a) (doubles 1d0 2d0 3d0) out)))
      (assert (equalp out (doubles 42d0 42d0 42d0)))
      (columns 1 -1)
      (expected-status (ldlt:factor! b bad-b 0d0) (coalton:coalton ldlt:FactorNonPositive))
      (columns 1 2)
      (expected-status (ldlt:factor! a (doubles) 0d0) (coalton:coalton ldlt:FactorBadValues))
      (columns -1 2)
      (expected-status (ldlt:factor! a bad-a 0d0) (coalton:coalton ldlt:FactorNonFinite))
      (columns 2 2)
      (expected-status (ldlt:factor! a good-a sb-ext:double-float-positive-infinity)
                       (coalton:coalton ldlt:FactorBadShift))
      (columns -1 2)
      (refuse-a)
      (columns 1 2)
      (expected-status (ldlt:factor! a good-a (sb-kernel:make-double-float #x7ff80000 0))
                       (coalton:coalton ldlt:FactorBadShift))
      (columns -1 2)
      (expected-status (ldlt:factor! a bad-a 0d0) (coalton:coalton ldlt:FactorNonFinite))
      (columns 2 2)
      (expected-status (ldlt:factor! a good-a 0d0) (coalton:coalton ldlt:FactorSuccess))
      (columns -1 2)
      (expected-status (ldlt:factor! b good-b 0d0) (coalton:coalton ldlt:FactorSuccess))
      (columns -1 -1)))
  (let ((empty (ldlt:analyze (ldlt:Pattern 0 (indices 0) (indices)))))
    (assert (= -1 (ldlt:refused-column empty)))
    (expected-status (ldlt:factor! empty (doubles 1d0) 0d0) (coalton:coalton ldlt:FactorBadValues))
    (assert (= -1 (ldlt:refused-column empty)))
    (expected-status (ldlt:factor! empty (doubles) sb-ext:double-float-positive-infinity)
                     (coalton:coalton ldlt:FactorBadShift))
    (assert (= -1 (ldlt:refused-column empty)))
    (expected-status (ldlt:factor! empty (doubles) 0d0) (coalton:coalton ldlt:FactorSuccess))
    (assert (= -1 (ldlt:refused-column empty))))
  (format t "LATEST-DIAGNOSTIC-PASS workspaces=2 empty=1~%"))

(defun run-interface-tests ()
  "Independently exercise API contracts through the public interface; no external packages."
  (malformed-pattern-tests)
  (lifecycle-tests)
  (arithmetic-tests)
  (latest-diagnostic-tests)
  (format t "API-REVIEW-PASS~%"))
