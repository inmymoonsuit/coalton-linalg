(cl:defpackage #:coalton-linalg/examples/augmented-minimum-norm
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray)
                    (#:csc #:coalton-linalg/sparse/csc)
                    (#:aug #:coalton-linalg/sparse/augmented)
                    (#:ldlt #:coalton-linalg/sparse/spd-ldlt))
  (:export #:sparse-shortest-solution))
(cl:in-package #:coalton-linalg/examples/augmented-minimum-norm)

(coalton-toplevel
  (declare sparse-shortest-solution (Void -> arr:LispArray F64))
  (define (sparse-shortest-solution)
    "The shortest x with x0 + x1 = 2 and x2 + x3 = 4, through the sparse augmented system; return about [1,1,2,2].

The 2-by-4 matrix A is never multiplied by its transpose. [[I, A^T], [A, -bottom I]] is laid
out once, analysed once with each row held until one of its columns is eliminated, and then
refilled, factored with signed pivots and solved. The answer is A^T (A A^T + bottom I)^-1 b,
within bottom / 2 of the minimum-norm solution here."
    (let rows = (arr:make 4 (the UFix 0)))
    (let columns = (arr:make 4 (the UFix 0)))
    (for ((q 0 (+ q 1))) :while (< q 4)
      (arr:set! columns q q))
    (arr:set! rows 2 1)
    (arr:set! rows 3 1)
    (let a = (csc:from-coo 2 4 rows columns (arr:make 4 1.0d0) csc:RejectDuplicates))
    ;; The pattern work happens once.
    (let plan = (aug:analyze a))
    (let symbolic = (ldlt:analyze-quasidefinite
                     (ldlt:Pattern (aug:dimension plan) (aug:column-pointers plan) (aug:row-indices plan))
                     (aug:leading-dimension plan)))
    ;; For each set of values: refill, factor, read the growth and the counts, solve.
    (let values = (arr:make (aug:entry-count plan) 0.0d0))
    (aug:refill-csc! plan a 1.0d0 1.0d-12 values)
    (unless (== (ldlt:factor-signed! symbolic values 0.0d0) ldlt:SignedSuccess)
      (lisp (-> Void) () (cl:error "Example factorization refused.")))
    (let factor = (ldlt:symbolic-factor symbolic))
    (unless (and (== (ldlt:positive-pivot-count factor) 4) (== (ldlt:negative-pivot-count factor) 2))
      (lisp (-> Void) () (cl:error "Example pivot counts are not four and two.")))
    ;; No order fixed in advance is accurate on every matrix. Growth bounds what this
    ;; factorization lost: at a million, six of sixteen digits. Larger, take another route.
    (unless (< (ldlt:factor-growth factor) 1.0d6)
      (lisp (-> Void) () (cl:error "Example growth is too large to use the factor.")))
    (let rhs = (arr:make 6 0.0d0))
    (arr:set! rhs 4 2.0d0)
    (arr:set! rhs 5 4.0d0)
    (let solution = (arr:make 6 0.0d0))
    (unless (== (ldlt:solve! factor rhs solution) ldlt:SolveSuccess)
      (lisp (-> Void) () (cl:error "Example solve refused.")))
    (let x = (arr:make 4 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i 4)
      (arr:set! x i (arr:aref solution i)))
    x))
