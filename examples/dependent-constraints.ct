(cl:defpackage #:coalton-linalg/examples/dependent-constraints
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray)
                    (#:og #:coalton-linalg/dense/orthogonal))
  (:export #:shortest-solution))
(cl:in-package #:coalton-linalg/examples/dependent-constraints)

(coalton-toplevel
  (declare shortest-solution (Void -> arr:LispArray F64))
  (define (shortest-solution)
    "The shortest x with x0 + x1 = 2, x2 + x3 = 4 and the first equation stated twice; return [1,1,2,2].

The repeated row makes the 3-by-4 matrix rank 2. The caller picks the rank from the diagonal
of R with its own threshold, here a relative 1e-9, and the solve returns the minimum-norm
least-squares solution for that rank."
    (let m = 3)
    (let n = 4)
    ;; Column-major: entry (i,j) is at i + j m.
    (let a = (arr:make (* m n) 0.0d0))
    (arr:set! a (+ 0 (* 0 m)) 1.0d0)
    (arr:set! a (+ 0 (* 1 m)) 1.0d0)
    (arr:set! a (+ 1 (* 2 m)) 1.0d0)
    (arr:set! a (+ 1 (* 3 m)) 1.0d0)
    (arr:set! a (+ 2 (* 0 m)) 1.0d0)
    (arr:set! a (+ 2 (* 1 m)) 1.0d0)
    (let decomposition = (og:make-decomposition m n))
    (unless (== (og:factor! decomposition a) og:FactorSuccess)
      (lisp (-> Void) () (cl:error "Example factorization refused.")))
    (let rank = (og:rank-above decomposition (* 1.0d-9 (og:pivot-magnitude decomposition 0))))
    (unless (== rank 2)
      (lisp (-> Void) () (cl:error "Example rank is not two.")))
    (unless (== (og:set-rank! decomposition rank) og:RankSuccess)
      (lisp (-> Void) () (cl:error "Example rank refused.")))
    (let b = (arr:make m 2.0d0))
    (arr:set! b 1 4.0d0)
    (let x = (arr:make n 0.0d0))
    (unless (== (og:solve! decomposition b x) og:SolveSuccess)
      (lisp (-> Void) () (cl:error "Example solve refused.")))
    x))
