(cl:defpackage #:coalton-linalg/examples/kept-rows
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray)
                    (#:csc #:coalton-linalg/sparse/csc)
                    (#:rd #:coalton-linalg/sparse/rank-deficient))
  (:export #:kept-of-three #:kept-bounds #:kept-refreshed #:kept-sets))
(cl:in-package #:coalton-linalg/examples/kept-rows)

(coalton-toplevel
  (declare constraints (F64 -> csc:Matrix))
  (define (constraints corner)
    "Three constraints on four unknowns. With a corner of 1 the third is the sum of the first two.

    x0 + x1                    = ...
                    x2 + x3    = ...
    corner x0 + x1 + x2 + x3   = ..."
    (let rows = (arr:make 8 (the UFix 0)))
    (let columns = (arr:make 8 (the UFix 0)))
    (let values = (arr:make 8 1.0d0))
    ;; (row, column) of each entry: row 0 holds columns 0 and 1, row 1 columns 2 and 3, row 2 all four.
    (arr:set! rows 0 0) (arr:set! columns 0 0)
    (arr:set! rows 1 0) (arr:set! columns 1 1)
    (arr:set! rows 2 1) (arr:set! columns 2 2)
    (arr:set! rows 3 1) (arr:set! columns 3 3)
    (arr:set! rows 4 2) (arr:set! columns 4 0)
    (arr:set! rows 5 2) (arr:set! columns 5 1)
    (arr:set! rows 6 2) (arr:set! columns 6 2)
    (arr:set! rows 7 2) (arr:set! columns 7 3)
    (arr:set! values 4 corner)
    (csc:from-coo 3 4 rows columns values csc:RejectDuplicates))

  (declare weighted (F64 -> csc:Matrix))
  (define (weighted weight)
    "The same three constraints with the third multiplied by a weight: still the sum of the first two, each taken that many times."
    (let rows = (arr:make 8 (the UFix 0)))
    (let columns = (arr:make 8 (the UFix 0)))
    (let values = (arr:make 8 1.0d0))
    (arr:set! rows 0 0) (arr:set! columns 0 0)
    (arr:set! rows 1 0) (arr:set! columns 1 1)
    (arr:set! rows 2 1) (arr:set! columns 2 2)
    (arr:set! rows 3 1) (arr:set! columns 3 3)
    (arr:set! rows 4 2) (arr:set! columns 4 0)
    (arr:set! rows 5 2) (arr:set! columns 5 1)
    (arr:set! rows 6 2) (arr:set! columns 6 2)
    (arr:set! rows 7 2) (arr:set! columns 7 3)
    (arr:set! values 4 weight)
    (arr:set! values 5 weight)
    (arr:set! values 6 weight)
    (arr:set! values 7 weight)
    (csc:from-coo 3 4 rows columns values csc:RejectDuplicates))

  (declare kept-of-three (Void -> UFix))
  (define (kept-of-three)
    "How many of the three constraints are kept, the third being implied by them: 2."
    (let matrix = (constraints 1.0d0))
    (let kept = (rd:analyze matrix))
    (unless (== (rd:find-kept-rows! kept matrix 1.0d-6 1.0d-12) rd:FindFound)
      (return 99))
    (rd:kept-count kept))

  (declare kept-bounds (Void -> arr:LispArray F64))
  (define (kept-bounds)
    "One kept set serving two matrices. Returns four numbers, or an empty vector if a call refused where it should not:

    [0] the gap bound for the matrix searched: rounding level, since the third row is the sum of the others;
    [1] what the certificate at a floor of 1e-6 proved of the kept rows: at least 1e-6, here an eighth;
    [2] the gap bound proved again for the matrix whose corner is 1.001: the vector kept is no longer
        the row's combination, by exactly 0.001 in one column, and the bound says so;
    [3] what stands after the certificate at 1e-6 is asked of that matrix: -1, refused on the gap.

The search and its vector are made once. The second matrix costs a pass over the rows the
vector touches and no search; the refusal is the signal that this kept set is out of date
for these values, and a caller that gets it searches again."
    (let matrix = (constraints 1.0d0))
    (let kept = (rd:analyze matrix))
    (let out = (arr:make 4 0.0d0))
    (unless (== (rd:find-kept-rows! kept matrix 1.0d-6 1.0d-12) rd:FindFound)
      (return (arr:make 0 0.0d0)))
    (arr:set! out 0 (rd:gap-bound kept))
    (unless (== (rd:certify! kept 1.0d-6 1.0d-6) rd:Certified)
      (return (arr:make 0 0.0d0)))
    (arr:set! out 1 (rd:proved-lower-bound kept))
    (unless (== (rd:reprove! kept (constraints 1.001d0)) rd:Reproved)
      (return (arr:make 0 0.0d0)))
    (arr:set! out 2 (rd:gap-bound kept))
    (unless (== (rd:certify! kept 1.0d-6 1.0d-6) rd:CertificateGapAboveFloor)
      (return (arr:make 0 0.0d0)))
    (arr:set! out 3 (rd:proved-lower-bound kept))
    out)

  (declare kept-refreshed (Void -> arr:LispArray F64))
  (define (kept-refreshed)
    "The kept vector refreshed for a matrix whose third row is taken 1.25 times. Returns three numbers, or an empty vector if a call refused:

    [0] how many vectors the refresh replaced: 1;
    [1] the gap bound afterwards: far under the target of half the floor, for one row is still
        a combination of the other two, with multipliers that are now different, and a vector
        is refined only as far as the target needs;
    [2] what the certificate at a floor of 1e-6 then proved of the kept rows: at least 1e-6.

Without the refresh the kept vector would be wrong for these values by a quarter of a row,
and the certificate would refuse as it does in kept-bounds. A row that had left the span
of the others, as the corner of 1.001 there makes it, could not be refreshed back: its
bound would stay at its distance, and that is the signal to search again.

A refresh needs a certificate to have been issued once for the kept set, which is where it
takes the shift of its solve from; it is given a target of half the floor, so that a vector
is replaced before the certificate would refuse."
    (let matrix = (constraints 1.0d0))
    (let kept = (rd:analyze matrix))
    (let out = (arr:make 3 0.0d0))
    (unless (== (rd:find-kept-rows! kept matrix 1.0d-6 1.0d-12) rd:FindFound)
      (return (arr:make 0 0.0d0)))
    (unless (== (rd:certify! kept 1.0d-6 1.0d-6) rd:Certified)
      (return (arr:make 0 0.0d0)))
    (unless (== (rd:refresh! kept (weighted 1.25d0) 0.5d-6) rd:Refreshed)
      (return (arr:make 0 0.0d0)))
    (arr:set! out 0 (if (== (rd:refreshed-count kept) 1) 1.0d0 0.0d0))
    (arr:set! out 1 (rd:gap-bound kept))
    (unless (== (rd:certify! kept 1.0d-6 1.0d-6) rd:Certified)
      (return (arr:make 0 0.0d0)))
    (arr:set! out 2 (rd:proved-lower-bound kept))
    out)

  (declare kept-sets (Void -> arr:LispArray UFix))
  (define (kept-sets)
    "The label of each of the three constraints' dependent set: [0, 0, 0], one set of all three, since each is made from the other two. An empty vector if a call refused.

A multiplier is classed in its row's dependency when it is above a millionth of the
vector's largest entry by more than a proved bound on its error, and the rows joined
through such multipliers are one set. A constraint that no other is made from, and that
is made from no other, would carry the row count, 3, in place of a label."
    (let matrix = (constraints 1.0d0))
    (let kept = (rd:analyze matrix))
    (unless (== (rd:find-kept-rows! kept matrix 1.0d-6 1.0d-12) rd:FindFound)
      (return (arr:make 0 (the UFix 0))))
    (unless (== (rd:certify! kept 1.0d-6 1.0d-6) rd:Certified)
      (return (arr:make 0 (the UFix 0))))
    (unless (== (rd:class-supports! kept 1.0d-6) rd:SupportsClassed)
      (return (arr:make 0 (the UFix 0))))
    (rd:dependent-sets kept)))
