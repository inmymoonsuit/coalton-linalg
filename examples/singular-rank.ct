(cl:defpackage #:coalton-linalg/examples/singular-rank
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray)
                    (#:jc #:coalton-linalg/dense/jacobi))
  (:export #:constraint-rank))
(cl:in-package #:coalton-linalg/examples/singular-rank)

(coalton-toplevel
  (declare constraint-rank (Void -> UFix))
  (define (constraint-rank)
    "The rank of x0 + x1 = 2, x2 + x3 = 4 and the first equation stated twice, from its singular values; return 2.

The 3-by-4 matrix has singular values 2, sqrt 2, 0 and 0. The caller chooses the threshold;
columns 2 and 3 of the right vectors then span the two-dimensional nullspace."
    (let m = 3)
    (let n = 4)
    ;; Column-major: entry (i,j) is at i + j m.
    (let a = (arr:make (* m n) 0.0d0))
    (arr:set! a (+ 0 (* 0 m)) 1.0d0)
    (arr:set! a (+ 0 (* 1 m)) 1.0d0)
    (arr:set! a (+ 1 (* 2 m)) 1.0d0)
    (arr:set! a (+ 1 (* 3 m)) 1.0d0)
    (arr:set! a (+ 2 (* 0 m)) 1.0d0)
    (arr:set! a (+ 2 (* 1 m)) 1.0d0)
    (let svd = (jc:make-svd m n))
    (unless (== (jc:svd! svd a) jc:JacobiSuccess)
      (lisp (-> Void) () (cl:error "Example decomposition refused.")))
    (jc:rank-above svd (* 1.0d-9 (arr:aref (jc:singular-values svd) 0)))))
