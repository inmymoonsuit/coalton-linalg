(cl:defpackage #:coalton-linalg/examples/minimum-norm
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray)
                    (#:il #:coalton-linalg/dense/indefinite-ldlt))
  (:export #:minimum-norm-solution))
(cl:in-package #:coalton-linalg/examples/minimum-norm)

(coalton-toplevel
  (declare minimum-norm-solution (Void -> arr:LispArray F64))
  (define (minimum-norm-solution)
    "The shortest x with x0 + x1 = 2 and x2 + x3 = 4, by the augmented system; return [1,1,2,2].

With J the 2-by-4 constraint matrix, [[I, J^T], [J, 0]] [x; y] = [0; b] has the minimum-norm
solution of J x = b as its first four unknowns. The matrix is symmetric and indefinite: four
positive and two negative eigenvalues when J has full row rank."
    (let n = 6)
    (let a = (arr:make (* n n) 0.0d0))
    ;; Only the lower triangle is read, column by column: entry (i,j) is at i + j n.
    (for ((i 0 (+ i 1))) :while (< i 4)
      (arr:set! a (+ i (* i n)) 1.0d0))
    (arr:set! a (+ 4 (* 0 n)) 1.0d0)
    (arr:set! a (+ 4 (* 1 n)) 1.0d0)
    (arr:set! a (+ 5 (* 2 n)) 1.0d0)
    (arr:set! a (+ 5 (* 3 n)) 1.0d0)
    (let factor = (il:make-factor n))
    (unless (== (il:factor! factor a 0.0d0) il:FactorSuccess)
      (lisp (-> Void) () (cl:error "Example factorization refused.")))
    ;; The inertia tells full row rank from dependent constraints before any solve.
    (unless (and (== (il:positive-count factor) 4)
                 (== (il:negative-count factor) 2)
                 (== (il:zero-count factor) 0))
      (lisp (-> Void) () (cl:error "Example constraints are not of full row rank.")))
    (let rhs = (arr:make n 0.0d0))
    (arr:set! rhs 4 2.0d0)
    (arr:set! rhs 5 4.0d0)
    (let solution = (arr:make n 0.0d0))
    (unless (== (il:solve! factor rhs solution) il:SolveSuccess)
      (lisp (-> Void) () (cl:error "Example solve refused.")))
    (let x = (arr:make 4 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i 4)
      (arr:set! x i (arr:aref solution i)))
    x))
