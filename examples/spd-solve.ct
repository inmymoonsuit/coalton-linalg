(cl:defpackage #:coalton-linalg/examples
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:ldlt #:coalton-linalg/sparse/spd-ldlt)
                    (#:arr #:coalton/lisparray))
  (:export #:solve-2x2))
(cl:in-package #:coalton-linalg/examples)

(coalton-toplevel
  (declare solve-2x2 (Void -> arr:LispArray F64))
  (define (solve-2x2)
    "Solve [[4,2],[2,3]] x = [8,8]; return [1,2]."
    (let columns = (arr:make 3 (the UFix 0)))
    (arr:set! columns 1 2)
    (arr:set! columns 2 3)
    (let rows = (arr:make 3 (the UFix 1)))
    (arr:set! rows 0 0)
    (let values = (arr:make 3 0.0d0))
    (arr:set! values 0 4.0d0)
    (arr:set! values 1 2.0d0)
    (arr:set! values 2 3.0d0)
    (let symbolic = (ldlt:analyze (ldlt:Pattern 2 columns rows)))
    (let result = (ldlt:factor! symbolic values 0.0d0))
    (unless (== result ldlt:FactorSuccess)
      (lisp (-> Void) () (cl:error "Example factorization refused.")))
    (let rhs = (arr:make 2 8.0d0))
    (let solution = (arr:make 2 0.0d0))
    (unless (== (ldlt:solve! (ldlt:symbolic-factor symbolic) rhs solution) ldlt:SolveSuccess)
      (lisp (-> Void) () (cl:error "Example solve refused.")))
    solution))