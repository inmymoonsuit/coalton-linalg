(cl:defpackage #:coalton-linalg/examples/normal-equations
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray)
                    (#:csc #:coalton-linalg/sparse/csc)
                    (#:gram #:coalton-linalg/sparse/gram)
                    (#:ldlt #:coalton-linalg/sparse/spd-ldlt))
  (:export #:fit-line))
(cl:in-package #:coalton-linalg/examples/normal-equations)

(coalton-toplevel
  (declare fit-line (Void -> arr:LispArray F64))
  (define (fit-line)
    "Fit y = c0 + c1 t through (0,1), (1,3), (2,5) by the normal equations; return [1,2].

The pattern work happens once: the Gram plan and the symbolic analysis. A caller whose
values change keeps both and repeats only refill!, factor! and solve!."
    ;; A has rows [1, t]: three rows, two columns, six stored entries in coordinate form.
    (let rows = (arr:make 6 (the UFix 0)))
    (let columns = (arr:make 6 (the UFix 0)))
    (let entries = (arr:make 6 1.0d0))
    (for ((i 0 (+ i 1))) :while (< i 3)
      (arr:set! rows (* 2 i) i)
      (arr:set! rows (+ (* 2 i) 1) i)
      (arr:set! columns (+ (* 2 i) 1) 1))
    ;; The second column holds t = 0, 1, 2; the stored zero stays part of the pattern.
    (arr:set! entries 1 0.0d0)
    (arr:set! entries 5 2.0d0)
    (let a = (csc:from-coo 3 2 rows columns entries csc:RejectDuplicates))
    (let y = (arr:make 3 1.0d0))
    (arr:set! y 1 3.0d0)
    (arr:set! y 2 5.0d0)
    ;; Once for the pattern: the lower triangle of A^T A, then its factor structure.
    (let plan = (gram:analyze-ata a))
    (let symbolic = (ldlt:analyze (ldlt:Pattern (gram:dimension plan)
                                                (gram:column-pointers plan)
                                                (gram:row-indices plan))))
    (let normal = (arr:make (gram:entry-count plan) 0.0d0))
    ;; For each set of values: refill the product, factor it, solve A^T A c = A^T y.
    (gram:refill-csc! plan a normal)
    (unless (== (ldlt:factor! symbolic normal 0.0d0) ldlt:FactorSuccess)
      (lisp (-> Void) () (cl:error "Example factorization refused.")))
    (let coefficients = (arr:make 2 0.0d0))
    (unless (== (ldlt:solve! (ldlt:symbolic-factor symbolic) (csc:transpose-matvec a y) coefficients)
                ldlt:SolveSuccess)
      (lisp (-> Void) () (cl:error "Example solve refused.")))
    coefficients))
