(cl:defpackage #:coalton-linalg/dense/indefinite-ldlt
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:limits #:coalton-linalg/dense/limits))
  (:import-from #:coalton/math #:finite?)
  (:export #:Factor #:make-factor #:make-factor-with-limit #:maximum-dimension #:default-entry-limit
           #:pivot-threshold #:dimension
           #:FactorStatus #:FactorSuccess #:FactorNonFinite #:FactorBadSize #:FactorBadShift
           #:SolveStatus #:SolveSuccess #:SolveInvalidFactor #:SolveBadSize #:SolveSingular
           #:SolveNonFiniteRhs #:SolveNonFiniteResult
           #:factor! #:solve! #:factor-ready? #:positive-count #:negative-count #:zero-count
           #:factor-permutation #:factor-lower #:factor-diagonal #:factor-subdiagonal #:factor-block-sizes))
(cl:in-package #:coalton-linalg/dense/indefinite-ldlt)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

(coalton-toplevel
  (define-struct FactorStorage
    "Owned dense factor and workspace; overwritten by every factor call."
    (size UFix)
    (lower (arr:LispArray F64))
    (diagonal (arr:LispArray F64))
    (subdiagonal (arr:LispArray F64))
    (blocks (arr:LispArray UFix))
    (permutation (arr:LispArray UFix))
    (scratch (arr:LispArray F64))
    (choice (arr:LispArray UFix))
    (state (arr:LispArray UFix)))

  (repr :transparent)
  (define-type Factor
    "Reusable dense symmetric indefinite factor; construction and workspace fields are private."
    (MkFactor FactorStorage))

  (inline)
  (declare storage (Factor -> FactorStorage))
  (define (storage factor) (match factor ((MkFactor held) held)))

  (derive Eq)
  (repr :enum)
  (define-type FactorStatus
    "Outcome of a factorization call. An exactly zero pivot is FactorSuccess with a nonzero zero-count."
    FactorSuccess
    "A factor stands; an exactly zero pivot is counted, not refused."
    FactorNonFinite
    "A value or an intermediate result was not finite."
    FactorBadSize
    "The matrix array's length differs from the square of the order."
    FactorBadShift
    "The shift was not finite.")

  (derive Eq)
  (repr :enum)
  (define-type SolveStatus
    "Outcome of a solve call; distinct from factorization outcomes."
    SolveSuccess
    "The output holds the solution."
    SolveInvalidFactor
    "No factor stands."
    SolveBadSize
    "A vector's length differs from the order."
    SolveSingular
    "The factor holds an exactly zero pivot; no solve is attempted."
    SolveNonFiniteRhs
    "The right-hand side holds a non-finite entry."
    SolveNonFiniteResult
    "The computed solution was not finite.")

  (declare maximum-dimension UFix)
  (define maximum-dimension
    "Largest order a factor can be made for."
    limits:maximum-dimension)

  (declare pivot-threshold F64)
  (define pivot-threshold
    "(1 + sqrt 17) / 8: the value at which two 1-by-1 steps and one 2-by-2 step have the same growth bound."
    0.6403882032022076d0)

  (declare default-entry-limit UFix)
  (define default-entry-limit
    "Default budget of the n^2 entries a factor stores."
    limits:default-entry-limit)

  (declare make-factor-with-limit (UFix * UFix -> Factor))
  (define (make-factor-with-limit n maximum-entries)
    "Allocate reusable storage for n-by-n factorizations when n * n is within the entry budget."
    (limits:check-storage! n n maximum-entries)
    (MkFactor (FactorStorage n (arr:make (* n n) 0.0d0) (arr:make n 0.0d0) (arr:make n 0.0d0)
                             (arr:make n (the UFix 0)) (arr:make n (the UFix 0)) (arr:make n 0.0d0)
                             (arr:make 3 (the UFix 0)) (arr:make 4 (the UFix 0)))))

  (declare make-factor (UFix -> Factor))
  (define (make-factor n)
    "Allocate reusable storage under default-entry-limit. Nothing is ready until factor! succeeds."
    (make-factor-with-limit n default-entry-limit))

  (declare dimension (Factor -> UFix))
  (define (dimension factor)
    "The order this factor was made for."
    (.size (storage factor)))
  (declare factor-ready? (Factor -> Boolean))
  (define (factor-ready? factor)
    "Whether a factor stands: the latest factor! on this handle succeeded."
    (== (arr:aref (.state (storage factor)) 0) 1))
  (declare positive-count (Factor -> UFix))
  (define (positive-count factor)
    "Positive eigenvalues of the computed block diagonal; 0 when no factor stands."
    (arr:aref (.state (storage factor)) 1))
  (declare negative-count (Factor -> UFix))
  (define (negative-count factor)
    "Negative eigenvalues of the computed block diagonal; 0 when no factor stands."
    (arr:aref (.state (storage factor)) 2))
  (declare zero-count (Factor -> UFix))
  (define (zero-count factor)
    "Exactly zero pivots of the computed block diagonal; 0 when no factor stands."
    (arr:aref (.state (storage factor)) 3))
  (declare factor-permutation (Factor -> arr:LispArray UFix))
  (define (factor-permutation factor)
    "Borrowed view: the original index at each position of the factored order."
    (.permutation (storage factor)))
  (declare factor-lower (Factor -> arr:LispArray F64))
  (define (factor-lower factor)
    "Borrowed view: the unit lower triangular factor, column-major, n^2 entries."
    (.lower (storage factor)))
  (declare factor-diagonal (Factor -> arr:LispArray F64))
  (define (factor-diagonal factor)
    "Borrowed view: the diagonal of the block diagonal factor."
    (.diagonal (storage factor)))
  (declare factor-subdiagonal (Factor -> arr:LispArray F64))
  (define (factor-subdiagonal factor)
    "Borrowed view: the subdiagonal of the block diagonal factor, nonzero only inside a 2-by-2 block."
    (.subdiagonal (storage factor)))
  (declare factor-block-sizes (Factor -> arr:LispArray UFix))
  (define (factor-block-sizes factor)
    "Borrowed view: at each block's first position its size, 1 or 2, and 0 at a block's second position."
    (.blocks (storage factor)))

  (declare column-argmax (arr:LispArray F64 * UFix * UFix * UFix -> UFix))
  (define (column-argmax w n k c)
    "Row of the largest off-diagonal magnitude in column c of the symmetric trailing block [k,n); c when there is none."
    (let best = (cell:new -1.0d0))
    (let at = (cell:new c))
    ;; Entries above the diagonal of column c are held in row c of the lower triangle.
    (for ((j k (+ j 1))) :while (< j c)
      (let v = (abs (arr:aref w (+ c (* j n)))))
      (when (> v (cell:read best))
        (cell:write! best v)
        (cell:write! at j)))
    (for ((i (+ c 1) (+ i 1))) :while (< i n)
      (let v = (abs (arr:aref w (+ i (* c n)))))
      (when (> v (cell:read best))
        (cell:write! best v)
        (cell:write! at i)))
    (cell:read at))

  (declare off-magnitude (arr:LispArray F64 * UFix * UFix * UFix -> F64))
  (define (off-magnitude w n r c)
    "Magnitude of the symmetric entry (r,c); zero when r is c, the answer column-argmax gives for no entry."
    (cond
      ((== r c) 0.0d0)
      ((> r c) (abs (arr:aref w (+ r (* c n)))))
      (True (abs (arr:aref w (+ c (* r n)))))))

  (declare select-pivot! (arr:LispArray F64 * UFix * UFix * arr:LispArray UFix -> Void))
  (define (select-pivot! w n k choice)
    "Write the pivot for step k into choice: block size, then one or two trailing indices. See docs/indefinite-ldlt.md."
    (arr:set! choice 0 1)
    (arr:set! choice 1 k)
    (arr:set! choice 2 k)
    (let i = (cell:new k))
    (let r = (cell:new (column-argmax w n k k)))
    (let omega = (cell:new (off-magnitude w n (cell:read r) k)))
    (let searching = (cell:new True))
    ;; Each round moves to a column whose largest off-diagonal entry is strictly larger, so no
    ;; column is visited twice and the bound on rounds is never the reason the search ends.
    (for ((round 0 (+ round 1))) :while (and (cell:read searching) (<= round n))
      (let here = (cell:read i))
      (let diagonal = (abs (arr:aref w (+ here (* here n)))))
      (cond
        ((or (== (cell:read omega) 0.0d0)
             (>= diagonal (* pivot-threshold (cell:read omega))))
         (cell:write! searching False)
         (arr:set! choice 1 here))
        (True
         (let c = (cell:read r))
         (let next = (column-argmax w n k c))
         (let omega-c = (off-magnitude w n next c))
         (let diagonal-c = (abs (arr:aref w (+ c (* c n)))))
         (cond
           ((>= diagonal-c (* pivot-threshold omega-c))
            (cell:write! searching False)
            (arr:set! choice 1 c))
           ((== omega-c (cell:read omega))
            ;; The entry (here, c) is the largest off-diagonal of both its columns.
            (cell:write! searching False)
            (arr:set! choice 0 2)
            (arr:set! choice 1 here)
            (arr:set! choice 2 c))
           (True
            (cell:write! i c)
            (cell:write! r next)
            (cell:write! omega omega-c)
            (arr:set! choice 1 c)))))))

  (declare swap-symmetric! (arr:LispArray F64 * arr:LispArray UFix * UFix * UFix * UFix -> Void))
  (define (swap-symmetric! w permutation n p q)
    "Exchange indices p < q of the symmetric matrix held in the lower triangle, with rows p and q of every earlier column."
    (let held = (arr:aref permutation p))
    (arr:set! permutation p (arr:aref permutation q))
    (arr:set! permutation q held)
    (for ((j 0 (+ j 1))) :while (< j p)
      (let a = (arr:aref w (+ p (* j n))))
      (arr:set! w (+ p (* j n)) (arr:aref w (+ q (* j n))))
      (arr:set! w (+ q (* j n)) a))
    (let d = (arr:aref w (+ p (* p n))))
    (arr:set! w (+ p (* p n)) (arr:aref w (+ q (* q n))))
    (arr:set! w (+ q (* q n)) d)
    ;; Between the two: entry (m,p) of the lower triangle is entry (q,m) after the exchange.
    (for ((m (+ p 1) (+ m 1))) :while (< m q)
      (let a = (arr:aref w (+ m (* p n))))
      (arr:set! w (+ m (* p n)) (arr:aref w (+ q (* m n))))
      (arr:set! w (+ q (* m n)) a))
    (for ((m (+ q 1) (+ m 1))) :while (< m n)
      (let a = (arr:aref w (+ m (* p n))))
      (arr:set! w (+ m (* p n)) (arr:aref w (+ m (* q n))))
      (arr:set! w (+ m (* q n)) a)))

  (declare eliminate-one! (FactorStorage * UFix -> Boolean))
  (define (eliminate-one! f k)
    "Eliminate a 1-by-1 pivot at k. False when a result is not finite."
    (let n = (.size f))
    (let w = (.lower f))
    (let st = (.state f))
    (let d = (arr:aref w (+ k (* k n))))
    (unless (inline (finite? d)) (return False))
    (cond
      ((== d 0.0d0)
       ;; The selection rule takes a zero pivot only from a column that is entirely zero,
       ;; so its multipliers are zero already and nothing is eliminated.
       (arr:set! st 3 (+ (arr:aref st 3) 1)))
      (True
       (cond
         ((> d 0.0d0) (arr:set! st 1 (+ (arr:aref st 1) 1)))
         (True (arr:set! st 2 (+ (arr:aref st 2) 1))))
       (for ((j (+ k 1) (+ j 1))) :while (< j n)
         (let multiplier = (/ (arr:aref w (+ j (* k n))) d))
         (for ((i j (+ i 1))) :while (< i n)
           (arr:set! w (+ i (* j n))
                     (- (arr:aref w (+ i (* j n))) (* (arr:aref w (+ i (* k n))) multiplier)))))
       (for ((i (+ k 1) (+ i 1))) :while (< i n)
         (let multiplier = (/ (arr:aref w (+ i (* k n))) d))
         (unless (inline (finite? multiplier)) (return False))
         (arr:set! w (+ i (* k n)) multiplier))))
    (arr:set! (.diagonal f) k d)
    (arr:set! (.subdiagonal f) k 0.0d0)
    (arr:set! (.blocks f) k 1)
    (arr:set! w (+ k (* k n)) 1.0d0)
    True)

  (declare eliminate-two! (FactorStorage * UFix -> Boolean))
  (define (eliminate-two! f k)
    "Eliminate a 2-by-2 pivot at k and k+1. False when a result is not finite."
    (let n = (.size f))
    (let w = (.lower f))
    (let st = (.state f))
    (let a = (arr:aref w (+ k (* k n))))
    (let b = (arr:aref w (+ (+ k 1) (* k n))))
    (let c = (arr:aref w (+ (+ k 1) (* (+ k 1) n))))
    (unless (and (inline (finite? a)) (and (inline (finite? b)) (inline (finite? c)))) (return False))
    ;; Work with the block divided by b. Its determinant a/b * c/b - 1 lies strictly between
    ;; -(1 + threshold^2) and -(1 - threshold^2), where b * b could overflow or underflow.
    (let ar = (/ a b))
    (let cr = (/ c b))
    (let scale = (* b (- (* ar cr) 1.0d0)))
    (for ((j (+ k 2) (+ j 1))) :while (< j n)
      (let u = (arr:aref w (+ j (* k n))))
      (let v = (arr:aref w (+ j (* (+ k 1) n))))
      (let p = (/ (- (* cr u) v) scale))
      (let q = (/ (- (* ar v) u) scale))
      (for ((i j (+ i 1))) :while (< i n)
        (arr:set! w (+ i (* j n))
                  (- (arr:aref w (+ i (* j n)))
                     (+ (* (arr:aref w (+ i (* k n))) p)
                        (* (arr:aref w (+ i (* (+ k 1) n))) q))))))
    (for ((i (+ k 2) (+ i 1))) :while (< i n)
      (let u = (arr:aref w (+ i (* k n))))
      (let v = (arr:aref w (+ i (* (+ k 1) n))))
      (let p = (/ (- (* cr u) v) scale))
      (let q = (/ (- (* ar v) u) scale))
      (unless (and (inline (finite? p)) (inline (finite? q))) (return False))
      (arr:set! w (+ i (* k n)) p)
      (arr:set! w (+ i (* (+ k 1) n)) q))
    ;; Both diagonal entries are below threshold * |b| in magnitude, so the determinant is negative:
    ;; the block has one positive and one negative eigenvalue whatever the signs on its diagonal.
    (arr:set! st 1 (+ (arr:aref st 1) 1))
    (arr:set! st 2 (+ (arr:aref st 2) 1))
    (arr:set! (.diagonal f) k a)
    (arr:set! (.diagonal f) (+ k 1) c)
    (arr:set! (.subdiagonal f) k b)
    (arr:set! (.subdiagonal f) (+ k 1) 0.0d0)
    (arr:set! (.blocks f) k 2)
    (arr:set! (.blocks f) (+ k 1) 0)
    (arr:set! w (+ k (* k n)) 1.0d0)
    (arr:set! w (+ (+ k 1) (* k n)) 0.0d0)
    (arr:set! w (+ (+ k 1) (* (+ k 1) n)) 1.0d0)
    True)

  (declare refuse! (FactorStorage -> FactorStatus))
  (define (refuse! f)
    (let st = (.state f))
    (arr:set! st 0 0)
    (arr:set! st 1 0)
    (arr:set! st 2 0)
    (arr:set! st 3 0)
    FactorNonFinite)

  (declare factor! (Factor * arr:LispArray F64 * F64 -> FactorStatus))
  (define (factor! factor a shift)
    "Factor P (A - shift I) P^T = L D L^T from the lower triangle of column-major a. A refusal invalidates the factor."
    (let f = (storage factor))
    (let n = (.size f))
    (let st = (.state f))
    (arr:set! st 0 0)
    (arr:set! st 1 0)
    (arr:set! st 2 0)
    (arr:set! st 3 0)
    (unless (== (arr:length a) (* n n)) (return FactorBadSize))
    (unless (inline (finite? shift)) (return FactorBadShift))
    (let w = (.lower f))
    (let permutation = (.permutation f))
    (for ((j 0 (+ j 1))) :while (< j n)
      (arr:set! permutation j j)
      (for ((i 0 (+ i 1))) :while (< i j)
        (arr:set! w (+ i (* j n)) 0.0d0))
      (for ((i j (+ i 1))) :while (< i n)
        (let v = (arr:aref a (+ i (* j n))))
        (unless (inline (finite? v)) (return (refuse! f)))
        (arr:set! w (+ i (* j n)) v))
      (let shifted = (- (arr:aref w (+ j (* j n))) shift))
      (unless (inline (finite? shifted)) (return (refuse! f)))
      (arr:set! w (+ j (* j n)) shifted))
    (let choice = (.choice f))
    (for ((k 0 (+ k (arr:aref choice 0)))) :while (< k n)
      (select-pivot! w n k choice)
      (let lead = (arr:aref choice 1))
      (cond
        ((== (arr:aref choice 0) 1)
         (unless (== lead k) (swap-symmetric! w permutation n k lead))
         (unless (eliminate-one! f k) (return (refuse! f))))
        (True
         (unless (== lead k) (swap-symmetric! w permutation n k lead))
         ;; The partner is never k itself: the search leaves k only for a strictly larger entry,
         ;; so no later column's largest entry lies in row k. The first exchange cannot move it.
         (let partner = (arr:aref choice 2))
         (unless (== partner (+ k 1)) (swap-symmetric! w permutation n (+ k 1) partner))
         (unless (eliminate-two! f k) (return (refuse! f))))))
    (arr:set! st 0 1)
    FactorSuccess)

  (declare solve! (Factor * arr:LispArray F64 * arr:LispArray F64 -> SolveStatus))
  (define (solve! factor b out)
    "Solve (A - shift I) x = b into out on success; return a named outcome and preserve out on refusal."
    (unless (factor-ready? factor) (return SolveInvalidFactor))
    (let f = (storage factor))
    (let n = (.size f))
    (unless (and (== (arr:length b) n) (== (arr:length out) n)) (return SolveBadSize))
    (when (> (arr:aref (.state f) 3) 0) (return SolveSingular))
    (let permutation = (.permutation f))
    (let l = (.lower f))
    (let d = (.diagonal f))
    (let e = (.subdiagonal f))
    (let blocks = (.blocks f))
    (let w = (.scratch f))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref b (arr:aref permutation k)))
      (unless (inline (finite? v)) (return SolveNonFiniteRhs))
      (arr:set! w k v))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref w k))
      (for ((i (+ k 1) (+ i 1))) :while (< i n)
        (arr:set! w i (- (arr:aref w i) (* (arr:aref l (+ i (* k n))) v)))))
    (for ((k 0 (+ k (if (== (arr:aref blocks k) 2) 2 1)))) :while (< k n)
      (cond
        ((== (arr:aref blocks k) 2)
         (let pivot = (arr:aref e k))
         (let ar = (/ (arr:aref d k) pivot))
         (let cr = (/ (arr:aref d (+ k 1)) pivot))
         (let scale = (* pivot (- (* ar cr) 1.0d0)))
         (let u = (arr:aref w k))
         (let v = (arr:aref w (+ k 1)))
         (let p = (/ (- (* cr u) v) scale))
         (let q = (/ (- (* ar v) u) scale))
         (unless (and (inline (finite? p)) (inline (finite? q))) (return SolveNonFiniteResult))
         (arr:set! w k p)
         (arr:set! w (+ k 1) q))
        (True
         (let v = (/ (arr:aref w k) (arr:aref d k)))
         (unless (inline (finite? v)) (return SolveNonFiniteResult))
         (arr:set! w k v))))
    (for ((remaining n (- remaining 1))) :while (> remaining 0)
      (let k = (- remaining 1))
      (let acc = (cell:new (arr:aref w k)))
      (for ((i (+ k 1) (+ i 1))) :while (< i n)
        (cell:write! acc (- (cell:read acc) (* (arr:aref l (+ i (* k n))) (arr:aref w i)))))
      (unless (inline (finite? (cell:read acc))) (return SolveNonFiniteResult))
      (arr:set! w k (cell:read acc)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! out (arr:aref permutation k) (arr:aref w k)))
    SolveSuccess))
