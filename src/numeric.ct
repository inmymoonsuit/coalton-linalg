(cl:defpackage #:coalton-linalg/numeric
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:math #:coalton/math) (#:err #:coalton-linalg/errors))
  (:import-from #:coalton/math #:finite?)
  (:export #:norm2 #:norm-inf))
(cl:in-package #:coalton-linalg/numeric)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

(coalton-toplevel
  (declare norm2 (arr:LispArray F64 -> F64))
  (define (norm2 vector)
    "Euclidean norm using scaled squares; refuse nonfinite input or result."
    (let scale = (cell:new 0.0d0))
    (let squares = (cell:new 1.0d0))
    (for ((i 0 (+ i 1))) :while (< i (arr:length vector))
      (let x = (arr:aref vector i))
      (unless (finite? x)
        (throw (err:NonFiniteInput "Norm input must be finite.")))
      (let magnitude = (abs x))
      (unless (== magnitude 0.0d0)
        (if (> magnitude (cell:read scale))
            (let ((ratio (/ (cell:read scale) magnitude)))
              (cell:write! squares (+ 1.0d0 (* (cell:read squares) (* ratio ratio))))
              (cell:write! scale magnitude))
            (let ((ratio (/ magnitude (cell:read scale))))
              (cell:write! squares (+ (cell:read squares) (* ratio ratio)))))))
    (let result = (* (cell:read scale) (math:sqrt (cell:read squares))))
    (unless (finite? result)
      (throw (err:NonFiniteResult "Norm result is not finite.")))
    result)

  (declare norm-inf (arr:LispArray F64 -> F64))
  (define (norm-inf vector)
    "Largest absolute entry, or zero for an empty vector; refuse nonfinite input."
    (let largest = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i (arr:length vector))
      (let x = (arr:aref vector i))
      (unless (finite? x)
        (throw (err:NonFiniteInput "Norm input must be finite.")))
      (let magnitude = (abs x))
      (when (> magnitude (cell:read largest)) (cell:write! largest magnitude)))
    (cell:read largest)))
