(cl:defpackage #:coalton-linalg/conjugate-gradient
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:math #:coalton/math) (#:fp #:coalton-linalg/internal/float))
  (:export #:CgWorkspace #:make-cg #:dimension #:step-limit
           #:CgStatus #:CgConverged #:CgLimit #:CgNotPositive #:CgNonFinite #:CgPreconditionerRefused
           #:CgBadSize #:CgBadTolerance
           #:cg! #:pcg! #:step-count #:restart-count #:residual-norm #:recurrence-norms))
(cl:in-package #:coalton-linalg/conjugate-gradient)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

;;; Conjugate gradients for a symmetric positive definite operator. See docs/conjugate-gradient.md.

(coalton-toplevel
  (derive Eq)
  (repr :enum)
  (define-type CgStatus
    "Outcome of cg! and pcg!."
    CgConverged
    "The residual of the returned vector, formed from the operator, is within the tolerance."
    CgLimit
    "The step limit was reached with the tolerance not met; read residual-norm."
    CgNotPositive
    "A direction with no positive curvature, or a preconditioned residual with no positive product, was met: the operator or the preconditioner is not positive definite."
    CgNonFinite
    "The operator, the preconditioner or an update produced a value that was not finite."
    CgPreconditionerRefused
    "The preconditioner function reported that it could not be applied."
    CgBadSize
    "The right-hand side or the solution array does not have the workspace's dimension."
    CgBadTolerance
    "The tolerance is negative or not a number.")

  (define-struct CgStorage
    "Workspace for one dimension and one step limit, with the history of the latest call."
    (size UFix)
    (limit UFix)
    (residual (arr:LispArray F64))
    (preconditioned (arr:LispArray F64))
    (direction (arr:LispArray F64))
    (image (arr:LispArray F64))
    (saved-rhs (arr:LispArray F64))
    (norms (arr:LispArray F64))
    (scalars (arr:LispArray F64))
    (products (arr:LispArray F64))
    (bands (arr:LispArray IFix))
    (state (arr:LispArray UFix)))

  (repr :transparent)
  (define-type CgWorkspace
    "Private handle; make one with make-cg. Calls sharing a workspace are not reentrant."
    (MkCgWorkspace CgStorage))

  (inline)
  (declare storage (CgWorkspace -> CgStorage))
  (define (storage workspace) (match workspace ((MkCgWorkspace held) held)))

  (declare make-cg (UFix * UFix -> CgWorkspace))
  (define (make-cg dimension step-limit)
    "A workspace for vectors of this dimension that takes at most this many steps a call. Its storage is five vectors and one norm a step."
    (MkCgWorkspace (CgStorage dimension step-limit
                              (arr:make dimension 0.0d0) (arr:make dimension 0.0d0)
                              (arr:make dimension 0.0d0) (arr:make dimension 0.0d0)
                              (arr:make dimension 0.0d0)
                              (arr:make (+ step-limit 1) 0.0d0) (arr:make 4 -1.0d0)
                              (arr:make 2 0.0d0) (arr:make 2 (the IFix 0))
                              (arr:make 2 (the UFix 0)))))

  (declare dimension (CgWorkspace -> UFix))
  (define (dimension workspace)
    "The vector length this workspace was made for."
    (.size (storage workspace)))

  (declare step-limit (CgWorkspace -> UFix))
  (define (step-limit workspace)
    "The most steps one call takes; each step applies the operator once."
    (.limit (storage workspace)))

  (declare step-count (CgWorkspace -> UFix))
  (define (step-count workspace)
    "Steps the latest call took; 0 before any call."
    (arr:aref (.state (storage workspace)) 0))

  (declare restart-count (CgWorkspace -> UFix))
  (define (restart-count workspace)
    "Times the latest call replaced its running residual by one formed from the operator, because the running one had met the tolerance."
    (arr:aref (.state (storage workspace)) 1))

  (declare residual-norm (CgWorkspace -> F64))
  (define (residual-norm workspace)
    "The 2-norm of b - A x for the vector the latest call returned, formed from the operator, when that call ended CgConverged or CgLimit; -1 otherwise."
    (arr:aref (.scalars (storage workspace)) 0))

  (declare recurrence-norms (CgWorkspace -> arr:LispArray F64))
  (define (recurrence-norms workspace)
    "Borrowed view: the 2-norm of the running residual after each step of the latest call, entry 0 for the starting vector; step-count + 1 entries are meaningful. An entry is infinity where that norm was too large to hold."
    (.norms (storage workspace)))

  ;; The three helpers below are inlined, so that no number is boxed, and they are kept in
  ;; this file and not in the float package beside least-normal: the pinned compiler
  ;; miscompiles a function that holds a cell when it inlines it from another package,
  ;; leaving the cell's variable unbound with only a warning. See docs/batch14.md.
  ;;
  ;; Only used when an inner product is tiny. Coarse powers avoid boxing
  ;; dynamic SCALE-FLOAT arguments and leave room for products and their sum.
  (declare band-up F64)
  (define band-up (lisp (-> F64) () (cl:scale-float 1d0 256)))
  (declare band-down F64)
  (define band-down (/ 1.0d0 band-up))

  (inline)
  (declare magnitude-band (F64 -> IFix))
  (define (magnitude-band x)
    "For nonzero finite x, the k for which |x| / 2^(256k) is in [1, 2^256)."
    (let magnitude = (cell:new (abs x)))
    (let k = (cell:new (the IFix 0)))
    (for () :while (>= (cell:read magnitude) band-up)
      (cell:write! magnitude (* (cell:read magnitude) band-down))
      (cell:write! k (+ (cell:read k) 1)))
    (for () :while (< (cell:read magnitude) 1.0d0)
      (cell:write! magnitude (* (cell:read magnitude) band-up))
      (cell:write! k (- (cell:read k) 1)))
    (cell:read k))

  (inline)
  (declare shift-bands (F64 * IFix -> F64))
  (define (shift-bands x k)
    "Multiply by 2^(256k) without constructing a possibly unrepresentable multiplier."
    (let v = (cell:new x))
    (for ((i 0 (+ i 1))) :while (< i k)
      (cell:write! v (* (cell:read v) band-up)))
    (for ((i k (+ i 1))) :while (< i 0)
      (cell:write! v (* (cell:read v) band-down)))
    (cell:read v))

  (declare square-lift F64)
  (define square-lift (lisp (-> F64) () (cl:scale-float 1d0 600)))

  (inline)
  (declare norm-from-squares (arr:LispArray F64 * F64 -> F64))
  (define (norm-from-squares vector squares)
    "Root of the vector's accumulated sum of squares. Remeasure a tiny sum before its rounding loses the norm."
    (cond
      ((< squares fp:least-normal)
       ;; Even the least subnormal times 2^600 has a normal square. Every
       ;; entry here was small, so no lifted square or sum can overflow.
       (let total = (cell:new 0.0d0))
       (for ((i 0 (+ i 1))) :while (< i (arr:length vector))
         (let v = (* (arr:aref vector i) square-lift))
         (cell:write! total (+ (cell:read total) (* v v))))
       (/ (math:sqrt (cell:read total)) square-lift))
      (True (math:sqrt squares))))

  (declare dot! (CgStorage * UFix * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (dot! s slot a b)
    "Store the dot product as products[slot] times 2^(256 * bands[slot]). Ordinary sums have band zero."
    (let sum = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i (arr:length a))
      (cell:write! sum (+ (cell:read sum) (* (arr:aref a i) (arr:aref b i)))))
    (arr:set! (.bands s) slot 0)
    (when (< (abs (cell:read sum)) fp:least-normal)
      ;; A positive product can vanish before its ratio is taken. Sum at the
      ;; exponent of the largest *paired* terms, not the separate vector maxima.
      ;; Each operand has a band between -5 and 3.
      (let largest = (cell:new (the IFix -11)))
      (cell:write! sum 0.0d0)
      (for ((i 0 (+ i 1))) :while (< i (arr:length a))
        (let x = (arr:aref a i))
        (let y = (arr:aref b i))
        (unless (or (== x 0.0d0) (== y 0.0d0))
          (let ex = (magnitude-band x))
          (let ey = (magnitude-band y))
          (let e = (+ ex ey))
          (when (> e (cell:read largest))
            (cell:write! sum (shift-bands (cell:read sum) (- (cell:read largest) e)))
            (cell:write! largest e))
          (let term = (* (shift-bands x (- 0 ex)) (shift-bands y (- 0 ey))))
          (cell:write! sum (+ (cell:read sum) (shift-bands term (- e (cell:read largest)))))))
      (arr:set! (.bands s) slot (cell:read largest)))
    (arr:set! (.products s) slot (cell:read sum)))

  (inline)
  (declare product-ratio (CgStorage * UFix * UFix -> F64))
  (define (product-ratio s numerator denominator)
    (let a = (arr:aref (.products s) numerator))
    (let b = (arr:aref (.products s) denominator))
    (let delta = (- (arr:aref (.bands s) numerator) (arr:aref (.bands s) denominator)))
    (cond
      ((== delta 0) (/ a b))
      (True
       (let ea = (magnitude-band a))
       (let eb = (magnitude-band b))
       (shift-bands (/ (shift-bands a (- 0 ea)) (shift-bands b (- 0 eb)))
                       (+ delta (- ea eb))))))

  (declare unpreconditioned (arr:LispArray F64 * arr:LispArray F64 -> Boolean))
  (define (unpreconditioned r z)
    "The identity as a preconditioner."
    (for ((i 0 (+ i 1))) :while (< i (arr:length r))
      (arr:set! z i (arr:aref r i)))
    True)

  ;; The iteration is carried on the residual divided by a power of two, chosen from each
  ;; residual formed from the operator, at which the method starts again, and held in
  ;; scalars[2], its reciprocal in scalars[3]. The preconditioned residual, the direction and its
  ;; image are divided with it, since each is linear in the residual; the iterate and the norms
  ;; reported are not. Inner products are then of numbers near 1 whatever the size of the
  ;; right-hand side, and the operator is applied to a direction near 1 whatever its own size.
  ;; The division rounds nothing for an entry within 2^1022 of the largest, so wherever the
  ;; undivided quantities stayed in range the iterates are the same bit for bit. An entry
  ;; further below than that is lost to the division, and is seen again when the residual is
  ;; next formed, at the size the residual then has.
  (declare form-residual! ((arr:LispArray F64 * arr:LispArray F64 -> Void)
                           * arr:LispArray F64 * arr:LispArray F64 * arr:LispArray F64 * arr:LispArray F64
                           * arr:LispArray F64 -> Boolean))
  (define (form-residual! apply b x image residual scalars)
    "residual = (b - A x) / scalars[2] through the operator, scalars[2] and scalars[3] being first set from this residual's largest entry, and the 2-norm of b - A x into scalars[1]: infinity where the entries are finite and their norm is above the largest number. False when an entry is not finite."
    (apply x image)
    (let largest = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i (arr:length b))
      (let r = (- (arr:aref b i) (arr:aref image i)))
      (arr:set! residual i r)
      (when (> (abs r) (cell:read largest)) (cell:write! largest (abs r))))
    (unless (inline (math:finite? (cell:read largest))) (return False))
    (fp:binade! (cell:read largest) scalars 2)
    (let down = (arr:aref scalars 3))
    (let sum = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i (arr:length b))
      (let v = (* (arr:aref residual i) down))
      (arr:set! residual i v)
      (cell:write! sum (+ (cell:read sum) (* v v))))
    (let norm = (* (inline (norm-from-squares residual (cell:read sum))) (arr:aref scalars 2)))
    ;; A NaN among the entries is not a largest entry and is not seen above: it is seen here.
    (arr:set! scalars 1 norm)
    (inline (math:finite? (cell:read sum))))

  (declare cg! (CgWorkspace * (arr:LispArray F64 * arr:LispArray F64 -> Void)
                * arr:LispArray F64 * arr:LispArray F64 * F64 -> CgStatus))
  (define (cg! workspace apply b x tolerance)
    "Improve x toward the solution of A x = b for a symmetric positive definite operator, apply writing A v into its second argument, until the 2-norm of b - A x is within the absolute tolerance. See docs/conjugate-gradient.md."
    (pcg! workspace apply unpreconditioned b x tolerance))

  (declare pcg! (CgWorkspace * (arr:LispArray F64 * arr:LispArray F64 -> Void)
                 * (arr:LispArray F64 * arr:LispArray F64 -> Boolean)
                 * arr:LispArray F64 * arr:LispArray F64 * F64 -> CgStatus))
  (define (pcg! workspace apply precondition b x tolerance)
    "cg! with a preconditioner: precondition writes into its second argument an approximation of the solution of A z = r that is itself a symmetric positive definite operator on r, and returns whether it could. See docs/conjugate-gradient.md."
    (let s = (storage workspace))
    (let st = (.state s))
    (let scalars = (.scalars s))
    (let n = (.size s))
    (arr:set! st 0 0)
    (arr:set! st 1 0)
    (arr:set! scalars 0 -1.0d0)
    (unless (and (== (arr:length b) n) (== (arr:length x) n)) (return CgBadSize))
    (unless (>= tolerance 0.0d0) (return CgBadTolerance))
    (let r = (.residual s))
    (let z = (.preconditioned s))
    (let p = (.direction s))
    (let q = (.image s))
    (let norms = (.norms s))
    (let rhs = (cond ((unsafe-pointer-eq? b x)
                      (let saved = (.saved-rhs s))
                      (for ((i 0 (+ i 1))) :while (< i n)
                        (arr:set! saved i (arr:aref b i)))
                      saved)
                     (True b)))
    (unless (form-residual! apply rhs x q r scalars) (return CgNonFinite))
    (arr:set! norms 0 (arr:aref scalars 1))
    ;; True while the residual held was formed from the operator and no direction is set.
    (let fresh = (cell:new True))
    (let k = (cell:new (the UFix 0)))
    (for () :while (< (cell:read k) (.limit s))
      (when (cell:read fresh)
        (when (<= (arr:aref scalars 1) tolerance)
          (arr:set! scalars 0 (arr:aref scalars 1))
          (return CgConverged))
        (unless (precondition r z) (return CgPreconditionerRefused))
        (dot! s 0 r z)
        (let rho = (arr:aref (.products s) 0))
        (unless (inline (math:finite? rho)) (return CgNonFinite))
        (unless (> rho 0.0d0) (return CgNotPositive))
        (for ((i 0 (+ i 1))) :while (< i n)
          (arr:set! p i (arr:aref z i)))
        (cell:write! fresh False))
      (apply p q)
      (dot! s 1 p q)
      (let curvature = (arr:aref (.products s) 1))
      (unless (inline (math:finite? curvature)) (return CgNonFinite))
      (unless (> curvature 0.0d0) (return CgNotPositive))
      (let alpha = (product-ratio s 0 1))
      (unless (inline (math:finite? alpha)) (return CgNonFinite))
      ;; The step in the iterate's own units. The two factors first, which is exact: the
      ;; direction multiplied back by itself need not be a number the format holds.
      (let up = (arr:aref scalars 2))
      (let step = (* alpha up))
      (unless (inline (math:finite? step)) (return CgNonFinite))
      (let sum = (cell:new 0.0d0))
      (for ((i 0 (+ i 1))) :while (< i n)
        (arr:set! x i (+ (arr:aref x i) (* step (arr:aref p i))))
        (let v = (- (arr:aref r i) (* alpha (arr:aref q i))))
        (arr:set! r i v)
        (cell:write! sum (+ (cell:read sum) (* v v))))
      (unless (inline (math:finite? (cell:read sum))) (return CgNonFinite))
      (cell:write! k (+ (cell:read k) 1))
      (arr:set! st 0 (cell:read k))
      ;; Multiplied back, the norm can be above the largest number while the divided residual is
      ;; sound: it is recorded as infinity, meets no tolerance, and the method goes on.
      (let norm = (* (inline (norm-from-squares r (cell:read sum))) up))
      (arr:set! norms (cell:read k) norm)
      ;; When the running residual says the tolerance is met: it is a recurrence and can have
      ;; drifted from b - A x, so the residual is formed from the operator and the test is
      ;; made on that at the top of the next round; if it fails there, the method starts
      ;; again from the residual just formed.
      (let met = (<= norm tolerance))
      (when met
        (unless (form-residual! apply rhs x q r scalars) (return CgNonFinite))
        (cell:write! fresh True)
        (arr:set! st 1 (+ (arr:aref st 1) 1)))
      (unless (or met (== (cell:read k) (.limit s)))
        (unless (precondition r z) (return CgPreconditionerRefused))
        (dot! s 1 r z)
        (let next = (arr:aref (.products s) 1))
        (unless (inline (math:finite? next)) (return CgNonFinite))
        (unless (> next 0.0d0) (return CgNotPositive))
        (let beta = (product-ratio s 1 0))
        (unless (inline (math:finite? beta)) (return CgNonFinite))
        (arr:set! (.products s) 0 next)
        (arr:set! (.bands s) 0 (arr:aref (.bands s) 1))
        (for ((i 0 (+ i 1))) :while (< i n)
          (arr:set! p i (+ (arr:aref z i) (* beta (arr:aref p i)))))))
    ;; The limit. What is reported is the residual formed from the operator.
    (unless (cell:read fresh)
      (unless (form-residual! apply rhs x q r scalars) (return CgNonFinite)))
    (arr:set! scalars 0 (arr:aref scalars 1))
    (if (<= (arr:aref scalars 0) tolerance) CgConverged CgLimit)))
