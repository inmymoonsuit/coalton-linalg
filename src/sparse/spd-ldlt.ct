(cl:defpackage #:coalton-linalg/sparse/spd-ldlt
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:ord #:coalton-linalg/sparse/ordering)
                    (#:limits #:coalton-linalg/sparse/limits)
                    (#:csc #:coalton-linalg/sparse/csc) (#:err #:coalton-linalg/errors))
  (:import-from #:coalton/math #:finite? #:sqrt)
  (:export #:Pattern #:Symbolic #:NumericFactor #:maximum-analysis-size #:default-analysis-entry-limit
           #:FactorStatus #:FactorSuccess #:FactorNonPositive #:FactorNonFinite #:FactorBadValues #:FactorBadShift
           #:SolveStatus #:SolveSuccess #:SolveInvalidFactor #:SolveBadSize #:SolveNonFiniteRhs #:SolveNonFiniteResult
           #:SignedFactorStatus #:SignedSuccess #:SignedZeroPivot #:SignedNonFinite #:SignedBadValues
           #:SignedBadShift #:factor-signed! #:positive-pivot-count #:negative-pivot-count #:factor-growth
           #:factor-backward-bound
           #:SkipFactorStatus #:SkipSuccess #:SkipNonFinite #:SkipBadValues #:SkipBadShift #:SkipBadFloor
           #:factor-skipping! #:skipping-ready? #:skipped-count #:solve-skipping!
           #:NullVectorStatus #:NullVectorSuccess #:NullVectorNoFactor #:NullVectorNotSkipped
           #:NullVectorBadSize #:NullVectorNonFinite #:skipped-null-vector!
           #:analyze-quasidefinite #:analyze-quasidefinite-with-limit
           #:analyze #:analyze-csc #:analyze-with-limit #:analyze-csc-with-limit #:factor! #:solve! #:refused-column
           #:symbolic-factor #:factor-permutation #:factor-columns #:factor-rows
           #:factor-values #:factor-diagonal #:factor-ready? #:factor-cholesky! #:cholesky-ready? #:solve-cholesky!
           #:ConditionStatus #:ConditionSuccess #:ConditionInvalidFactor #:ConditionNonFiniteResult
           #:estimate-inverse-norm1! #:inverse-norm1-estimate #:estimate-solve-count
           #:maximum-estimate-solves #:shifted-norm1 #:reciprocal-condition1))
(cl:in-package #:coalton-linalg/sparse/spd-ldlt)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

(coalton-toplevel
  (define-struct Pattern
    "Lower CSC structure. Each column starts with its diagonal; rows strictly increase."
    (size UFix)
    (columns (arr:LispArray UFix))
    (rows (arr:LispArray UFix)))

  (define-struct NumericFactorStorage
    "Borrowed mutable factor; invalidated by every factor call on its owning Symbolic."
    (size UFix)
    (permutation (arr:LispArray UFix))
    (columns (arr:LispArray UFix))
    (rows (arr:LispArray UFix))
    (entries (arr:LispArray F64))
    (diagonal (arr:LispArray F64))
    (scratch (arr:LispArray F64))
    (state (arr:LispArray UFix))
    (probe (arr:LispArray F64))
    (image (arr:LispArray F64))
    (estimate (arr:LispArray F64)))

  (repr :transparent)
  (define-type NumericFactor
    "Borrowed factor handle; construction and workspace fields are private."
    (MkNumericFactor NumericFactorStorage))

  (inline)
  (declare numeric-storage (NumericFactor -> NumericFactorStorage))
  (define (numeric-storage factor) (match factor ((MkNumericFactor storage) storage)))

  (derive Eq)
  (repr :enum)
  (define-type FactorStatus
    "Outcome of a factorization call; independent of later workspace validity."
    FactorSuccess
    "A factor stands."
    FactorNonPositive
    "A computed pivot was not positive; refused-column names it."
    FactorNonFinite
    "A value or an intermediate result was not finite."
    FactorBadValues
    "The value count differs from the analyzed pattern's."
    FactorBadShift
    "The shift was not finite.")

  (derive Eq)
  (repr :enum)
  (define-type SignedFactorStatus
    "Outcome of a signed-pivot factorization call, which refuses a pivot only when it is zero."
    SignedSuccess
    "A factor stands; read its growth and pivot counts."
    SignedZeroPivot
    "A computed pivot was exactly zero; refused-column names it."
    SignedNonFinite
    "A value or an intermediate result was not finite."
    SignedBadValues
    "The value count differs from the analyzed pattern's."
    SignedBadShift
    "The shift was not finite.")

  (derive Eq)
  (repr :enum)
  (define-type SkipFactorStatus
    "Outcome of a pivot-skipping factorization call, which refuses no pivot that is finite."
    SkipSuccess
    "A factor of the kept principal submatrix stands; read skipped-count."
    SkipNonFinite
    "A value or an intermediate result was not finite."
    SkipBadValues
    "The value count differs from the analyzed pattern's."
    SkipBadShift
    "The shift was not finite."
    SkipBadFloor
    "The pivot floor was negative or not finite.")

  (derive Eq)
  (repr :enum)
  (define-type NullVectorStatus
    "Outcome of a request for the vector that belongs to a skipped index."
    NullVectorSuccess
    "The output holds the vector."
    NullVectorNoFactor
    "No pivot-skipping factor stands."
    NullVectorNotSkipped
    "The index is out of range or was not skipped."
    NullVectorBadSize
    "The output's length differs from the order."
    NullVectorNonFinite
    "A computed entry was not finite; the output is unchanged.")

  (derive Eq)
  (repr :enum)
  (define-type SolveStatus
    "Outcome of a solve call; distinct from factorization outcomes."
    SolveSuccess
    "The output holds the solution."
    SolveInvalidFactor
    "No solving factor stands."
    SolveBadSize
    "A vector's length differs from the order."
    SolveNonFiniteRhs
    "The right-hand side holds a non-finite entry."
    SolveNonFiniteResult
    "The computed solution was not finite; the output is unchanged.")

  (define-struct SymbolicStorage
    "Owns one reusable factor, scatter, row incidence and latest-call diagnostic."
    (numeric NumericFactor)
    (input-count UFix)
    (input-columns (arr:LispArray UFix))
    (input-rows (arr:LispArray UFix))
    (input-indices (arr:LispArray UFix))
    (row-columns (arr:LispArray UFix))
    (row-owners (arr:LispArray UFix))
    (row-positions (arr:LispArray UFix))
    (diagnostic (arr:LispArray IFix)))

  (repr :transparent)
  (define-type Symbolic
    "Analysis handle owning one reusable factor and private workspace."
    (MkSymbolic SymbolicStorage))

  (inline)
  (declare symbolic-storage (Symbolic -> SymbolicStorage))
  (define (symbolic-storage symbolic) (match symbolic ((MkSymbolic storage) storage)))

  (declare refused-column (Symbolic -> IFix))
  (define (refused-column s)
    "Latest factor! refusal column in original numbering; -1 before any call or for other outcomes."
    (arr:aref (.diagnostic (symbolic-storage s)) 0))

  (declare symbolic-factor (Symbolic -> NumericFactor))
  (define (symbolic-factor s)
    "The one factor this analysis owns; every factorization call on the analysis overwrites it."
    (.numeric (symbolic-storage s)))
  (declare factor-permutation (NumericFactor -> arr:LispArray UFix))
  (define (factor-permutation f)
    "Borrowed view: the original index eliminated at each step."
    (.permutation (numeric-storage f)))
  (declare factor-columns (NumericFactor -> arr:LispArray UFix))
  (define (factor-columns f)
    "Borrowed view: column pointers of the strict lower triangle of L, in elimination numbering."
    (.columns (numeric-storage f)))
  (declare factor-rows (NumericFactor -> arr:LispArray UFix))
  (define (factor-rows f)
    "Borrowed view: row indices of the strict lower triangle of L, increasing within a column."
    (.rows (numeric-storage f)))
  (declare factor-values (NumericFactor -> arr:LispArray F64))
  (define (factor-values f)
    "Borrowed view: the values of the strict lower triangle of L, in the order of factor-rows."
    (.entries (numeric-storage f)))
  (declare factor-diagonal (NumericFactor -> arr:LispArray F64))
  (define (factor-diagonal f)
    "Borrowed view: the pivots D in elimination order."
    (.diagonal (numeric-storage f)))
  (declare factor-ready? (NumericFactor -> Boolean))
  (define (factor-ready? f)
    "Whether a solving factor stands: the latest factor! or factor-signed! on its analysis succeeded."
    (== (arr:aref (.state (numeric-storage f)) 0) 1))
  (declare cholesky-ready? (NumericFactor -> Boolean))
  (define (cholesky-ready? f)
    "Whether the storage holds the Cholesky-form factor of the latest factor-cholesky! call, which solve-cholesky! accepts and solve! does not."
    (== (arr:aref (.state (numeric-storage f)) 0) 2))
  (declare skipping-ready? (NumericFactor -> Boolean))
  (define (skipping-ready? f)
    "Whether the storage holds the factor of the latest factor-skipping! call, which solve-skipping! accepts and solve! does not."
    (== (arr:aref (.state (numeric-storage f)) 0) 3))
  (declare skipped-count (NumericFactor -> UFix))
  (define (skipped-count f)
    "Indices the standing pivot-skipping factor left out; 0 when none stands. A skipped index has a zero in factor-diagonal."
    (let st = (.state (numeric-storage f)))
    (if (== (arr:aref st 0) 3) (- (.size (numeric-storage f)) (arr:aref st 2)) 0))
  (declare positive-pivot-count (NumericFactor -> UFix))
  (define (positive-pivot-count f)
    "Positive entries of D in the factor as it now stands; 0 when no factor stands."
    (arr:aref (.state (numeric-storage f)) 2))
  (declare negative-pivot-count (NumericFactor -> UFix))
  (define (negative-pivot-count f)
    "Negative entries of D in the factor as it now stands; 0 when no factor stands."
    (arr:aref (.state (numeric-storage f)) 3))
  (declare factor-growth (NumericFactor -> F64))
  (define (factor-growth f)
    "Largest entry of |L| |D| |L^T| over the largest magnitude factored, measured by the latest successful factor-signed!; -1 otherwise."
    (arr:aref (.estimate (numeric-storage f)) 1))
  (declare factor-backward-bound (NumericFactor -> F64))
  (define (factor-backward-bound f)
    "An upper bound on the Frobenius norm, hence the 2-norm, of P K P^T - L D L^T for the factor of the latest successful factor-signed!, K being the matrix as factored; -1 otherwise. It may be infinite. See docs/quasidefinite.md."
    (arr:aref (.estimate (numeric-storage f)) 2))

  (inline)
  (declare %count->float (UFix -> F64))
  (define (%count->float count)
    "A count as a floating-point number; exact below 2^53."
    (lisp (-> F64) (count) (cl:coerce count 'cl:double-float)))

  (declare unit-roundoff F64)
  (define unit-roundoff (lisp (-> F64) () (cl:scale-float 1d0 -53)))
  (declare smallest-positive F64)
  (define smallest-positive (lisp (-> F64) () cl:least-positive-double-float))

  (declare maximum-analysis-size UFix)
  (define maximum-analysis-size
    "Largest order an analysis accepts, and the cap on any entry budget."
    limits:maximum-analysis-size)

  (declare default-analysis-entry-limit UFix)
  (define default-analysis-entry-limit
    "Default budget of factor entries, 2^20, counting the unit diagonal."
    limits:default-analysis-entry-limit)

  (declare refuse! (SymbolicStorage * UFix * UFix -> UFix))
  (define (refuse! s column code)
    "Record the refused column in original numbering, withdraw the pivot counts, and pass the kernel code on."
    (let f = (numeric-storage (.numeric s)))
    (arr:set! (.diagnostic s) 0 (into (arr:aref (.permutation f) column)))
    (arr:set! (.state f) 2 0)
    (arr:set! (.state f) 3 0)
    code)

  (declare validate-pattern (Pattern -> Void))
  (define (validate-pattern p)
    (let n = (.size p))
    (let cp = (.columns p))
    (let ri = (.rows p))
    (unless (and (== (arr:length cp) (+ n 1))
                 (== (arr:aref cp 0) 0)
                 (== (arr:aref cp n) (arr:length ri)))
      (throw (err:InvalidStructure "Invalid CSC column pointers.")))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let start = (arr:aref cp k))
      (let end = (arr:aref cp (+ k 1)))
      (unless (and (< start end) (<= end (arr:length ri))
                   (== (arr:aref ri start) k))
        (throw (err:InvalidStructure "CSC column must begin with its diagonal.")))
      (for ((q (+ start 1) (+ q 1))) :while (< q end)
        (unless (and (< (arr:aref ri (- q 1)) (arr:aref ri q))
                     (< (arr:aref ri q) n))
          (throw (err:InvalidStructure "CSC rows must strictly increase below the diagonal."))))))

  (declare analyze-csc (csc:Matrix -> Symbolic))
  (define (analyze-csc matrix)
    "Analyze checked square lower CSC using the default total-factor-entry budget."
    (analyze-csc-with-limit matrix default-analysis-entry-limit))

  (declare analyze-csc-with-limit (csc:Matrix * UFix -> Symbolic))
  (define (analyze-csc-with-limit matrix maximum-entries)
    "Analyze square lower CSC with an explicit nnz(L) budget, including the diagonal."
    (unless (== (csc:row-count matrix) (csc:column-count matrix))
      (throw (err:InvalidDimensions "SPD analysis requires a square matrix.")))
    (analyze-with-limit (Pattern (csc:row-count matrix)
                                (csc:column-pointers matrix) (csc:row-indices matrix))
                        maximum-entries))

  (declare analyze (Pattern -> Symbolic))
  (define (analyze pattern)
    "Validate and own the pattern using the default total-factor-entry budget."
    (analyze-with-limit pattern default-analysis-entry-limit))

  (declare analyze-with-limit (Pattern * UFix -> Symbolic))
  (define (analyze-with-limit pattern requested-entries)
    "Analyze with an nnz(L) budget including the diagonal; refuse before exceeding it."
    (analyze-held pattern requested-entries (.size pattern)))

  (declare analyze-quasidefinite (Pattern * UFix -> Symbolic))
  (define (analyze-quasidefinite pattern leading)
    "Analyze for signed pivots under the default budget, holding each index from leading on until a neighbour below leading is eliminated. See docs/quasidefinite.md."
    (analyze-quasidefinite-with-limit pattern leading default-analysis-entry-limit))

  (declare analyze-quasidefinite-with-limit (Pattern * UFix * UFix -> Symbolic))
  (define (analyze-quasidefinite-with-limit pattern leading requested-entries)
    "analyze-quasidefinite with an nnz(L) budget including the diagonal."
    (when (> leading (.size pattern))
      (throw (err:InvalidDimensions "The leading dimension exceeds the pattern's size.")))
    (analyze-held pattern requested-entries leading))

  (declare analyze-held (Pattern * UFix * UFix -> Symbolic))
  (define (analyze-held pattern requested-entries leading)
    (let n = (.size pattern))
    ;; Bound n+1 and heap child arithmetic before validation or allocation.
    (limits:check-dimension! n)
    (let maximum-entries = (limits:effective-entry-limit requested-entries))
    (when (> n maximum-entries)
      (throw (err:AnalysisStorageExceeded (into n) maximum-entries)))
    (validate-pattern pattern)
    (let cp = (.columns pattern))
    (let ri = (.rows pattern))
    (let nnz = (arr:length ri))
    (when (> nnz maximum-entries)
      (throw (err:AnalysisStorageExceeded (into nnz) maximum-entries)))
    (let ordering = (ord:minimum-degree n cp ri maximum-entries leading))
    (let perm = (.permutation ordering))
    (let inverse = (.inverse ordering))
    (let neighbors = (.neighbors ordering))
    ;; The ordering gives each column's rows unsorted. Passing through the rows sorts every
    ;; column at once: rows filled column by column hold their columns in increasing order,
    ;; and columns refilled row by row hold their rows in increasing order.
    (let lp = (arr:make (+ n 1) (the UFix 0)))
    (let rp = (arr:make (+ n 1) (the UFix 0)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let adj = (arr:aref neighbors k))
      (arr:set! lp (+ k 1) (+ (arr:aref lp k) (arr:length adj)))
      (for ((q 0 (+ q 1))) :while (< q (arr:length adj))
        (let i = (arr:aref inverse (arr:aref adj q)))
        (arr:set! rp (+ i 1) (+ (arr:aref rp (+ i 1)) 1))))
    (let nzl = (arr:aref lp n))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! rp (+ k 1) (+ (arr:aref rp k) (arr:aref rp (+ k 1)))))
    (let rc = (arr:make nzl (the UFix 0)))
    (let next = (arr:copy rp))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let adj = (arr:aref neighbors k))
      (for ((q 0 (+ q 1))) :while (< q (arr:length adj))
        (let i = (arr:aref inverse (arr:aref adj q)))
        (arr:set! rc (arr:aref next i) k)
        (arr:set! next i (+ (arr:aref next i) 1))))
    (let lr = (arr:make nzl (the UFix 0)))
    (let rq = (arr:make nzl (the UFix 0)))
    (let place = (arr:copy lp))
    (for ((i 0 (+ i 1))) :while (< i n)
      (for ((slot (arr:aref rp i) (+ slot 1))) :while (< slot (arr:aref rp (+ i 1)))
        (let k = (arr:aref rc slot))
        (let q = (arr:aref place k))
        (arr:set! lr q i)
        (arr:set! rq slot q)
        (arr:set! place k (+ q 1))))
    (let ap = (arr:make (+ n 1) (the UFix 0)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let pj = (arr:aref inverse j))
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (let pi = (arr:aref inverse (arr:aref ri q)))
        (let k = (if (< pi pj) pi pj))
        (arr:set! ap (+ k 1) (+ (arr:aref ap (+ k 1)) 1))))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! ap (+ k 1) (+ (arr:aref ap k) (arr:aref ap (+ k 1)))))
    (let ar = (arr:make nnz (the UFix 0)))
    (let ai = (arr:make nnz (the UFix 0)))
    (let cursor = (arr:copy ap))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let pj = (arr:aref inverse j))
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (let pi = (arr:aref inverse (arr:aref ri q)))
        (let k = (if (< pi pj) pi pj))
        (let row = (if (< pi pj) pj pi))
        (let slot = (arr:aref cursor k))
        (arr:set! ar slot row)
        (arr:set! ai slot q)
        (arr:set! cursor k (+ slot 1))))
    (let f = (MkNumericFactor (NumericFactorStorage n perm lp lr (arr:make nzl 0.0d0) (arr:make n 0.0d0)
                    (arr:make n 0.0d0) (arr:make 4 (the UFix 0))
                    (arr:make n 0.0d0) (arr:make n 0.0d0) (arr:make 3 -1.0d0))))
    (MkSymbolic (SymbolicStorage f nnz ap ar ai rp rc rq (arr:make 1 (the IFix -1)))))

  (declare factor-kernel! (Symbolic * arr:LispArray F64 * F64 * Boolean * Boolean * F64 -> UFix))
  (define (factor-kernel! symbolic values shift signed skipping floor)
    "The numeric factorization the entry points share: 0 success, 1 refused pivot, 2 non-finite, 3 bad values, 4 bad shift, 5 bad floor. With skipping, a pivot at or below floor is left out and not refused."
    (let s = (symbolic-storage symbolic))
    (let f = (numeric-storage (.numeric s)))
    (let st = (.state f))
    (arr:set! st 0 0)
    ;; A stored inverse-norm estimate describes the previous factor only.
    (arr:set! st 1 0)
    (arr:set! st 2 0)
    (arr:set! st 3 0)
    (arr:set! (.estimate f) 0 -1.0d0)
    (arr:set! (.estimate f) 1 -1.0d0)
    (arr:set! (.estimate f) 2 -1.0d0)
    (arr:set! (.diagnostic s) 0 -1)
    (unless (== (arr:length values) (.input-count s)) (return 3))
    (unless (inline (finite? shift)) (return 4))
    (unless (and (>= floor 0.0d0) (inline (finite? floor))) (return 5))
    (let n = (.size f))
    (let lp = (.columns f))
    (let lr = (.rows f))
    (let lv = (.entries f))
    (let d = (.diagonal f))
    (let w = (.scratch f))
    ;; For the signed entry only: bound[i] accumulates row i of the diagonal of |L| |D| |L^T|,
    ;; and top the largest magnitude factored. The estimate's probe vector is free until then.
    (let bound = (.probe f))
    (let top = (cell:new 0.0d0))
    ;; The largest magnitude among the multipliers, for the underflow term.
    (let steepest = (cell:new 0.0d0))
    (when signed
      (for ((i 0 (+ i 1))) :while (< i n) (arr:set! bound i 0.0d0)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! w k 0.0d0)
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (arr:set! w (arr:aref lr q) 0.0d0))
      (for ((q (arr:aref (.input-columns s) k) (+ q 1)))
          :while (< q (arr:aref (.input-columns s) (+ k 1)))
        (let v = (arr:aref values (arr:aref (.input-indices s) q)))
        (unless (inline (finite? v)) (return (refuse! s k 2)))
        ;; The diagonal is measured after the shift, below; here only the entries off it.
        (when (and signed (and (> (arr:aref (.input-rows s) q) k) (> (abs v) (cell:read top))))
          (cell:write! top (abs v)))
        (arr:set! w (arr:aref (.input-rows s) q) v))
      (arr:set! w k (- (arr:aref w k) shift))
      (when (and signed (> (abs (arr:aref w k)) (cell:read top))) (cell:write! top (abs (arr:aref w k))))
      (for ((r (arr:aref (.row-columns s) k) (+ r 1)))
          :while (< r (arr:aref (.row-columns s) (+ k 1)))
        (let j = (arr:aref (.row-owners s) r))
        (let at-k = (arr:aref (.row-positions s) r))
        (let multiplier = (* (arr:aref lv at-k) (arr:aref d j)))
        (for ((q at-k (+ q 1))) :while (< q (arr:aref lp (+ j 1)))
          (let i = (arr:aref lr q))
          (arr:set! w i (- (arr:aref w i) (* multiplier (arr:aref lv q))))))
      (let pivot = (arr:aref w k))
      (unless (inline (finite? pivot)) (return (refuse! s k 2)))
      ;; The positive definite entry refuses every pivot that is not positive; the signed entry
      ;; refuses only the pivot it cannot divide by; the skipping entry refuses none.
      (let skip = (and skipping (<= pivot floor)))
      (unless skip
        (cond
          (signed (when (== pivot 0.0d0) (return (refuse! s k 1))))
          (True (unless (> pivot 0.0d0) (return (refuse! s k 1))))))
      (cond
        ;; A skipped index keeps a zero pivot and an empty column, so no later column receives
        ;; anything from it: what follows is the factorization of the matrix without it. Its
        ;; row, in the columns before it, stays as computed and is what its null vector needs.
        (skip
         (arr:set! d k 0.0d0)
         (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
           (arr:set! lv q 0.0d0)))
        (True
         (cond
           ((> pivot 0.0d0) (arr:set! st 2 (+ (arr:aref st 2) 1)))
           (True (arr:set! st 3 (+ (arr:aref st 3) 1))))
         (arr:set! d k pivot)
         (when signed (arr:set! bound k (+ (arr:aref bound k) (abs pivot))))
         (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
           (let v = (/ (arr:aref w (arr:aref lr q)) pivot))
           (unless (inline (finite? v)) (return (refuse! s k 2)))
           (when signed
             (arr:set! bound (arr:aref lr q) (+ (arr:aref bound (arr:aref lr q)) (* (* v v) (abs pivot))))
             (when (> (abs v) (cell:read steepest)) (cell:write! steepest (abs v))))
           (arr:set! lv q v)))))
    (when signed
      ;; |L| |D| |L^T| is a Gram matrix, so its largest entry is on its diagonal.
      (let widest = (cell:new 0.0d0))
      (let trace = (cell:new 0.0d0))
      (let longest = (cell:new (the UFix 0)))
      (for ((i 0 (+ i 1))) :while (< i n)
        (when (> (arr:aref bound i) (cell:read widest)) (cell:write! widest (arr:aref bound i)))
        (cell:write! trace (+ (cell:read trace) (arr:aref bound i)))
        (let across = (- (arr:aref (.row-columns s) (+ i 1)) (arr:aref (.row-columns s) i)))
        (when (> across (cell:read longest)) (cell:write! longest across)))
      (arr:set! (.estimate f) 1 (if (> (cell:read top) 0.0d0) (/ (cell:read widest) (cell:read top)) 0.0d0))
      ;; The backward error. Each entry of P K P^T - L D L^T is within gamma(w + 2) of the same
      ;; entry of |L| |D| |L^T|, w the longest row of L, plus what underflow can add; the
      ;; Frobenius norm of |L| |D| |L^T| is at most its trace. Every factor here is rounded up
      ;; by a margin that covers the rounding of this arithmetic itself.
      (let order = (%count->float n))
      (let reach = (%count->float (+ (cell:read longest) 2)))
      (let relative = (/ (* reach unit-roundoff) (- 1.0d0 (* reach unit-roundoff))))
      (let underflow = (* smallest-positive
                          (+ 3.0d0 (* (* order reach) (+ 2.0d0 (* 2.0d0 (cell:read steepest)))))))
      (let margin = (+ 1.0d0 (* (* 2.0d0 unit-roundoff) (+ order (+ (* 2.0d0 reach) 10.0d0)))))
      (arr:set! (.estimate f) 2 (* margin (+ (* relative (cell:read trace)) underflow))))
    (arr:set! st 0 (if skipping 3 1))
    0)

  (declare factor! (Symbolic * arr:LispArray F64 * F64 -> FactorStatus))
  (define (factor! symbolic values shift)
    "Overwrite the owned factor, requiring every pivot positive. A refusal invalidates it. Values use the analyzed CSC order."
    (let code = (factor-kernel! symbolic values shift False False 0.0d0))
    (cond
      ((== code 0) FactorSuccess)
      ((== code 1) FactorNonPositive)
      ((== code 2) FactorNonFinite)
      ((== code 3) FactorBadValues)
      (True FactorBadShift)))

  (declare factor-signed! (Symbolic * arr:LispArray F64 * F64 -> SignedFactorStatus))
  (define (factor-signed! symbolic values shift)
    "Overwrite the owned factor, accepting pivots of either sign and refusing only a zero one. See docs/quasidefinite.md."
    (let code = (factor-kernel! symbolic values shift True False 0.0d0))
    (cond
      ((== code 0) SignedSuccess)
      ((== code 1) SignedZeroPivot)
      ((== code 2) SignedNonFinite)
      ((== code 3) SignedBadValues)
      (True SignedBadShift)))

  (declare factor-skipping! (Symbolic * arr:LispArray F64 * F64 * F64 -> SkipFactorStatus))
  (define (factor-skipping! symbolic values shift floor)
    "Overwrite the owned factor, leaving out every index whose pivot is at or below floor: what stands is the factor of the principal submatrix of the kept indices. See docs/skipping.md."
    (let code = (factor-kernel! symbolic values shift False True floor))
    (cond
      ((== code 0) SkipSuccess)
      ((== code 2) SkipNonFinite)
      ((== code 3) SkipBadValues)
      ((== code 4) SkipBadShift)
      (True SkipBadFloor)))

  (declare refuse-status! (SymbolicStorage * UFix * FactorStatus -> FactorStatus))
  (define (refuse-status! s column status)
    (refuse! s column 0)
    status)

  (declare factor-cholesky! (Symbolic * arr:LispArray F64 * F64 -> FactorStatus))
  (define (factor-cholesky! symbolic values shift)
    "Overwrite the owned storage with G where P (A - shift I) P^T = G G^T, in the arithmetic docs/cholesky-form.md states. For a proof; solve-cholesky! solves with it and solve! does not accept it."
    (let s = (symbolic-storage symbolic))
    (let f = (numeric-storage (.numeric s)))
    (arr:set! (.state f) 0 0)
    (arr:set! (.state f) 1 0)
    (arr:set! (.state f) 2 0)
    (arr:set! (.state f) 3 0)
    (arr:set! (.estimate f) 0 -1.0d0)
    (arr:set! (.estimate f) 1 -1.0d0)
    (arr:set! (.estimate f) 2 -1.0d0)
    (arr:set! (.diagnostic s) 0 -1)
    (unless (== (arr:length values) (.input-count s)) (return FactorBadValues))
    (unless (inline (finite? shift)) (return FactorBadShift))
    (let n = (.size f))
    (let lp = (.columns f))
    (let lr = (.rows f))
    (let lv = (.entries f))
    (let d = (.diagonal f))
    (let w = (.scratch f))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! w k 0.0d0)
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (arr:set! w (arr:aref lr q) 0.0d0))
      (for ((q (arr:aref (.input-columns s) k) (+ q 1)))
          :while (< q (arr:aref (.input-columns s) (+ k 1)))
        (let v = (arr:aref values (arr:aref (.input-indices s) q)))
        (unless (inline (finite? v)) (return (refuse-status! s k FactorNonFinite)))
        (arr:set! w (arr:aref (.input-rows s) q) v))
      (arr:set! w k (- (arr:aref w k) shift))
      ;; One subtraction of one rounded product for each earlier column j with an entry in row k,
      ;; in increasing j, and within it for each row i from k down the column.
      (for ((r (arr:aref (.row-columns s) k) (+ r 1)))
          :while (< r (arr:aref (.row-columns s) (+ k 1)))
        (let j = (arr:aref (.row-owners s) r))
        (let at-k = (arr:aref (.row-positions s) r))
        (let g-kj = (arr:aref lv at-k))
        (for ((q at-k (+ q 1))) :while (< q (arr:aref lp (+ j 1)))
          (let i = (arr:aref lr q))
          (arr:set! w i (- (arr:aref w i) (* g-kj (arr:aref lv q))))))
      (let pivot = (arr:aref w k))
      (unless (inline (finite? pivot)) (return (refuse-status! s k FactorNonFinite)))
      (unless (> pivot 0.0d0) (return (refuse-status! s k FactorNonPositive)))
      (let root = (sqrt pivot))
      (arr:set! d k root)
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (let v = (/ (arr:aref w (arr:aref lr q)) root))
        (unless (inline (finite? v)) (return (refuse-status! s k FactorNonFinite)))
        (arr:set! lv q v)))
    (arr:set! (.state f) 0 2)
    FactorSuccess)

  (declare solve! (NumericFactor * arr:LispArray F64 * arr:LispArray F64 -> SolveStatus))
  (define (solve! factor b out)
    "Solve into out on success; return a named outcome and preserve out on refusal."
    (unless (factor-ready? factor) (return SolveInvalidFactor))
    (let f = (numeric-storage factor))
    (let n = (.size f))
    (unless (and (== (arr:length b) n) (== (arr:length out) n)) (return SolveBadSize))
    (let perm = (.permutation f))
    (let lp = (.columns f))
    (let lr = (.rows f))
    (let lv = (.entries f))
    (let d = (.diagonal f))
    (let w = (.scratch f))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref b (arr:aref perm k)))
      (unless (inline (finite? v)) (return SolveNonFiniteRhs))
      (arr:set! w k v))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref w k))
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (let i = (arr:aref lr q))
        (arr:set! w i (- (arr:aref w i) (* (arr:aref lv q) v)))))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (/ (arr:aref w k) (arr:aref d k)))
      (unless (inline (finite? v)) (return SolveNonFiniteResult))
      (arr:set! w k v))
    (for ((remaining n (- remaining 1))) :while (> remaining 0)
      (let k = (- remaining 1))
      (let acc = (cell:new (arr:aref w k)))
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (cell:write! acc (- (cell:read acc) (* (arr:aref lv q) (arr:aref w (arr:aref lr q))))))
      (unless (inline (finite? (cell:read acc))) (return SolveNonFiniteResult))
      (arr:set! w k (cell:read acc)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! out (arr:aref perm k) (arr:aref w k)))
    SolveSuccess)

  (declare solve-cholesky! (NumericFactor * arr:LispArray F64 * arr:LispArray F64 -> SolveStatus))
  (define (solve-cholesky! factor b out)
    "Solve (A - shift I) x = b with the standing Cholesky-form factor, the shift being the one factor-cholesky! was given. Solve into out on success; return a named outcome and preserve out on refusal. See docs/cholesky-form.md."
    (unless (cholesky-ready? factor) (return SolveInvalidFactor))
    (let f = (numeric-storage factor))
    (let n = (.size f))
    (unless (and (== (arr:length b) n) (== (arr:length out) n)) (return SolveBadSize))
    (let perm = (.permutation f))
    (let lp = (.columns f))
    (let lr = (.rows f))
    (let g = (.entries f))
    (let d = (.diagonal f))
    (let w = (.scratch f))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref b (arr:aref perm k)))
      (unless (inline (finite? v)) (return SolveNonFiniteRhs))
      (arr:set! w k v))
    ;; G z = P b, a column at a time: the diagonal divides, then the column is taken off the rest.
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (/ (arr:aref w k) (arr:aref d k)))
      (unless (inline (finite? v)) (return SolveNonFiniteResult))
      (arr:set! w k v)
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (let i = (arr:aref lr q))
        (arr:set! w i (- (arr:aref w i) (* (arr:aref g q) v)))))
    ;; G^T y = z, from the last row up.
    (for ((remaining n (- remaining 1))) :while (> remaining 0)
      (let k = (- remaining 1))
      (let acc = (cell:new (arr:aref w k)))
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (cell:write! acc (- (cell:read acc) (* (arr:aref g q) (arr:aref w (arr:aref lr q))))))
      (let v = (/ (cell:read acc) (arr:aref d k)))
      (unless (inline (finite? v)) (return SolveNonFiniteResult))
      (arr:set! w k v))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! out (arr:aref perm k) (arr:aref w k)))
    SolveSuccess)

  (declare solve-skipping! (NumericFactor * arr:LispArray F64 * arr:LispArray F64 -> SolveStatus))
  (define (solve-skipping! factor b out)
    "Solve the kept principal system with the standing pivot-skipping factor: entries of b at skipped indices are not used, and the solution is zero there. Solve into out on success; return a named outcome and preserve out on refusal. See docs/skipping.md."
    (unless (skipping-ready? factor) (return SolveInvalidFactor))
    (let f = (numeric-storage factor))
    (let n = (.size f))
    (unless (and (== (arr:length b) n) (== (arr:length out) n)) (return SolveBadSize))
    (let perm = (.permutation f))
    (let lp = (.columns f))
    (let lr = (.rows f))
    (let lv = (.entries f))
    (let d = (.diagonal f))
    (let w = (.scratch f))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref b (arr:aref perm k)))
      (unless (inline (finite? v)) (return SolveNonFiniteRhs))
      (arr:set! w k v))
    ;; Earlier columns hold entries in a skipped row and have written to it; it is cleared when
    ;; reached, before anything reads it.
    (for ((k 0 (+ k 1))) :while (< k n)
      (cond
        ((== (arr:aref d k) 0.0d0) (arr:set! w k 0.0d0))
        (True
         (let v = (arr:aref w k))
         (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
           (let i = (arr:aref lr q))
           (arr:set! w i (- (arr:aref w i) (* (arr:aref lv q) v)))))))
    (for ((k 0 (+ k 1))) :while (< k n)
      (unless (== (arr:aref d k) 0.0d0)
        (let v = (/ (arr:aref w k) (arr:aref d k)))
        (unless (inline (finite? v)) (return SolveNonFiniteResult))
        (arr:set! w k v)))
    ;; A skipped index has an empty column and a zero, so it stays zero.
    (for ((remaining n (- remaining 1))) :while (> remaining 0)
      (let k = (- remaining 1))
      (let acc = (cell:new (arr:aref w k)))
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (cell:write! acc (- (cell:read acc) (* (arr:aref lv q) (arr:aref w (arr:aref lr q))))))
      (unless (inline (finite? (cell:read acc))) (return SolveNonFiniteResult))
      (arr:set! w k (cell:read acc)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! out (arr:aref perm k) (arr:aref w k)))
    SolveSuccess)

  (declare skipped-null-vector! (Symbolic * UFix * arr:LispArray F64 -> NullVectorStatus))
  (define (skipped-null-vector! symbolic index out)
    "For a skipped index, in original numbering, write the vector v with v[index] = 1, zeros at the other skipped indices and at the kept indices eliminated after it, and M v zero at the kept indices eliminated before it, M being the matrix factored. See docs/skipping.md."
    (let s = (symbolic-storage symbolic))
    (let factor = (.numeric s))
    (unless (skipping-ready? factor) (return NullVectorNoFactor))
    (let f = (numeric-storage factor))
    (let n = (.size f))
    (unless (== (arr:length out) n) (return NullVectorBadSize))
    (let perm = (.permutation f))
    (let lp = (.columns f))
    (let lr = (.rows f))
    (let lv = (.entries f))
    (let d = (.diagonal f))
    (let w = (.scratch f))
    (let at = (cell:new n))
    (for ((k 0 (+ k 1))) :while (< k n)
      (when (and (== (arr:aref perm k) index) (== (arr:aref d k) 0.0d0))
        (cell:write! at k)))
    (let k = (cell:read at))
    (when (== k n) (return NullVectorNotSkipped))
    ;; Row k of L, which the columns before k hold, is the right-hand side: with S the kept
    ;; indices before k, M[S,S] y = M[S,k] is L[S,S]^T y = L[k,S]^T, one substitution from the
    ;; last kept index up. A skipped column is empty, so its entry of the row is already zero.
    (for ((j 0 (+ j 1))) :while (< j k)
      (arr:set! w j 0.0d0))
    (for ((r (arr:aref (.row-columns s) k) (+ r 1)))
        :while (< r (arr:aref (.row-columns s) (+ k 1)))
      (arr:set! w (arr:aref (.row-owners s) r) (arr:aref lv (arr:aref (.row-positions s) r))))
    (for ((remaining k (- remaining 1))) :while (> remaining 0)
      (let j = (- remaining 1))
      (let acc = (cell:new (arr:aref w j)))
      (for ((q (arr:aref lp j) (+ q 1)))
          :while (and (< q (arr:aref lp (+ j 1))) (< (arr:aref lr q) k))
        (cell:write! acc (- (cell:read acc) (* (arr:aref lv q) (arr:aref w (arr:aref lr q))))))
      (unless (inline (finite? (cell:read acc))) (return NullVectorNonFinite))
      (arr:set! w j (cell:read acc)))
    (for ((i 0 (+ i 1))) :while (< i n)
      (arr:set! out i 0.0d0))
    (for ((j 0 (+ j 1))) :while (< j k)
      (arr:set! out (arr:aref perm j) (- 0.0d0 (arr:aref w j))))
    (arr:set! out index 1.0d0)
    NullVectorSuccess)

  (derive Eq)
  (repr :enum)
  (define-type ConditionStatus
    "Outcome of an inverse-norm estimate; distinct from factor and solve outcomes."
    ConditionSuccess
    "An estimate stands."
    ConditionInvalidFactor
    "No solving factor stands."
    ConditionNonFiniteResult
    "A solve inside the estimate was not finite.")

  (declare maximum-estimate-steps UFix)
  (define maximum-estimate-steps 5)

  (declare maximum-estimate-solves UFix)
  (define maximum-estimate-solves
    "Upper bound on the solves one estimate makes: two a step, and one for the alternating probe."
    (+ (* 2 maximum-estimate-steps) 1))

  (declare inverse-norm1-estimate (NumericFactor -> F64))
  (define (inverse-norm1-estimate factor)
    "Latest successful estimate for the factor as it now stands, or -1 when none stands."
    (arr:aref (.estimate (numeric-storage factor)) 0))

  (declare estimate-solve-count (NumericFactor -> UFix))
  (define (estimate-solve-count factor)
    "Solves made by the latest estimate call, counting one that was refused."
    (arr:aref (.state (numeric-storage factor)) 1))

  (declare counted-solve! (NumericFactor * NumericFactorStorage * arr:LispArray F64 * arr:LispArray F64 -> Boolean))
  (define (counted-solve! factor f b out)
    (arr:set! (.state f) 1 (+ (arr:aref (.state f) 1) 1))
    (== (solve! factor b out) SolveSuccess))

  (declare absolute-sum (arr:LispArray F64 -> F64))
  (define (absolute-sum vector)
    (let total = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i (arr:length vector))
      (cell:write! total (+ (cell:read total) (abs (arr:aref vector i)))))
    (cell:read total))

  (declare estimate-inverse-norm1! (NumericFactor -> ConditionStatus))
  (define (estimate-inverse-norm1! factor)
    "Estimate the 1-norm of the inverse of the factored matrix from below, by solves alone. See docs/condition.md."
    (let f = (numeric-storage factor))
    (arr:set! (.estimate f) 0 -1.0d0)
    (arr:set! (.state f) 1 0)
    (unless (factor-ready? factor) (return ConditionInvalidFactor))
    (let n = (.size f))
    (when (== n 0)
      (arr:set! (.estimate f) 0 0.0d0)
      (return ConditionSuccess))
    (let x = (.probe f))
    (let y = (.image f))
    (let count = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i n)
      (cell:write! count (+ (cell:read count) 1.0d0)))
    (for ((i 0 (+ i 1))) :while (< i n)
      (arr:set! x i (/ 1.0d0 (cell:read count))))
    (let best = (cell:new 0.0d0))
    (let previous = (cell:new n))
    ;; Maximize the convex function |inverse(M) x|_1 over the unit 1-norm ball: each step moves
    ;; to the vertex its subgradient favours, and stops where no vertex promises an increase.
    (for ((step 0 (+ step 1))) :while (< step maximum-estimate-steps)
      (unless (counted-solve! factor f x y) (return ConditionNonFiniteResult))
      (let norm = (absolute-sum y))
      (unless (inline (finite? norm)) (return ConditionNonFiniteResult))
      (when (and (> step 0) (<= norm (cell:read best))) (break))
      (cell:write! best norm)
      (for ((i 0 (+ i 1))) :while (< i n)
        (arr:set! y i (if (< (arr:aref y i) 0.0d0) -1.0d0 1.0d0)))
      ;; M is symmetric, so the subgradient inverse(M)^T sign(y) is one more solve.
      (unless (counted-solve! factor f y y) (return ConditionNonFiniteResult))
      (let along = (cell:new 0.0d0))
      (let largest = (cell:new 0.0d0))
      (let at = (cell:new (the UFix 0)))
      (for ((i 0 (+ i 1))) :while (< i n)
        (let z = (arr:aref y i))
        (cell:write! along (+ (cell:read along) (* z (arr:aref x i))))
        (when (> (abs z) (cell:read largest))
          (cell:write! largest (abs z))
          (cell:write! at i)))
      (unless (inline (finite? (cell:read along))) (return ConditionNonFiniteResult))
      (when (or (<= (cell:read largest) (cell:read along))
                (== (cell:read at) (cell:read previous)))
        (break))
      (for ((i 0 (+ i 1))) :while (< i n) (arr:set! x i 0.0d0))
      (arr:set! x (cell:read at) 1.0d0)
      (cell:write! previous (cell:read at)))
    ;; Any vector b bounds the norm from below by |inverse(M) b|_1 / |b|_1. This one alternates
    ;; in sign and grows from 1 to 2, so |b|_1 = 3n/2; it catches a start the ascent cannot leave.
    (when (> n 1)
      (let sign = (cell:new 1.0d0))
      (let position = (cell:new 0.0d0))
      (for ((i 0 (+ i 1))) :while (< i n)
        (arr:set! x i (* (cell:read sign)
                         (+ 1.0d0 (/ (cell:read position) (- (cell:read count) 1.0d0)))))
        (cell:write! sign (- 0.0d0 (cell:read sign)))
        (cell:write! position (+ (cell:read position) 1.0d0)))
      (unless (counted-solve! factor f x y) (return ConditionNonFiniteResult))
      (let alternate = (/ (* 2.0d0 (absolute-sum y)) (* 3.0d0 (cell:read count))))
      (unless (inline (finite? alternate)) (return ConditionNonFiniteResult))
      (when (> alternate (cell:read best)) (cell:write! best alternate)))
    (arr:set! (.estimate f) 0 (cell:read best))
    ConditionSuccess)

  (declare shifted-norm1 (Symbolic * arr:LispArray F64 * F64 -> F64))
  (define (shifted-norm1 symbolic values shift)
    "The 1-norm of the symmetric matrix A - shift I, from values in the analyzed lower CSC order."
    (let s = (symbolic-storage symbolic))
    (let f = (numeric-storage (.numeric s)))
    (unless (== (arr:length values) (.input-count s))
      (throw (err:InvalidDimensions "Value count differs from the analyzed pattern.")))
    (unless (inline (finite? shift))
      (throw (err:NonFiniteInput "Shift must be finite.")))
    (for ((q 0 (+ q 1))) :while (< q (arr:length values))
      (unless (inline (finite? (arr:aref values q)))
        (throw (err:NonFiniteInput "Matrix values must be finite."))))
    (let n = (.size f))
    (let w = (.scratch f))
    (for ((i 0 (+ i 1))) :while (< i n) (arr:set! w i 0.0d0))
    ;; Each stored lower entry counts toward its own column and, off the diagonal, its mirror's.
    (for ((k 0 (+ k 1))) :while (< k n)
      (for ((q (arr:aref (.input-columns s) k) (+ q 1)))
          :while (< q (arr:aref (.input-columns s) (+ k 1)))
        (let v = (arr:aref values (arr:aref (.input-indices s) q)))
        (let row = (arr:aref (.input-rows s) q))
        (cond
          ((== row k) (arr:set! w k (+ (arr:aref w k) (abs (- v shift)))))
          (True
           (arr:set! w k (+ (arr:aref w k) (abs v)))
           (arr:set! w row (+ (arr:aref w row) (abs v)))))))
    (let largest = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i n)
      (when (> (arr:aref w i) (cell:read largest)) (cell:write! largest (arr:aref w i))))
    (unless (inline (finite? (cell:read largest)))
      (throw (err:NonFiniteResult "Matrix norm is not finite.")))
    (cell:read largest))

  (declare reciprocal-condition1 (F64 * F64 -> F64))
  (define (reciprocal-condition1 norm inverse-norm)
    "1 / (norm * inverse-norm) when that product is positive and finite; 1 for two zeros, the empty matrix; otherwise 0."
    (let product = (* norm inverse-norm))
    (cond
      ((and (== norm 0.0d0) (== inverse-norm 0.0d0)) 1.0d0)
      ((and (> product 0.0d0) (inline (finite? product))) (/ 1.0d0 product))
      (True 0.0d0)))
)
