(cl:defpackage #:coalton-linalg/sparse/spd-ldlt
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:csc #:coalton-linalg/sparse/csc))
  (:import-from #:coalton-linalg/numeric #:finite?)
  (:export #:Pattern #:Symbolic #:NumericFactor #:FactorResult
           #:FactorStatus #:FactorSuccess #:FactorNonPositive #:FactorNonFinite #:FactorBadValues #:FactorBadShift
           #:SolveStatus #:SolveSuccess #:SolveInvalidFactor #:SolveBadSize #:SolveNonFiniteRhs #:SolveNonFiniteResult
           #:analyse #:analyse-csc #:factor! #:solve! #:factor-status #:result-column #:result-factor
           #:symbolic-factor #:factor-permutation #:factor-columns #:factor-rows
           #:factor-values #:factor-diagonal #:factor-ready?))
(cl:in-package #:coalton-linalg/sparse/spd-ldlt)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

(coalton-toplevel
  (define-struct Pattern
    "Lower CSC structure. Each column starts with its diagonal; rows strictly increase."
    (size UFix)
    (columns (arr:LispArray UFix))
    (rows (arr:LispArray UFix)))

  (define-struct NumericFactorStorage
    "Borrowed mutable factor; invalidated by every factor call on its owning Symbolic."
    (size UFix)
    (permutation (arr:LispArray UFix))
    (columns (arr:LispArray UFix))
    (rows (arr:LispArray UFix))
    (entries (arr:LispArray F64))
    (diagonal (arr:LispArray F64))
    (scratch (arr:LispArray F64))
    (state (arr:LispArray UFix)))

  (define-type NumericFactor
    "Borrowed factor handle; construction and workspace fields are private."
    (MkNumericFactor NumericFactorStorage))

  (inline)
  (declare numeric-storage (NumericFactor -> NumericFactorStorage))
  (define (numeric-storage factor) (match factor ((MkNumericFactor storage) storage)))

  (derive Eq)
  (repr :enum)
  (define-type FactorStatus
    "Outcome of a factorization call; independent of later workspace validity."
    FactorSuccess FactorNonPositive FactorNonFinite FactorBadValues FactorBadShift)

  (derive Eq)
  (repr :enum)
  (define-type SolveStatus
    "Outcome of a solve call; distinct from factorization outcomes."
    SolveSuccess SolveInvalidFactor SolveBadSize SolveNonFiniteRhs SolveNonFiniteResult)

  (define-type ResultStorage
    (Success NumericFactor)
    (NonPositive UFix)
    (NonFinite UFix)
    BadValues
    BadShift)

  (repr :native cl:t)
  (define-type FactorResult
    "Opaque preallocated outcome handle; the ABI must preserve its identity.")

  (inline)
  (abi :lisp)
  (declare wrap-result (ResultStorage -> FactorResult))
  (define (wrap-result r) (lisp (-> FactorResult) (r) r))
  (inline)
  (abi :lisp)
  (declare unwrap-result (FactorResult -> ResultStorage))
  (define (unwrap-result r) (lisp (-> ResultStorage) (r) r))

  (define-struct SymbolicStorage
    "Owns one reusable factor, input scatter, row incidence and cached result objects."
    (numeric NumericFactor)
    (input-count UFix)
    (input-columns (arr:LispArray UFix))
    (input-rows (arr:LispArray UFix))
    (input-indices (arr:LispArray UFix))
    (row-columns (arr:LispArray UFix))
    (row-owners (arr:LispArray UFix))
    (row-positions (arr:LispArray UFix))
    (success FactorResult)
    (nonpositive (arr:LispArray FactorResult))
    (nonfinite (arr:LispArray FactorResult)))

  (define-type Symbolic
    "Analysis handle owning one reusable factor and private workspace."
    (MkSymbolic SymbolicStorage))

  (inline)
  (declare symbolic-storage (Symbolic -> SymbolicStorage))
  (define (symbolic-storage symbolic) (match symbolic ((MkSymbolic storage) storage)))

  (declare factor-status (FactorResult -> FactorStatus))
  (define (factor-status r)
    "Return the outcome of this call; an earlier success does not certify current factor readiness."
    (match (unwrap-result r)
      ((Success _) FactorSuccess)
      ((NonPositive _) FactorNonPositive)
      ((NonFinite _) FactorNonFinite)
      ((BadValues) FactorBadValues)
      ((BadShift) FactorBadShift)))
  (declare result-column (FactorResult -> IFix))
  (define (result-column r)
    (match (unwrap-result r) ((NonPositive k) (into k)) ((NonFinite k) (into k)) (_ -1)))
  (abi :lisp)
  (declare result-factor (FactorResult -> NumericFactor))
  (define (result-factor r)
    (match (unwrap-result r)
      ((Success f) f)
      (_ (lisp (-> NumericFactor) () (cl:error "Result is a refusal, not a factor.")))))
  (abi :lisp)
  (declare symbolic-factor (Symbolic -> NumericFactor))
  (define (symbolic-factor s) (.numeric (symbolic-storage s)))
  (declare factor-permutation (NumericFactor -> arr:LispArray UFix))
  (define (factor-permutation f) (.permutation (numeric-storage f)))
  (declare factor-columns (NumericFactor -> arr:LispArray UFix))
  (define (factor-columns f) (.columns (numeric-storage f)))
  (declare factor-rows (NumericFactor -> arr:LispArray UFix))
  (define (factor-rows f) (.rows (numeric-storage f)))
  (declare factor-values (NumericFactor -> arr:LispArray F64))
  (define (factor-values f) (.entries (numeric-storage f)))
  (declare factor-diagonal (NumericFactor -> arr:LispArray F64))
  (define (factor-diagonal f) (.diagonal (numeric-storage f)))
  (declare factor-ready? (NumericFactor -> Boolean))
  (define (factor-ready? f) (== (arr:aref (.state (numeric-storage f)) 0) 1))

  (declare validate-pattern (Pattern -> Void))
  (define (validate-pattern p)
    (let n = (.size p))
    (let cp = (.columns p))
    (let ri = (.rows p))
    (unless (and (== (arr:length cp) (+ n 1))
                 (== (arr:aref cp 0) 0)
                 (== (arr:aref cp n) (arr:length ri)))
      (lisp (-> Void) () (cl:error "Invalid CSC column pointers.")))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let start = (arr:aref cp k))
      (let end = (arr:aref cp (+ k 1)))
      (unless (and (< start end) (<= end (arr:length ri))
                   (== (arr:aref ri start) k))
        (lisp (-> Void) () (cl:error "CSC column must begin with its diagonal.")))
      (for ((q (+ start 1) (+ q 1))) :while (< q end)
        (unless (and (< (arr:aref ri (- q 1)) (arr:aref ri q))
                     (< (arr:aref ri q) n))
          (lisp (-> Void) () (cl:error "CSC rows must strictly increase below the diagonal."))))))

  (declare sort-indices! (arr:LispArray UFix -> Void))
  (define (sort-indices! a)
    (lisp (-> Void) (a) (cl:sort a #'cl:<) (cl:values)))

  (declare analyse-csc (csc:Matrix -> Symbolic))
  (define (analyse-csc matrix)
    "Analyse checked square lower CSC with diagonals; numeric values remain caller-supplied."
    (unless (== (csc:row-count matrix) (csc:column-count matrix))
      (lisp (-> Void) () (cl:error "SPD analysis requires a square matrix.")))
    (analyse (Pattern (csc:row-count matrix)
                      (csc:column-pointers matrix) (csc:row-indices matrix))))
  (declare analyse (Pattern -> Symbolic))
  (define (analyse pattern)
    "Validate and own the pattern. Analysis allocates; factor and solve reuse its storage."
    (validate-pattern pattern)
    (let n = (.size pattern))
    (let cp = (.columns pattern))
    (let ri = (.rows pattern))
    (let nnz = (arr:length ri))
    (let graph = (arr:make (* n n) (the U8 0)))
    (let alive = (arr:make n (the U8 1)))
    (let degree = (arr:make n (the UFix 0)))
    (let perm = (arr:make n (the UFix 0)))
    (let inverse = (arr:make n (the UFix 0)))
    (let neighbors = (arr:make n (arr:make 0 (the UFix 0))))
    (for ((j 0 (+ j 1))) :while (< j n)
      (for ((q (+ (arr:aref cp j) 1) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (let i = (arr:aref ri q))
        (arr:set! graph (+ (* n i) j) 1)
        (arr:set! graph (+ (* n j) i) 1)
        (arr:set! degree i (+ 1 (arr:aref degree i)))
        (arr:set! degree j (+ 1 (arr:aref degree j)))))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let chosen = (cell:new n))
      (let best = (cell:new (+ n 1)))
      (for ((i 0 (+ i 1))) :while (< i n)
        (when (and (== (arr:aref alive i) 1) (< (arr:aref degree i) (cell:read best)))
          (cell:write! chosen i)
          (cell:write! best (arr:aref degree i))))
      (let v = (cell:read chosen))
      (let adj = (arr:make (cell:read best) (the UFix 0)))
      (let count = (cell:new (the UFix 0)))
      (for ((i 0 (+ i 1))) :while (< i n)
        (when (and (== (arr:aref alive i) 1) (== (arr:aref graph (+ (* n v) i)) 1))
          (arr:set! adj (cell:read count) i)
          (cell:write! count (+ 1 (cell:read count)))))
      (arr:set! perm k v)
      (arr:set! inverse v k)
      (arr:set! neighbors k adj)
      (arr:set! alive v 0)
      (for ((a 0 (+ a 1))) :while (< a (arr:length adj))
        (let i = (arr:aref adj a))
        (arr:set! degree i (- (arr:aref degree i) 1))
        (for ((b (+ a 1) (+ b 1))) :while (< b (arr:length adj))
          (let j = (arr:aref adj b))
          (when (== (arr:aref graph (+ (* n i) j)) 0)
            (arr:set! graph (+ (* n i) j) 1)
            (arr:set! graph (+ (* n j) i) 1)
            (arr:set! degree i (+ (arr:aref degree i) 1))
            (arr:set! degree j (+ (arr:aref degree j) 1))))))
    (let lp = (arr:make (+ n 1) (the UFix 0)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let adj = (arr:aref neighbors k))
      (for ((q 0 (+ q 1))) :while (< q (arr:length adj))
        (arr:set! adj q (arr:aref inverse (arr:aref adj q))))
      (sort-indices! adj)
      (arr:set! lp (+ k 1) (+ (arr:aref lp k) (arr:length adj))))
    (let nzl = (arr:aref lp n))
    (let lr = (arr:make nzl (the UFix 0)))
    (let rp = (arr:make (+ n 1) (the UFix 0)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let adj = (arr:aref neighbors k))
      (for ((q 0 (+ q 1))) :while (< q (arr:length adj))
        (let i = (arr:aref adj q))
        (arr:set! lr (+ (arr:aref lp k) q) i)
        (arr:set! rp (+ i 1) (+ (arr:aref rp (+ i 1)) 1))))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! rp (+ k 1) (+ (arr:aref rp k) (arr:aref rp (+ k 1)))))
    (let rc = (arr:make nzl (the UFix 0)))
    (let rq = (arr:make nzl (the UFix 0)))
    (let next = (arr:copy rp))
    (for ((k 0 (+ k 1))) :while (< k n)
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (let i = (arr:aref lr q))
        (let slot = (arr:aref next i))
        (arr:set! rc slot k)
        (arr:set! rq slot q)
        (arr:set! next i (+ slot 1))))
    (let ap = (arr:make (+ n 1) (the UFix 0)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let pj = (arr:aref inverse j))
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (let pi = (arr:aref inverse (arr:aref ri q)))
        (let k = (if (< pi pj) pi pj))
        (arr:set! ap (+ k 1) (+ (arr:aref ap (+ k 1)) 1))))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! ap (+ k 1) (+ (arr:aref ap k) (arr:aref ap (+ k 1)))))
    (let ar = (arr:make nnz (the UFix 0)))
    (let ai = (arr:make nnz (the UFix 0)))
    (let cursor = (arr:copy ap))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let pj = (arr:aref inverse j))
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (let pi = (arr:aref inverse (arr:aref ri q)))
        (let k = (if (< pi pj) pi pj))
        (let row = (if (< pi pj) pj pi))
        (let slot = (arr:aref cursor k))
        (arr:set! ar slot row)
        (arr:set! ai slot q)
        (arr:set! cursor k (+ slot 1))))
    (let f = (MkNumericFactor (NumericFactorStorage n perm lp lr (arr:make nzl 0.0d0) (arr:make n 0.0d0)
                    (arr:make n 0.0d0) (arr:make 1 (the UFix 0)))))
    (let np = (arr:make n (wrap-result (NonPositive 0))))
    (let nf = (arr:make n (wrap-result (NonFinite 0))))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! np k (wrap-result (NonPositive (arr:aref perm k))))
      (arr:set! nf k (wrap-result (NonFinite (arr:aref perm k)))))
    (MkSymbolic (SymbolicStorage f nnz ap ar ai rp rc rq (wrap-result (Success f)) np nf)))

  (declare factor! (Symbolic * arr:LispArray F64 * F64 -> FactorResult))
  (define (factor! symbolic values shift)
    "Overwrite the owned factor. A refusal invalidates it. Values use the analysed CSC order."
    (let s = (symbolic-storage symbolic))
    (let f = (numeric-storage (.numeric s)))
    (arr:set! (.state f) 0 0)
    (unless (== (arr:length values) (.input-count s)) (return (wrap-result BadValues)))
    (unless (finite? shift) (return (wrap-result BadShift)))
    (let n = (.size f))
    (let lp = (.columns f))
    (let lr = (.rows f))
    (let lv = (.entries f))
    (let d = (.diagonal f))
    (let w = (.scratch f))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! w k 0.0d0)
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (arr:set! w (arr:aref lr q) 0.0d0))
      (for ((q (arr:aref (.input-columns s) k) (+ q 1)))
          :while (< q (arr:aref (.input-columns s) (+ k 1)))
        (let v = (arr:aref values (arr:aref (.input-indices s) q)))
        (unless (finite? v) (return (arr:aref (.nonfinite s) k)))
        (arr:set! w (arr:aref (.input-rows s) q) v))
      (arr:set! w k (- (arr:aref w k) shift))
      (for ((r (arr:aref (.row-columns s) k) (+ r 1)))
          :while (< r (arr:aref (.row-columns s) (+ k 1)))
        (let j = (arr:aref (.row-owners s) r))
        (let at-k = (arr:aref (.row-positions s) r))
        (let multiplier = (* (arr:aref lv at-k) (arr:aref d j)))
        (for ((q at-k (+ q 1))) :while (< q (arr:aref lp (+ j 1)))
          (let i = (arr:aref lr q))
          (arr:set! w i (- (arr:aref w i) (* multiplier (arr:aref lv q))))))
      (let pivot = (arr:aref w k))
      (unless (finite? pivot) (return (arr:aref (.nonfinite s) k)))
      (unless (> pivot 0.0d0) (return (arr:aref (.nonpositive s) k)))
      (arr:set! d k pivot)
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (let v = (/ (arr:aref w (arr:aref lr q)) pivot))
        (unless (finite? v) (return (arr:aref (.nonfinite s) k)))
        (arr:set! lv q v)))
    (arr:set! (.state f) 0 1)
    (.success s))

  (declare solve! (NumericFactor * arr:LispArray F64 * arr:LispArray F64 -> SolveStatus))
  (define (solve! factor b out)
    "Solve into out on success; return a named outcome and preserve out on refusal."
    (unless (factor-ready? factor) (return SolveInvalidFactor))
    (let f = (numeric-storage factor))
    (let n = (.size f))
    (unless (and (== (arr:length b) n) (== (arr:length out) n)) (return SolveBadSize))
    (let perm = (.permutation f))
    (let lp = (.columns f))
    (let lr = (.rows f))
    (let lv = (.entries f))
    (let d = (.diagonal f))
    (let w = (.scratch f))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref b (arr:aref perm k)))
      (unless (finite? v) (return SolveNonFiniteRhs))
      (arr:set! w k v))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref w k))
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (let i = (arr:aref lr q))
        (arr:set! w i (- (arr:aref w i) (* (arr:aref lv q) v)))))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (/ (arr:aref w k) (arr:aref d k)))
      (unless (finite? v) (return SolveNonFiniteResult))
      (arr:set! w k v))
    (for ((remaining n (- remaining 1))) :while (> remaining 0)
      (let k = (- remaining 1))
      (let acc = (cell:new (arr:aref w k)))
      (for ((q (arr:aref lp k) (+ q 1))) :while (< q (arr:aref lp (+ k 1)))
        (cell:write! acc (- (cell:read acc) (* (arr:aref lv q) (arr:aref w (arr:aref lr q))))))
      (unless (finite? (cell:read acc)) (return SolveNonFiniteResult))
      (arr:set! w k (cell:read acc)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (arr:set! out (arr:aref perm k) (arr:aref w k)))
    SolveSuccess)
)
