(cl:defpackage #:coalton-linalg/sparse/csc
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:err #:coalton-linalg/errors))
  (:import-from #:coalton/math #:finite?)
  (:export #:Matrix #:DuplicatePolicy #:RejectDuplicates #:SumDuplicates
           #:from-csc #:from-coo #:row-count #:column-count #:entry-count
           #:column-pointers #:row-indices #:entries
           #:transpose #:permute #:matvec #:transpose-matvec
           #:matvec! #:transpose-matvec!))
(cl:in-package #:coalton-linalg/sparse/csc)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

(coalton-toplevel
  (define-type Matrix
    "Owned canonical rectangular CSC. Inspection arrays are borrowed read-only views."
    (MkMatrix UFix UFix (arr:LispArray UFix) (arr:LispArray UFix) (arr:LispArray F64)))

  (define-type DuplicatePolicy
    "What from-coo does with a repeated coordinate."
    RejectDuplicates
    "Raise DuplicateEntry naming the coordinate."
    SumDuplicates
    "Add the values in their given order.")

  (declare row-count (Matrix -> UFix))
  (define (row-count matrix)
    "Number of rows."
    (match matrix ((MkMatrix m _ _ _ _) m)))
  (declare column-count (Matrix -> UFix))
  (define (column-count matrix)
    "Number of columns."
    (match matrix ((MkMatrix _ n _ _ _) n)))
  (declare column-pointers (Matrix -> arr:LispArray UFix))
  (define (column-pointers matrix)
    "Borrowed view: where each column starts in the row indices and entries, one more than the columns long."
    (match matrix ((MkMatrix _ _ cp _ _) cp)))
  (declare row-indices (Matrix -> arr:LispArray UFix))
  (define (row-indices matrix)
    "Borrowed view: the row of each stored entry, strictly increasing within a column."
    (match matrix ((MkMatrix _ _ _ ri _) ri)))
  (declare entries (Matrix -> arr:LispArray F64))
  (define (entries matrix)
    "Borrowed view: the value of each stored entry, in the order of the row indices."
    (match matrix ((MkMatrix _ _ _ _ vals) vals)))
  (declare entry-count (Matrix -> UFix))
  (define (entry-count matrix)
    "Number of stored entries, explicit zeros included."
    (arr:length (row-indices matrix)))

  (declare from-csc (UFix * UFix * arr:LispArray UFix * arr:LispArray UFix * arr:LispArray F64 -> Matrix))
  (define (from-csc m n cp ri vals)
    "Validate and copy canonical CSC, retaining all stored zeros; see docs/primitives.md."
    (unless (and (< n (arr:length cp)) (== (arr:length cp) (+ n 1))
                 (== (arr:length ri) (arr:length vals))
                 (== (arr:aref cp 0) 0) (== (arr:aref cp n) (arr:length ri)))
      (throw (err:InvalidStructure "Invalid CSC array lengths or endpoints.")))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let start = (arr:aref cp j))
      (let end = (arr:aref cp (+ j 1)))
      (unless (and (<= start end) (<= end (arr:length ri)))
        (throw (err:InvalidStructure "CSC column pointers must be monotone and in range.")))
      (for ((q start (+ q 1))) :while (< q end)
        (unless (< (arr:aref ri q) m)
          (throw (err:InvalidStructure "CSC row is out of range.")))
        (when (> q start)
          (when (== (arr:aref ri (- q 1)) (arr:aref ri q))
            (throw (err:DuplicateEntry (arr:aref ri q) j)))
          (when (> (arr:aref ri (- q 1)) (arr:aref ri q))
            (throw (err:InvalidStructure "CSC rows must increase in each column."))))
        (unless (finite? (arr:aref vals q))
          (throw (err:NonFiniteInput "Matrix values must be finite.")))))
    (MkMatrix m n (arr:copy cp) (arr:copy ri) (arr:copy vals)))

  (declare coordinate-order (arr:LispArray UFix * arr:LispArray UFix -> arr:LispArray UFix))
  (define (coordinate-order rows columns)
    "Stable merge order by column then row; equal coordinates retain original order."
    (let count = (arr:length rows))
    (let order = (arr:make count (the UFix 0)))
    (let scratch = (arr:make count (the UFix 0)))
    (for ((i 0 (+ i 1))) :while (< i count) (arr:set! order i i))
    (for ((width 1 (* width 2))) :while (< width count)
      (for ((start 0 (+ start (* width 2)))) :while (< start count)
        (let middle = (min (+ start width) count))
        (let end = (min (+ middle width) count))
        (let left = (cell:new start))
        (let right = (cell:new middle))
        (for ((at start (+ at 1))) :while (< at end)
          (let take-left =
            (cond
              ((>= (cell:read right) end) True)
              ((>= (cell:read left) middle) False)
              (True
               (let ((a (arr:aref order (cell:read left)))
                     (b (arr:aref order (cell:read right))))
                 (or (< (arr:aref columns a) (arr:aref columns b))
                     (and (== (arr:aref columns a) (arr:aref columns b))
                          (<= (arr:aref rows a) (arr:aref rows b))))))))
          (cond
            (take-left
             (arr:set! scratch at (arr:aref order (cell:read left)))
             (cell:write! left (+ (cell:read left) 1)))
            (True
             (arr:set! scratch at (arr:aref order (cell:read right)))
             (cell:write! right (+ (cell:read right) 1))))))
      (for ((i 0 (+ i 1))) :while (< i count) (arr:set! order i (arr:aref scratch i))))
    order)

  (declare from-coo (UFix * UFix * arr:LispArray UFix * arr:LispArray UFix * arr:LispArray F64 * DuplicatePolicy -> Matrix))
  (define (from-coo m n rows columns entries duplicate-policy)
    "Own sorted CSC from COO; duplicates reject or sum in original order, retaining zeros."
    (let count = (arr:length rows))
    (unless (and (== (arr:length columns) count) (== (arr:length entries) count))
      (throw (err:InvalidStructure "COO array lengths differ.")))
    (for ((i 0 (+ i 1))) :while (< i count)
      (unless (and (< (arr:aref rows i) m) (< (arr:aref columns i) n))
        (throw (err:InvalidStructure "COO coordinate is out of range.")))
      (unless (finite? (arr:aref entries i))
        (throw (err:NonFiniteInput "Matrix values must be finite."))))
    (let order = (coordinate-order rows columns))
    (let cp = (arr:make (+ n 1) (the UFix 0)))
    (let merged-rows = (arr:make count (the UFix 0)))
    (let merged-values = (arr:make count 0.0d0))
    (let used = (cell:new (the UFix 0)))
    (let position = (cell:new (the UFix 0)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (for () :while (and (< (cell:read position) count)
                         (== (arr:aref columns (arr:aref order (cell:read position))) j))
        (let first = (arr:aref order (cell:read position)))
        (let row = (arr:aref rows first))
        (let total = (cell:new (arr:aref entries first)))
        (cell:write! position (+ (cell:read position) 1))
        (for () :while (and (< (cell:read position) count)
                           (let ((index (arr:aref order (cell:read position))))
                             (and (== (arr:aref columns index) j)
                                  (== (arr:aref rows index) row))))
          (when (match duplicate-policy ((RejectDuplicates) True) ((SumDuplicates) False))
            (throw (err:DuplicateEntry row j)))
          (let next = (+ (cell:read total) (arr:aref entries (arr:aref order (cell:read position)))))
          (unless (finite? next)
            (throw (err:NonFiniteResult "Duplicate sum is not finite.")))
          (cell:write! total next)
          (cell:write! position (+ (cell:read position) 1)))
        (arr:set! merged-rows (cell:read used) row)
        (arr:set! merged-values (cell:read used) (cell:read total))
        (cell:write! used (+ (cell:read used) 1)))
      (arr:set! cp (+ j 1) (cell:read used)))
    (let ri = (arr:make (cell:read used) (the UFix 0)))
    (let vals = (arr:make (cell:read used) 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i (cell:read used))
      (arr:set! ri i (arr:aref merged-rows i))
      (arr:set! vals i (arr:aref merged-values i)))
    (MkMatrix m n cp ri vals))

  (declare transpose (Matrix -> Matrix))
  (define (transpose matrix)
    "Return an owned canonical transpose, preserving stored zeros."
    (let m = (row-count matrix))
    (let n = (column-count matrix))
    (let cp = (column-pointers matrix))
    (let ri = (row-indices matrix))
    (let vals = (entries matrix))
    (let tp = (arr:make (+ m 1) (the UFix 0)))
    (let tr = (arr:make (arr:length ri) (the UFix 0)))
    (let tv = (arr:make (arr:length ri) 0.0d0))
    (for ((q 0 (+ q 1))) :while (< q (arr:length ri))
      (let row = (arr:aref ri q))
      (arr:set! tp (+ row 1) (+ 1 (arr:aref tp (+ row 1)))))
    (for ((i 0 (+ i 1))) :while (< i m)
      (arr:set! tp (+ i 1) (+ (arr:aref tp i) (arr:aref tp (+ i 1)))))
    (let cursor = (arr:copy tp))
    (for ((j 0 (+ j 1))) :while (< j n)
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (let row = (arr:aref ri q))
        (let at = (arr:aref cursor row))
        (arr:set! tr at j)
        (arr:set! tv at (arr:aref vals q))
        (arr:set! cursor row (+ at 1))))
    (MkMatrix n m tp tr tv))

  (declare inverse-permutation (UFix * arr:LispArray UFix -> arr:LispArray UFix))
  (define (inverse-permutation size order)
    "Validate a new-to-old bijection and return old-to-new indices."
    (unless (== (arr:length order) size)
      (throw (err:InvalidPermutation "Permutation length differs from dimension.")))
    (let inverse = (arr:make size size))
    (for ((i 0 (+ i 1))) :while (< i size)
      (let old = (arr:aref order i))
      (unless (< old size)
        (throw (err:InvalidPermutation "Permutation index is out of range.")))
      (unless (== (arr:aref inverse old) size)
        (throw (err:InvalidPermutation "Permutation repeats an index.")))
      (arr:set! inverse old i))
    inverse)

  (declare permute (Matrix * arr:LispArray UFix * arr:LispArray UFix -> Matrix))
  (define (permute matrix row-order column-order)
    "Return B[i,j]=A[row-order[i],column-order[j]], with fresh canonical storage."
    (let m = (row-count matrix))
    (let n = (column-count matrix))
    (let row-inverse = (inverse-permutation m row-order))
    (inverse-permutation n column-order)
    (let cp = (column-pointers matrix))
    (let ri = (row-indices matrix))
    (let vals = (entries matrix))
    (let rr = (arr:make (arr:length ri) (the UFix 0)))
    (let cc = (arr:make (arr:length ri) (the UFix 0)))
    (let vv = (arr:make (arr:length ri) 0.0d0))
    (let used = (cell:new (the UFix 0)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let old-column = (arr:aref column-order j))
      (for ((q (arr:aref cp old-column) (+ q 1))) :while (< q (arr:aref cp (+ old-column 1)))
        (arr:set! rr (cell:read used) (arr:aref row-inverse (arr:aref ri q)))
        (arr:set! cc (cell:read used) j)
        (arr:set! vv (cell:read used) (arr:aref vals q))
        (cell:write! used (+ 1 (cell:read used)))))
    (from-coo m n rr cc vv RejectDuplicates))

  (declare validate-product-vector (arr:LispArray F64 -> Void))
  (define (validate-product-vector x)
    "Validate every input component, including those unused by the matrix structure."
    (for ((i 0 (+ i 1))) :while (< i (arr:length x))
      (unless (finite? (arr:aref x i))
        (throw (err:NonFiniteInput "Vector input must be finite.")))))

  (declare multiply-into! (Matrix * arr:LispArray F64 * arr:LispArray F64 * Boolean -> Void))
  (define (multiply-into! matrix x output transposed)
    "Overwrite a checked, nonaliased result in CSC accumulation order; arithmetic refusal leaves it unspecified."
    (let n = (column-count matrix))
    (let cp = (column-pointers matrix))
    (let ri = (row-indices matrix))
    (let vals = (entries matrix))
    (for ((i 0 (+ i 1))) :while (< i (arr:length output))
      (arr:set! output i 0.0d0))
    (for ((j 0 (+ j 1))) :while (< j n)
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (let i = (arr:aref ri q))
        (let target = (if transposed j i))
        (let source = (if transposed i j))
        (arr:set! output target (+ (arr:aref output target)
                                  (* (arr:aref vals q) (arr:aref x source))))))
    (for ((i 0 (+ i 1))) :while (< i (arr:length output))
      (unless (finite? (arr:aref output i))
        (throw (err:NonFiniteResult "Matrix-vector result is not finite.")))))

  (declare multiply (Matrix * arr:LispArray F64 * Boolean -> arr:LispArray F64))
  (define (multiply matrix x transposed)
    "Validate input before allocating the result, then use the shared product kernel."
    (let m = (row-count matrix))
    (let n = (column-count matrix))
    (unless (== (arr:length x) (if transposed m n))
      (throw (err:InvalidDimensions "Matrix-vector dimensions differ.")))
    (validate-product-vector x)
    (let output = (arr:make (if transposed n m) 0.0d0))
    (multiply-into! matrix x output transposed)
    output)

  (declare multiply! (Matrix * arr:LispArray F64 * arr:LispArray F64 * Boolean -> Void))
  (define (multiply! matrix x output transposed)
    "Check dimensions, output identity and input finiteness before the first output write."
    (let m = (row-count matrix))
    (let n = (column-count matrix))
    (unless (and (== (arr:length x) (if transposed m n))
                 (== (arr:length output) (if transposed n m)))
      (throw (err:InvalidDimensions "Matrix-vector dimensions differ.")))
    (when (or (unsafe-pointer-eq? output x)
              (unsafe-pointer-eq? output (entries matrix)))
      (throw (err:InvalidAliasing "Output must be distinct from the vector input and matrix entries.")))
    (validate-product-vector x)
    (multiply-into! matrix x output transposed))

  (declare matvec (Matrix * arr:LispArray F64 -> arr:LispArray F64))
  (define (matvec matrix x)
    "Return A*x; finite inputs and output required, no mutation of matrix or x."
    (multiply matrix x False))

  (declare transpose-matvec (Matrix * arr:LispArray F64 -> arr:LispArray F64))
  (define (transpose-matvec matrix x)
    "Return transpose(A)*x without materializing a transpose; no caller mutation."
    (multiply matrix x True))

  (declare matvec! (Matrix * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (matvec! matrix x output)
    "Overwrite output with A*x. Output must differ from x and matrix entries; preflight errors preserve it, while NonFiniteResult leaves it unspecified."
    (multiply! matrix x output False))

  (declare transpose-matvec! (Matrix * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (transpose-matvec! matrix x output)
    "Overwrite output with transpose(A)*x. Output must differ from x and matrix entries; preflight errors preserve it, while NonFiniteResult leaves it unspecified."
    (multiply! matrix x output True))

  (declare check-same-pattern! (Matrix * UFix * UFix * arr:LispArray UFix * arr:LispArray UFix -> Void))
  (define (check-same-pattern! matrix expected-m expected-n expected-cp expected-ri)
    "Raise InvalidDimensions or InvalidStructure unless matrix has the expected dimensions, column pointers and row indices."
    (unless (and (== (row-count matrix) expected-m)
                 (== (column-count matrix) expected-n))
      (throw (err:InvalidDimensions "Source dimensions differ from the analyzed matrix.")))
    (let actual-cp = (column-pointers matrix))
    (let actual-ri = (row-indices matrix))
    (unless (and (== (arr:length actual-cp) (arr:length expected-cp))
                 (== (arr:length actual-ri) (arr:length expected-ri)))
      (throw (err:InvalidStructure "Source pattern differs from the analyzed matrix.")))
    (for ((q 0 (+ q 1))) :while (< q (arr:length expected-cp))
      (unless (== (arr:aref actual-cp q) (arr:aref expected-cp q))
        (throw (err:InvalidStructure "Source column pointers differ from the analyzed matrix."))))
    (for ((q 0 (+ q 1))) :while (< q (arr:length expected-ri))
      (unless (== (arr:aref actual-ri q) (arr:aref expected-ri q))
        (throw (err:InvalidStructure "Source row indices differ from the analyzed matrix."))))))
