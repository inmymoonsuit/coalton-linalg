(cl:defpackage #:coalton-linalg/sparse/gram
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:math #:coalton/math)
                    (#:csc #:coalton-linalg/sparse/csc)
                    (#:limits #:coalton-linalg/sparse/limits)
                    (#:err #:coalton-linalg/errors))
  (:export #:GramPlan #:analyze-ata #:analyze-aat
           #:analyze-ata-with-limit #:analyze-aat-with-limit
           #:dimension #:column-pointers #:row-indices #:entry-count
           #:refill! #:refill-csc! #:default-analysis-entry-limit #:maximum-analysis-size))
(cl:in-package #:coalton-linalg/sparse/gram)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

(coalton-toplevel
  (define-struct GramPlanStorage
    "Owns the source pattern, lower Gram pattern, compressed incidence and mutable scatter workspace."
    (source-m UFix)
    (source-n UFix)
    (source-columns (arr:LispArray UFix))
    (source-rows (arr:LispArray UFix))
    (size UFix)
    (columns (arr:LispArray UFix))
    (rows (arr:LispArray UFix))
    (b-columns (arr:LispArray UFix))
    (b-values (arr:LispArray UFix))
    (b-starts (arr:LispArray UFix))
    (b-stops (arr:LispArray UFix))
    (group-columns (arr:LispArray UFix))
    (group-values (arr:LispArray UFix))
    (scatter (arr:LispArray UFix)))

  (repr :transparent)
  (define-type GramPlan
    "Private analysis handle; pattern views are read-only and shared scratch makes refills non-reentrant."
    (MkGramPlan GramPlanStorage))

  (inline)
  (declare plan-storage (GramPlan -> GramPlanStorage))
  (define (plan-storage plan) (match plan ((MkGramPlan storage) storage)))

  (declare dimension (GramPlan -> UFix))
  (define (dimension plan)
    "Order of the Gram matrix."
    (.size (plan-storage plan)))
  (declare column-pointers (GramPlan -> arr:LispArray UFix))
  (define (column-pointers plan)
    "Borrowed view: column pointers of the lower Gram pattern."
    (.columns (plan-storage plan)))
  (declare row-indices (GramPlan -> arr:LispArray UFix))
  (define (row-indices plan)
    "Borrowed view: row indices of the lower Gram pattern, each column beginning with its diagonal."
    (.rows (plan-storage plan)))
  (declare entry-count (GramPlan -> UFix))
  (define (entry-count plan)
    "Number of stored entries of the lower Gram pattern, which is the length of a refill's output."
    (arr:length (.rows (plan-storage plan))))

  (declare maximum-analysis-size UFix)
  (define maximum-analysis-size
    "Largest Gram order an analysis accepts; shared with the factorization's analysis."
    limits:maximum-analysis-size)
  (declare default-analysis-entry-limit UFix)
  (define default-analysis-entry-limit
    "Default budget of stored Gram entries; shared with the factorization's analysis."
    limits:default-analysis-entry-limit)

  (define-struct NormalizedColumns
    "Temporary CSC of B where Gram=B^T B; values are positions in the original source array."
    (bcp (arr:LispArray UFix))
    (inner (arr:LispArray UFix))
    (positions (arr:LispArray UFix)))

  (declare normalized-columns
    (UFix * UFix * arr:LispArray UFix * arr:LispArray UFix * Boolean -> NormalizedColumns))
  (define (normalized-columns m n source-cp source-ri aat)
    "Transpose only when its row count is the already-checked Gram dimension; ATA never indexes by source row number."
    (let count = (arr:length source-ri))
    (let positions = (arr:make count (the UFix 0)))
    (cond
      (aat
       (let ((bcp (arr:make (+ m 1) (the UFix 0)))
             (inner (arr:make count (the UFix 0))))
         (for ((q 0 (+ q 1))) :while (< q count)
           (let row = (arr:aref source-ri q))
           (arr:set! bcp (+ row 1) (+ (arr:aref bcp (+ row 1)) 1)))
         (for ((i 0 (+ i 1))) :while (< i m)
           (arr:set! bcp (+ i 1) (+ (arr:aref bcp i) (arr:aref bcp (+ i 1)))))
         (let cursor = (arr:copy bcp))
         (for ((j 0 (+ j 1))) :while (< j n)
           (for ((q (arr:aref source-cp j) (+ q 1))) :while (< q (arr:aref source-cp (+ j 1)))
             (let row = (arr:aref source-ri q))
             (let at = (arr:aref cursor row))
             (arr:set! inner at j)
             (arr:set! positions at q)
             (arr:set! cursor row (+ at 1))))
         (NormalizedColumns bcp inner positions)))
      (True
       (for ((q 0 (+ q 1))) :while (< q count) (arr:set! positions q q))
       (NormalizedColumns source-cp source-ri positions))))

  (define-struct CompressedGroups
    "Incidence grouped by present inner indices only. For each B position, begins is its group's first sorted position, starts its own and stops its group's exclusive end; owners ascend within a group, so begins to starts holds exactly the owners before its own and starts to stops those at or after it."
    (begins (arr:LispArray UFix))
    (starts (arr:LispArray UFix))
    (stops (arr:LispArray UFix))
    (owners (arr:LispArray UFix))
    (values-at (arr:LispArray UFix)))

  (declare radix UFix)
  (define radix 2048)

  (declare compressed-groups (UFix * NormalizedColumns -> CompressedGroups))
  (define (compressed-groups size normalized)
    "Sort B positions by inner index then B position, preserving outer-column order within each group."
    (let bcp = (.bcp normalized))
    (let inner = (.inner normalized))
    (let positions = (.positions normalized))
    (let count = (arr:length inner))
    (let b-owners = (arr:make count (the UFix 0)))
    (let largest = (cell:new (the UFix 0)))
    (let sorted = (cell:new (arr:make count (the UFix 0))))
    (let spare = (cell:new (arr:make count (the UFix 0))))
    (for ((j 0 (+ j 1))) :while (< j size)
      (for ((q (arr:aref bcp j) (+ q 1))) :while (< q (arr:aref bcp (+ j 1)))
        (arr:set! b-owners q j)
        (arr:set! (cell:read sorted) q q)
        (when (> (arr:aref inner q) (cell:read largest))
          (cell:write! largest (arr:aref inner q)))))
    ;; Inner indices are not bounded by any checked dimension, so no array is indexed by one.
    ;; Positions start in increasing order and are distributed by one digit of the inner index
    ;; at a time, least significant first; each pass keeps the order it was given among equal
    ;; digits, so the result is ordered by inner index and then by position.
    (let buckets = (arr:make (+ radix 1) (the UFix 0)))
    (let divisor = (cell:new (the UFix 1)))
    (let pending = (cell:new True))
    (for () :while (cell:read pending)
      (let from = (cell:read sorted))
      (let to = (cell:read spare))
      (let by = (cell:read divisor))
      (for ((b 0 (+ b 1))) :while (<= b radix)
        (arr:set! buckets b 0))
      (for ((at 0 (+ at 1))) :while (< at count)
        (let digit = (math:rem (math:quot (arr:aref inner (arr:aref from at)) by) radix))
        (arr:set! buckets (+ digit 1) (+ (arr:aref buckets (+ digit 1)) 1)))
      (for ((b 0 (+ b 1))) :while (< b radix)
        (arr:set! buckets (+ b 1) (+ (arr:aref buckets b) (arr:aref buckets (+ b 1)))))
      (for ((at 0 (+ at 1))) :while (< at count)
        (let q = (arr:aref from at))
        (let digit = (math:rem (math:quot (arr:aref inner q) by) radix))
        (arr:set! to (arr:aref buckets digit) q)
        (arr:set! buckets digit (+ (arr:aref buckets digit) 1)))
      (cell:write! sorted to)
      (cell:write! spare from)
      ;; The next digit exists only if the largest index reaches it; by * radix cannot overflow then.
      (when (< (math:quot (cell:read largest) by) radix)
        (cell:write! pending False))
      (when (>= (math:quot (cell:read largest) by) radix)
        (cell:write! divisor (* by radix))))
    (let order = (cell:read sorted))
    (let begins = (arr:make count (the UFix 0)))
    (let starts = (arr:make count (the UFix 0)))
    (let stops = (arr:make count (the UFix 0)))
    (let owners = (arr:make count (the UFix 0)))
    (let values-at = (arr:make count (the UFix 0)))
    (let begin = (cell:new (the UFix 0)))
    (for ((at 0 (+ at 1))) :while (< at count)
      (let q = (arr:aref order at))
      (when (and (> at 0)
                 (not (== (arr:aref inner q) (arr:aref inner (arr:aref order (- at 1))))))
        (cell:write! begin at))
      (arr:set! begins q (cell:read begin))
      (arr:set! starts q at)
      (arr:set! owners at (arr:aref b-owners q))
      (arr:set! values-at at (arr:aref positions q)))
    ;; Walk backwards so each entry learns the exclusive end of its own inner-index group.
    (let stop = (cell:new count))
    (for ((remaining count (- remaining 1))) :while (> remaining 0)
      (let at = (- remaining 1))
      (let q = (arr:aref order at))
      (when (and (< remaining count)
                 (not (== (arr:aref inner q)
                          (arr:aref inner (arr:aref order remaining)))))
        (cell:write! stop remaining))
      (arr:set! stops q (cell:read stop)))
    (CompressedGroups begins starts stops owners values-at))

  (declare count-column! (UFix * arr:LispArray UFix * CompressedGroups * arr:LispArray UFix -> UFix))
  (define (count-column! column bcp incidence marks)
    "Count each lower structural neighbor once, including the mandatory diagonal, using a column-number stamp. Each entry scans its group from its own sorted position, where owners are at or after this column."
    (arr:set! marks column column)
    (let found = (cell:new (the UFix 1)))
    (let starts = (.starts incidence))
    (let stops = (.stops incidence))
    (let owners = (.owners incidence))
    (for ((q (arr:aref bcp column) (+ q 1))) :while (< q (arr:aref bcp (+ column 1)))
      (for ((at (arr:aref starts q) (+ at 1))) :while (< at (arr:aref stops q))
        (let row = (arr:aref owners at))
        (when (not (== (arr:aref marks row) column))
          (arr:set! marks row column)
          (cell:write! found (+ (cell:read found) 1)))))
    (cell:read found))

  (declare analyze-product (csc:Matrix * UFix * Boolean -> GramPlan))
  (define (analyze-product matrix requested-limit aat)
    "Own a lower Gram pattern with every diagonal. Counts precede output allocation; source workspaces scale with stored entries."
    (let m = (csc:row-count matrix))
    (let n = (csc:column-count matrix))
    (let size = (if aat m n))
    (limits:check-dimension! size)
    (let limit = (limits:effective-entry-limit requested-limit))
    (when (> size limit)
      (throw (err:AnalysisStorageExceeded (into size) limit)))
    (let source-cp = (arr:copy (csc:column-pointers matrix)))
    (let source-ri = (arr:copy (csc:row-indices matrix)))
    (let normalized = (normalized-columns m n source-cp source-ri aat))
    (let incidence = (compressed-groups size normalized))
    (let bcp = (.bcp normalized))
    (let columns = (arr:make (+ size 1) (the UFix 0)))
    (let marks = (arr:make size size))
    (let total = (cell:new (the UFix 0)))
    (for ((j 0 (+ j 1))) :while (< j size)
      (let count = (count-column! j bcp incidence marks))
      (when (> count (- limit (cell:read total)))
        (throw (err:AnalysisStorageExceeded
                (+ (the Integer (into (cell:read total))) (into count)) limit)))
      (cell:write! total (+ (cell:read total) count))
      (arr:set! columns (+ j 1) (cell:read total)))
    (let rows = (arr:make (cell:read total) (the UFix 0)))
    ;; Fill by row: row i goes to the end of every column at or before it that it meets, so
    ;; each column receives its rows in increasing order, the diagonal first, without a sort.
    ;; An entry's group holds the owners before its own from the group's beginning.
    ;; The stamps need no reset: the counting pass stamped an index only with a column at or
    ;; before it, and the fill asks whether a column is stamped with a row after it.
    (let cursor = (arr:make size (the UFix 0)))
    (for ((i 0 (+ i 1))) :while (< i size)
      (arr:set! cursor i (arr:aref columns i)))
    (let begins = (.begins incidence))
    (let starts = (.starts incidence))
    (let owners = (.owners incidence))
    (for ((i 0 (+ i 1))) :while (< i size)
      (arr:set! marks i i)
      (arr:set! rows (arr:aref cursor i) i)
      (arr:set! cursor i (+ (arr:aref cursor i) 1))
      (for ((q (arr:aref bcp i) (+ q 1))) :while (< q (arr:aref bcp (+ i 1)))
        (for ((at (arr:aref begins q) (+ at 1))) :while (< at (arr:aref starts q))
          (let j = (arr:aref owners at))
          (when (not (== (arr:aref marks j) i))
            (arr:set! marks j i)
            (arr:set! rows (arr:aref cursor j) i)
            (arr:set! cursor j (+ (arr:aref cursor j) 1))))))
    (MkGramPlan
      (GramPlanStorage m n source-cp source-ri size columns rows
                       bcp (.positions normalized) (.starts incidence)
                       (.stops incidence) (.owners incidence) (.values-at incidence)
                       marks)))

  (declare analyze-ata-with-limit (csc:Matrix * UFix -> GramPlan))
  (define (analyze-ata-with-limit matrix limit)
    "Analyze lower A^T A with a total stored-entry budget including every diagonal; output values remain caller-owned."
    (analyze-product matrix limit False))

  (declare analyze-aat-with-limit (csc:Matrix * UFix -> GramPlan))
  (define (analyze-aat-with-limit matrix limit)
    "Analyze lower A A^T with a total stored-entry budget including every diagonal; output values remain caller-owned."
    (analyze-product matrix limit True))

  (declare analyze-ata (csc:Matrix -> GramPlan))
  (define (analyze-ata matrix)
    "Analyze lower A^T A using the default entry budget; stored source zeros participate in the pattern."
    (analyze-ata-with-limit matrix default-analysis-entry-limit))

  (declare analyze-aat (csc:Matrix -> GramPlan))
  (define (analyze-aat matrix)
    "Analyze lower A A^T using the default entry budget; stored source zeros participate in the pattern."
    (analyze-aat-with-limit matrix default-analysis-entry-limit))

  (declare refill! (GramPlan * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (refill! plan input-values output)
    "Overwrite caller-owned values in the plan's lower CSC order. Input must match the analyzed source order and differ from output. Preflight preserves output; arithmetic refusal leaves it unspecified. Refills share plan scratch and are not reentrant."
    (let storage = (plan-storage plan))
    (unless (and (== (arr:length input-values) (arr:length (.source-rows storage)))
                 (== (arr:length output) (arr:length (.rows storage))))
      (throw (err:InvalidDimensions "Gram input or output value count differs from its plan.")))
    (when (unsafe-pointer-eq? input-values output)
      (throw (err:InvalidAliasing "Gram output must be distinct from the input values.")))
    (for ((q 0 (+ q 1))) :while (< q (arr:length input-values))
      (unless (inline (math:finite? (arr:aref input-values q)))
        (throw (err:NonFiniteInput "Gram source values must be finite."))))
    (let columns = (.columns storage))
    (let rows = (.rows storage))
    (let bcp = (.b-columns storage))
    (let positions = (.b-values storage))
    (let starts = (.b-starts storage))
    (let stops = (.b-stops storage))
    (let owners = (.group-columns storage))
    (let values-at = (.group-values storage))
    (let scatter = (.scatter storage))
    (for ((q 0 (+ q 1))) :while (< q (arr:length output))
      (arr:set! output q 0.0d0))
    (for ((j 0 (+ j 1))) :while (< j (.size storage))
      (for ((q (arr:aref columns j) (+ q 1))) :while (< q (arr:aref columns (+ j 1)))
        (arr:set! scatter (arr:aref rows q) q))
      (for ((q (arr:aref bcp j) (+ q 1))) :while (< q (arr:aref bcp (+ j 1)))
        (let value = (arr:aref input-values (arr:aref positions q)))
        ;; From an entry's own sorted position on, every owner in its group is at or after column j.
        (for ((at (arr:aref starts q) (+ at 1))) :while (< at (arr:aref stops q))
          (let target = (arr:aref scatter (arr:aref owners at)))
          (arr:set! output target
                    (+ (arr:aref output target)
                       (* value (arr:aref input-values (arr:aref values-at at))))))))
    (for ((q 0 (+ q 1))) :while (< q (arr:length output))
      (unless (inline (math:finite? (arr:aref output q)))
        (throw (err:NonFiniteResult "Gram result is not finite.")))))

  (declare refill-csc! (GramPlan * csc:Matrix * arr:LispArray F64 -> Void))
  (define (refill-csc! plan matrix output)
    "Check original dimensions and every source CSC pointer/index before refill; equal Gram patterns alone do not establish source compatibility."
    (let storage = (plan-storage plan))
    (unless (and (== (csc:row-count matrix) (.source-m storage))
                 (== (csc:column-count matrix) (.source-n storage)))
      (throw (err:InvalidDimensions "Gram source dimensions differ from the analyzed matrix.")))
    (let expected-cp = (.source-columns storage))
    (let expected-ri = (.source-rows storage))
    (let actual-cp = (csc:column-pointers matrix))
    (let actual-ri = (csc:row-indices matrix))
    (unless (and (== (arr:length actual-cp) (arr:length expected-cp))
                 (== (arr:length actual-ri) (arr:length expected-ri)))
      (throw (err:InvalidStructure "Gram source pattern differs from the analyzed matrix.")))
    (for ((q 0 (+ q 1))) :while (< q (arr:length expected-cp))
      (unless (== (arr:aref actual-cp q) (arr:aref expected-cp q))
        (throw (err:InvalidStructure "Gram source column pointers differ from the analyzed matrix."))))
    (for ((q 0 (+ q 1))) :while (< q (arr:length expected-ri))
      (unless (== (arr:aref actual-ri q) (arr:aref expected-ri q))
        (throw (err:InvalidStructure "Gram source row indices differ from the analyzed matrix."))))
    (refill! plan (csc:entries matrix) output)))
