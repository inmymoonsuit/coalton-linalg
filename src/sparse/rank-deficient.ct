(cl:defpackage #:coalton-linalg/sparse/rank-deficient
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:math #:coalton/math)
                    (#:csc #:coalton-linalg/sparse/csc)
                    (#:rows #:coalton-linalg/sparse/dependent-rows)
                    (#:gram #:coalton-linalg/sparse/gram)
                    (#:aug #:coalton-linalg/sparse/augmented)
                    (#:ldlt #:coalton-linalg/sparse/spd-ldlt)
                    (#:fp #:coalton-linalg/internal/float)
                    (#:err #:coalton-linalg/errors))
  (:export #:KeptRows #:analyze #:analyze-with-limit #:default-analysis-entry-limit
           #:row-count #:column-count
           #:FindStatus #:FindFound #:FindNonFinite #:FindUnderflow #:FindBadThreshold #:FindBadDrop
           #:FindVectorRefused
           #:find-kept-rows! #:kept-found? #:kept-count #:left-out-count #:left-out-rows
           #:multiplier-count #:multiplier-rows #:multiplier-values #:multiplier-start
           #:ReproveStatus #:Reproved #:ReproveNothingKept #:ReproveNonFinite
           #:reprove! #:residual-bound #:gap-bound
           #:largest-singular-bounds!
           #:CertificateStatus #:Certified #:CertificateGapAboveFloor #:CertificateKeptNotAboveFloor
           #:CertificateUnresolved #:CertificateBadFloor #:CertificateNothingKept
           #:certify! #:certified? #:proved-lower-bound
           #:StepStatus #:StepTaken #:StepNoCertificate #:StepBadSize #:StepNonFiniteRhs #:StepFactorRefused
           #:StepBoundNotReached #:StepNonFiniteResult
           #:step! #:step-taken? #:step-solve-bound #:step-bound #:step-corrections #:correction-limit
           #:solve-growth #:solve-backward-bound #:predicted-rate
           #:RefreshStatus #:Refreshed #:RefreshNothingKept #:RefreshBadTarget #:RefreshNoShift
           #:RefreshFactorRefused #:RefreshNonFinite
           #:refresh! #:refreshed-count))
(cl:in-package #:coalton-linalg/sparse/rank-deficient)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

;;; A rank-deficient matrix as kept rows and rows left out, with the vectors of the rows left out
;;; kept from call to call and a certificate that no singular value lies at a floor. See
;;; docs/rank-deficient.md for the contract and docs/design-rank-deficient-step.md for the design.

(coalton-toplevel
  (define-struct LeftOutSystem
    "I + W W^T for the standing kept vectors: its plan and factor, W's values in the plan's order, and where each entry of a kept vector lies among them."
    (symbolic ldlt:Symbolic)
    (plan gram:GramPlan)
    (values (arr:LispArray F64))
    (places (arr:LispArray UFix))
    (product (arr:LispArray F64)))

  (define-struct StepStorage
    "What a step on a standing kept set works in: the kept rows' numbering, the system of the rows left out, and the vectors of the two solves."
    (numbers (arr:LispArray UFix))
    (kept-list (arr:LispArray UFix))
    (system (cell:Cell (Optional LeftOutSystem)))
    (marks (arr:LispArray UFix))
    (longest (arr:LispArray UFix))
    (uses (arr:LispArray UFix))
    (residual (arr:LispArray F64))
    (z (arr:LispArray F64))
    (y (arr:LispArray F64))
    (trial (arr:LispArray F64))
    (kept-sums (arr:LispArray F64))
    (kept-magnitudes (arr:LispArray F64))
    (kept-extras (arr:LispArray F64))
    (out-values (arr:LispArray F64))
    (out-solved (arr:LispArray F64))
    (out-errors (arr:LispArray F64))
    (unknown (arr:LispArray F64))
    (best (arr:LispArray F64))
    (defect (arr:LispArray F64))
    (change (arr:LispArray F64))
    (figures (arr:LispArray F64)))

  (define-struct KeptStorage
    "Owns the search, a copy of the pattern by rows, the kept vectors, and what the certificate factors."
    (rows UFix)
    (columns UFix)
    (limit UFix)
    (analysis rows:RowAnalysis)
    (column-starts (arr:LispArray UFix))
    (row-indices (arr:LispArray UFix))
    (row-starts (arr:LispArray UFix))
    (row-columns (arr:LispArray UFix))
    (row-positions (arr:LispArray UFix))
    (entries (arr:LispArray F64))
    (scale (arr:LispArray F64))
    (state (arr:LispArray UFix))
    (flags (arr:LispArray UFix))
    (vector-starts (arr:LispArray UFix))
    (vector-rows (cell:Cell (arr:LispArray UFix)))
    (vector-values (cell:Cell (arr:LispArray F64)))
    (bounds (arr:LispArray F64))
    (buffer (arr:LispArray F64))
    (sums (arr:LispArray F64))
    (magnitudes (arr:LispArray F64))
    (counts (arr:LispArray UFix))
    (touched (arr:LispArray UFix))
    (kept-positions (cell:Cell (arr:LispArray UFix)))
    (kept-values (cell:Cell (arr:LispArray F64)))
    (augmented (cell:Cell (arr:LispArray F64)))
    (plan (cell:Cell (Optional aug:AugmentedPlan)))
    (symbolic (cell:Cell (Optional ldlt:Symbolic)))
    (step (cell:Cell (Optional StepStorage)))
    (spare-starts (arr:LispArray UFix))
    (spare-rows (cell:Cell (arr:LispArray UFix)))
    (spare-values (cell:Cell (arr:LispArray F64))))

  (repr :transparent)
  (define-type KeptRows
    "Handle for the kept rows of one sparse pattern; it owns its search, its vectors and its workspace, and one call at a time uses them."
    (MkKeptRows KeptStorage))

  (inline)
  (declare storage (KeptRows -> KeptStorage))
  (define (storage kept) (match kept ((MkKeptRows held) held)))

  (derive Eq)
  (repr :enum)
  (define-type FindStatus
    "Outcome of a search with every vector found."
    FindFound
    "A kept set and the vectors of the rows left out stand."
    FindNonFinite
    "An intermediate result of the search, or a bound, was not finite; nothing stands."
    FindUnderflow
    "The search's RowsUnderflow; nothing stands."
    FindBadThreshold
    "The search's RowsBadThreshold; nothing stands."
    FindBadDrop
    "The drop tolerance was not above 0 and below 1; nothing stands."
    FindVectorRefused
    "The vector of a row left out could not be computed; nothing stands.")

  (derive Eq)
  (repr :enum)
  (define-type ReproveStatus
    "Outcome of proving the kept vectors' bounds again for new values."
    Reproved
    "Every bound stands for the values given."
    ReproveNothingKept
    "No kept set stands."
    ReproveNonFinite
    "A bound was not finite; no certificate stands, the vectors do.")

  (derive Eq)
  (repr :enum)
  (define-type CertificateStatus
    "Outcome of asking that no singular value lie between two floors."
    Certified
    "Every singular value of the kept rows exceeds the upper floor, and at most the kept count of the matrix's exceed the lower."
    CertificateGapAboveFloor
    "The gap bound is not below the lower floor: a singular value beyond the kept count may reach it."
    CertificateKeptNotAboveFloor
    "The kept rows were not proved above the upper floor, by a factorization accurate at that floor."
    CertificateUnresolved
    "The proof's own error exceeds the upper floor: the floor is below what this method resolves."
    CertificateBadFloor
    "A floor was not positive and finite, or the lower exceeded the upper."
    CertificateNothingKept
    "No kept set stands, or its bounds do not.")

  (declare default-analysis-entry-limit UFix)
  (define default-analysis-entry-limit
    "Default budget of entries, 2^20, for each product and factor the handle analyzes."
    rows:default-analysis-entry-limit)

  ;; The scale array: [0] the power of two at the matrix's largest entry and [1] its reciprocal;
  ;; [2] the gap bound of the standing vectors, in the divided matrix's units; [3] the lower bound
  ;; the latest certificate proved, in the caller's units, or -1; [4] the bound a ladder starts
  ;; from next time, in the divided units, or 0; [5] the drop tolerance the standing vectors were
  ;; stored with.
  ;;
  ;; The state array: [0] 1 when a kept set and its vectors stand; [1] the rows left out; [2] 1
  ;; when the bounds stand for the values held; [3] 1 when a certificate stands; [4] 1 when the
  ;; factor the symbolic analysis holds is the solve's, for the standing certificate; [5] 1 when a
  ;; step stands.
  ;;
  ;; A step's marks: [0] the system of the rows left out: 0 it could not be factored, 1 its factor
  ;; stands, 2 there is none to solve; [1] the corrections the latest step made; [2] the vectors
  ;; the latest refresh replaced.
  ;;
  ;; A step's figures: [0] the solve's bound and [1] the whole bound of the latest step, in the
  ;; caller's units; [2] the growth, [3] the backward bound and [4] the predicted rate of the
  ;; solve's factor; [5] the power of two at the residual's largest entry and [6] its reciprocal;
  ;; [8] to [11] are where the residual routines leave their results.

  (declare analyze-with-limit (csc:Matrix * UFix -> KeptRows))
  (define (analyze-with-limit matrix maximum-entries)
    "analyze with one entry budget for every product and factor; the errors are those of the analyses it makes."
    (let m = (csc:row-count matrix))
    (let n = (csc:column-count matrix))
    (let analysis = (rows:analyze-with-limit matrix maximum-entries))
    (let column-starts = (arr:copy (csc:column-pointers matrix)))
    (let row-indices = (arr:copy (csc:row-indices matrix)))
    (let entry-total = (arr:length row-indices))
    ;; The same pattern by rows: where each row starts, the column of each entry, and where the
    ;; entry is among the values as stored by columns.
    (let row-starts = (arr:make (+ m 1) (the UFix 0)))
    (for ((q 0 (+ q 1))) :while (< q entry-total)
      (let i = (arr:aref row-indices q))
      (arr:set! row-starts (+ i 1) (+ (arr:aref row-starts (+ i 1)) 1)))
    (for ((i 0 (+ i 1))) :while (< i m)
      (arr:set! row-starts (+ i 1) (+ (arr:aref row-starts (+ i 1)) (arr:aref row-starts i))))
    (let row-columns = (arr:make entry-total (the UFix 0)))
    (let row-positions = (arr:make entry-total (the UFix 0)))
    (let cursor = (arr:make m (the UFix 0)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (for ((q (arr:aref column-starts j) (+ q 1))) :while (< q (arr:aref column-starts (+ j 1)))
        (let i = (arr:aref row-indices q))
        (let at = (+ (arr:aref row-starts i) (arr:aref cursor i)))
        (arr:set! row-columns at j)
        (arr:set! row-positions at q)
        (arr:set! cursor i (+ (arr:aref cursor i) 1))))
    ;; No certificate has proved a bound yet.
    (let scale = (arr:make 6 0.0d0))
    (arr:set! scale 3 -1.0d0)
    (MkKeptRows
     (KeptStorage m n maximum-entries analysis column-starts row-indices row-starts row-columns row-positions
                  (arr:make entry-total 0.0d0) scale (arr:make 6 (the UFix 0))
                  (arr:make m (the UFix 1)) (arr:make (+ m 1) (the UFix 0))
                  (cell:new (arr:make 0 (the UFix 0))) (cell:new (arr:make 0 0.0d0))
                  (arr:make m -1.0d0) (arr:make m 0.0d0)
                  (arr:make n 0.0d0) (arr:make n 0.0d0) (arr:make n (the UFix 0)) (arr:make n (the UFix 0))
                  (cell:new (arr:make 0 (the UFix 0))) (cell:new (arr:make 0 0.0d0)) (cell:new (arr:make 0 0.0d0))
                  (cell:new None) (cell:new None) (cell:new None)
                  (arr:make (+ m 1) (the UFix 0)) (cell:new (arr:make 0 (the UFix 0))) (cell:new (arr:make 0 0.0d0)))))

  (declare analyze (csc:Matrix -> KeptRows))
  (define (analyze matrix)
    "Analyze a stored matrix's pattern under the default entry budget. Once for a pattern; no value is read."
    (analyze-with-limit matrix default-analysis-entry-limit))

  (declare row-count (KeptRows -> UFix))
  (define (row-count kept)
    "Rows of the analyzed matrix."
    (.rows (storage kept)))

  (declare column-count (KeptRows -> UFix))
  (define (column-count kept)
    "Columns of the analyzed matrix."
    (.columns (storage kept)))

  (declare kept-found? (KeptRows -> Boolean))
  (define (kept-found? kept)
    "Whether a kept set and its vectors stand: the latest find-kept-rows! returned FindFound."
    (== (arr:aref (.state (storage kept)) 0) 1))

  (declare left-out-count (KeptRows -> UFix))
  (define (left-out-count kept)
    "Rows the standing set leaves out; 0 when none stands."
    (let s = (storage kept))
    (if (== (arr:aref (.state s) 0) 1) (arr:aref (.state s) 1) 0))

  (declare kept-count (KeptRows -> UFix))
  (define (kept-count kept)
    "Rows in the standing kept set; 0 when none stands."
    (let s = (storage kept))
    (if (== (arr:aref (.state s) 0) 1) (- (.rows s) (arr:aref (.state s) 1)) 0))

  (declare left-out-rows (KeptRows -> arr:LispArray UFix))
  (define (left-out-rows kept)
    "Borrowed view as long as the row count: its first left-out-count entries are the rows left out, in the order the search met them. A position in it is what the vector accessors and residual-bound take."
    (rows:left-out-rows (.analysis (storage kept))))

  (declare multiplier-start (KeptRows * UFix -> UFix))
  (define (multiplier-start kept position)
    "Where the kept vector at this position starts in multiplier-rows and multiplier-values; positions run to left-out-count, and the start at left-out-count is the end of the last. 0 when no set stands or the position is beyond it."
    (let s = (storage kept))
    (if (and (== (arr:aref (.state s) 0) 1) (<= position (arr:aref (.state s) 1)))
        (arr:aref (.vector-starts s) position)
        0))

  (declare multiplier-count (KeptRows * UFix -> UFix))
  (define (multiplier-count kept position)
    "Entries the kept vector at this position holds at kept rows, after the drop; 0 when there is no such vector."
    (let s = (storage kept))
    (if (and (== (arr:aref (.state s) 0) 1) (< position (arr:aref (.state s) 1)))
        (- (arr:aref (.vector-starts s) (+ position 1)) (arr:aref (.vector-starts s) position))
        0))

  (declare multiplier-rows (KeptRows -> arr:LispArray UFix))
  (define (multiplier-rows kept)
    "Borrowed view, replaced by a search: the kept row of each entry of every kept vector, the vectors one after another as multiplier-start says."
    (cell:read (.vector-rows (storage kept))))

  (declare multiplier-values (KeptRows -> arr:LispArray F64))
  (define (multiplier-values kept)
    "Borrowed view, replaced by a search: the vector's value at each row of multiplier-rows. The vector of a row left out has 1 at that row, these values at kept rows, and zero elsewhere; its multipliers are these values with the sign changed."
    (cell:read (.vector-values (storage kept))))

  (inline)
  (declare restored (F64 * F64 -> F64))
  (define (restored bound up)
    "A bound on a quantity of the divided matrix as one on the matrix itself: multiplied back by the power of two, and raised by the smallest positive number where the product is below the normal range and could have been rounded down. It may be infinite."
    (let product = (* bound up))
    (if (< product fp:least-normal) (+ product fp:least-positive) product))

  (declare vector-bound! (KeptStorage * UFix -> Void))
  (define (vector-bound! s position)
    "Write into the bounds, at a position, an upper bound on the 2-norm of J^T v for the kept vector there and the divided values held, exact product, or infinity. Only the rows the vector touches are read. See docs/rank-deficient.md."
    (let starts = (.row-starts s))
    (let columns = (.row-columns s))
    (let positions = (.row-positions s))
    (let entries = (.entries s))
    (let sums = (.sums s))
    (let magnitudes = (.magnitudes s))
    (let counts = (.counts s))
    (let touched = (.touched s))
    (let reached = (cell:new (the UFix 0)))
    (let vector-rows = (cell:read (.vector-rows s)))
    (let vector-values = (cell:read (.vector-values s)))
    (let from = (arr:aref (.vector-starts s) position))
    (let to = (arr:aref (.vector-starts s) (+ position 1)))
    ;; One pass for each kept row the vector holds, and a last one, e = to, for the row left
    ;; out itself, whose entry of the vector is 1.
    (for ((e from (+ e 1))) :while (<= e to)
      (let own = (== e to))
      (let i = (if own (arr:aref (rows:left-out-rows (.analysis s)) position) (arr:aref vector-rows e)))
      (let x = (if own 1.0d0 (arr:aref vector-values e)))
      (for ((q (arr:aref starts i) (+ q 1))) :while (< q (arr:aref starts (+ i 1)))
        (let j = (arr:aref columns q))
        (let p = (* (arr:aref entries (arr:aref positions q)) x))
        (when (== (arr:aref counts j) 0)
          (arr:set! touched (cell:read reached) j)
          (cell:write! reached (+ (cell:read reached) 1)))
        (arr:set! sums j (+ (arr:aref sums j) p))
        (arr:set! magnitudes j (+ (arr:aref magnitudes j) (abs p)))
        (arr:set! counts j (+ (arr:aref counts j) 1))))
    ;; As dependent rows bounds a product: the exact entry of a column with c terms is within
    ;; gamma(2c + 2) of the sum of the rounded products' magnitudes. A column no row of the
    ;; vector reaches is exactly zero and is not visited. The workspace is cleared as it is read.
    (let total = (cell:new 0.0d0))
    (for ((k 0 (+ k 1))) :while (< k (cell:read reached))
      (let j = (arr:aref touched k))
      (let reach = (fp:count->float (+ (* 2 (arr:aref counts j)) 2)))
      (let relative = (/ (* reach fp:unit-roundoff) (- 1.0d0 (* reach fp:unit-roundoff))))
      (let entry = (+ (abs (arr:aref sums j)) (* relative (arr:aref magnitudes j))))
      (cell:write! total (+ (cell:read total) (* entry entry)))
      (arr:set! sums j 0.0d0)
      (arr:set! magnitudes j 0.0d0)
      (arr:set! counts j 0))
    (let order = (fp:count->float (cell:read reached)))
    (let padded = (+ (cell:read total) (* order fp:least-positive)))
    ;; Written, not returned: a number returned from here would be boxed at every call.
    (arr:set! (.bounds s) position
              (if (inline (math:finite? padded))
                  (* (+ 1.0d0 (* (* 2.0d0 fp:unit-roundoff) (+ order 10.0d0))) (math:sqrt padded))
                  fp:infinity)))

  (inline)
  (declare withdraw-step! (arr:LispArray UFix -> Void))
  (define (withdraw-step! st)
    "No solve factor and no step stand: a search, a reproof and a certificate each factor over the one, and change what the other was of."
    (arr:set! st 4 0)
    (arr:set! st 5 0))

  (declare take-values! (KeptStorage * csc:Matrix -> Void))
  (define (take-values! s matrix)
    "Hold the matrix's values divided by the power of two at the largest."
    (let values = (csc:entries matrix))
    (let entries = (.entries s))
    (let largest = (cell:new 0.0d0))
    (for ((q 0 (+ q 1))) :while (< q (arr:length values))
      (let a = (abs (arr:aref values q)))
      (when (> a (cell:read largest)) (cell:write! largest a)))
    (fp:binade! (cell:read largest) (.scale s) 0)
    (let down = (arr:aref (.scale s) 1))
    (for ((q 0 (+ q 1))) :while (< q (arr:length values))
      (arr:set! entries q (* (arr:aref values q) down))))

  (declare prove-bounds! (KeptStorage -> Boolean))
  (define (prove-bounds! s)
    "Prove every kept vector's bound for the values held, and the gap bound from them, the root of the sum of their squares rounded upward. False when one is not finite."
    (let d = (arr:aref (.state s) 1))
    (let bounds = (.bounds s))
    (let total = (cell:new 0.0d0))
    (for ((p 0 (+ p 1))) :while (< p d)
      (vector-bound! s p)
      (let bound = (arr:aref bounds p))
      (unless (inline (math:finite? bound)) (return False))
      (cell:write! total (+ (cell:read total) (* bound bound))))
    (let order = (fp:count->float d))
    (let gap = (if (== d 0)
                   0.0d0
                   (* (+ 1.0d0 (* (* 2.0d0 fp:unit-roundoff) (+ order 4.0d0)))
                      (math:sqrt (+ (cell:read total) (* order fp:least-positive))))))
    (arr:set! (.scale s) 2 gap)
    (inline (math:finite? gap)))

  (declare left-out-system! (KeptStorage * arr:LispArray UFix * UFix * arr:LispArray UFix * arr:LispArray UFix
                             -> Optional LeftOutSystem))
  (define (left-out-system! s number r uses marks)
    "Analyze and factor I + W W^T, W holding in row p the multipliers of the row left out at position p, the kept vector's entries with the sign changed. Counts into uses, which the caller has zeroed, how many vectors hold each kept row, and sets marks[0]: 2 when there is nothing to solve, 1 when the factor stands, 0 when the squares cannot be held or the factorization refused."
    (let d = (arr:aref (.state s) 1))
    (let starts = (.vector-starts s))
    (let vector-rows = (cell:read (.vector-rows s)))
    (let vector-values = (cell:read (.vector-values s)))
    (let held = (arr:aref starts d))
    (let biggest = (cell:new 0.0d0))
    (for ((e 0 (+ e 1))) :while (< e held)
      (let k = (arr:aref number (arr:aref vector-rows e)))
      (arr:set! uses k (+ (arr:aref uses k) 1))
      (when (> (abs (arr:aref vector-values e)) (cell:read biggest))
        (cell:write! biggest (abs (arr:aref vector-values e)))))
    (arr:set! marks 0 0)
    (when (or (== d 0) (== held 0))
      (arr:set! marks 0 2)
      (return None))
    (let squares = (* (* (cell:read biggest) (cell:read biggest)) (fp:count->float (+ held 1))))
    (unless (and (inline (math:finite? squares)) (< squares (* 0.25d0 fp:greatest)))
      (return None))
    (let w-pointers = (arr:make (+ r 1) (the UFix 0)))
    (for ((k 0 (+ k 1))) :while (< k r)
      (arr:set! w-pointers (+ k 1) (+ (arr:aref w-pointers k) (arr:aref uses k))))
    (let w-cursor = (arr:make r (the UFix 0)))
    (let w-indices = (arr:make held (the UFix 0)))
    (let w-values = (arr:make held 0.0d0))
    (let w-places = (arr:make held (the UFix 0)))
    (for ((p 0 (+ p 1))) :while (< p d)
      (for ((e (arr:aref starts p) (+ e 1))) :while (< e (arr:aref starts (+ p 1)))
        (let k = (arr:aref number (arr:aref vector-rows e)))
        (let at = (+ (arr:aref w-pointers k) (arr:aref w-cursor k)))
        (arr:set! w-indices at p)
        (arr:set! w-values at (- 0.0d0 (arr:aref vector-values e)))
        (arr:set! w-places e at)
        (arr:set! w-cursor k (+ (arr:aref w-cursor k) 1))))
    (let w-matrix = (csc:from-csc d r w-pointers w-indices w-values))
    (let w-plan = (gram:analyze-aat-with-limit w-matrix (.limit s)))
    (let product = (arr:make (gram:entry-count w-plan) 0.0d0))
    (gram:refill-csc! w-plan w-matrix product)
    (let w-symbolic = (ldlt:analyze-with-limit
                       (ldlt:Pattern (gram:dimension w-plan) (gram:column-pointers w-plan) (gram:row-indices w-plan))
                       (.limit s)))
    ;; A shift of -1 adds the identity.
    (when (== (ldlt:factor! w-symbolic product -1.0d0) ldlt:FactorSuccess)
      (arr:set! marks 0 1))
    (Some (LeftOutSystem w-symbolic w-plan w-values w-places product)))

  (declare build-kept! (KeptStorage -> Unit))
  (define (build-kept! s)
    "For the standing kept set: where its rows' entries are among the matrix's values, and the analysis of their augmented matrix."
    (let m = (.rows s))
    (let n = (.columns s))
    (let flags = (.flags s))
    (let column-starts = (.column-starts s))
    (let row-indices = (.row-indices s))
    ;; The kept rows renumbered in their own order, in the buffer of counts by row.
    (let number = (arr:make m (the UFix 0)))
    (let next = (cell:new (the UFix 0)))
    (for ((i 0 (+ i 1))) :while (< i m)
      (when (== (arr:aref flags i) 1)
        (arr:set! number i (cell:read next))
        (cell:write! next (+ (cell:read next) 1))))
    (let r = (cell:read next))
    (let tally = (cell:new (the UFix 0)))
    (for ((q 0 (+ q 1))) :while (< q (arr:length row-indices))
      (when (== (arr:aref flags (arr:aref row-indices q)) 1)
        (cell:write! tally (+ (cell:read tally) 1))))
    (let kept-entries = (cell:read tally))
    (let pointers = (arr:make (+ n 1) (the UFix 0)))
    (let indices = (arr:make kept-entries (the UFix 0)))
    (let positions = (arr:make kept-entries (the UFix 0)))
    (let filled = (cell:new (the UFix 0)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (for ((q (arr:aref column-starts j) (+ q 1))) :while (< q (arr:aref column-starts (+ j 1)))
        (let i = (arr:aref row-indices q))
        (when (== (arr:aref flags i) 1)
          (arr:set! indices (cell:read filled) (arr:aref number i))
          (arr:set! positions (cell:read filled) q)
          (cell:write! filled (+ (cell:read filled) 1))))
      (arr:set! pointers (+ j 1) (cell:read filled)))
    ;; The pattern only: the values are taken at each call.
    (let pattern = (csc:from-csc r n pointers indices (arr:make kept-entries 1.0d0)))
    (let plan = (aug:analyze-with-limit pattern (.limit s)))
    (let symbolic = (ldlt:analyze-quasidefinite-with-limit
                     (ldlt:Pattern (+ n r) (aug:column-pointers plan) (aug:row-indices plan)) n (.limit s)))
    (cell:write! (.kept-positions s) positions)
    (cell:write! (.kept-values s) (arr:make kept-entries 0.0d0))
    (cell:write! (.augmented s) (arr:make (aug:entry-count plan) 0.0d0))
    (cell:write! (.plan s) (Some plan))
    (cell:write! (.symbolic s) (Some symbolic))
    ;; What a step works in.
    (let d = (- m r))
    (let uses = (arr:make r (the UFix 0)))
    (let marks = (arr:make 3 (the UFix 0)))
    (let system = (left-out-system! s number r uses marks))
    (let kept-list = (arr:make r (the UFix 0)))
    (for ((i 0 (+ i 1))) :while (< i m)
      (when (== (arr:aref flags i) 1)
        (arr:set! kept-list (arr:aref number i) i)))
    (let longest = (arr:make 2 (the UFix 0)))
    (for ((i 0 (+ i 1))) :while (< i m)
      (let extent = (- (arr:aref (.row-starts s) (+ i 1)) (arr:aref (.row-starts s) i)))
      (when (> extent (arr:aref longest 0)) (arr:set! longest 0 extent)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let extent = (- (arr:aref column-starts (+ j 1)) (arr:aref column-starts j)))
      (when (> extent (arr:aref longest 1)) (arr:set! longest 1 extent)))
    (let figures = (arr:make 12 0.0d0))
    (arr:set! figures 0 -1.0d0)
    (arr:set! figures 1 -1.0d0)
    (cell:write! (.step s)
                 (Some (StepStorage number kept-list (cell:new system) marks longest uses
                                    (arr:make m 0.0d0)
                                    (arr:make r 0.0d0) (arr:make r 0.0d0) (arr:make r 0.0d0)
                                    (arr:make r 0.0d0) (arr:make r 0.0d0) (arr:make r 0.0d0)
                                    (arr:make d 0.0d0) (arr:make d 0.0d0) (arr:make d 0.0d0)
                                    (arr:make (+ n r) 0.0d0) (arr:make (+ n r) 0.0d0)
                                    (arr:make (+ n r) 0.0d0) (arr:make (+ n r) 0.0d0)
                                    figures)))
    Unit)

  (declare find-kept-rows! (KeptRows * csc:Matrix * F64 * F64 -> FindStatus))
  (define (find-kept-rows! kept matrix threshold drop)
    "Search for the rows that depend on the rows before them, at a distance threshold as dependent rows takes it, and find the vector of every row left out; in each, an entry below drop times the vector's largest is set to zero, and the bound is proved for the vector as kept. Once for a matrix whose kept set is to be used for many values; it allocates. See docs/rank-deficient.md."
    (let s = (storage kept))
    (let st = (.state s))
    (arr:set! st 0 0)
    (arr:set! st 2 0)
    (arr:set! st 3 0)
    (withdraw-step! st)
    (arr:set! (.scale s) 3 -1.0d0)
    (arr:set! (.scale s) 4 0.0d0)
    (unless (and (> drop 0.0d0) (< drop 1.0d0)) (return FindBadDrop))
    (arr:set! (.scale s) 5 drop)
    (let found = (rows:find-dependent-rows! (.analysis s) matrix threshold))
    (unless (== found rows:RowsFound)
      (return (match found
                ((rows:RowsUnderflow) FindUnderflow)
                ((rows:RowsBadThreshold) FindBadThreshold)
                (_ FindNonFinite))))
    (take-values! s matrix)
    (let m = (.rows s))
    (let d = (rows:left-out-count (.analysis s)))
    (let left = (rows:left-out-rows (.analysis s)))
    (let flags = (.flags s))
    (for ((i 0 (+ i 1))) :while (< i m)
      (arr:set! flags i 1))
    (for ((p 0 (+ p 1))) :while (< p d)
      (arr:set! flags (arr:aref left p) 0))
    (let buffer = (.buffer s))
    (let starts = (.vector-starts s))
    (let total = (cell:new (the UFix 0)))
    (arr:set! starts 0 0)
    (for ((p 0 (+ p 1))) :while (< p d)
      (unless (== (rows:null-vector! (.analysis s) p buffer) rows:NullFound)
        (return FindVectorRefused))
      ;; The largest entry at a kept row, the entries that reach drop times it, and room for them.
      (let largest = (cell:new 0.0d0))
      (for ((i 0 (+ i 1))) :while (< i m)
        (when (and (== (arr:aref flags i) 1) (> (abs (arr:aref buffer i)) (cell:read largest)))
          (cell:write! largest (abs (arr:aref buffer i)))))
      (let cutoff = (* drop (cell:read largest)))
      (let wanted = (cell:new (the UFix 0)))
      (for ((i 0 (+ i 1))) :while (< i m)
        (when (and (== (arr:aref flags i) 1)
                   (and (/= (arr:aref buffer i) 0.0d0) (>= (abs (arr:aref buffer i)) cutoff)))
          (cell:write! wanted (+ (cell:read wanted) 1))))
      (let needed = (+ (cell:read total) (cell:read wanted)))
      (let old-rows = (cell:read (.vector-rows s)))
      (when (> needed (arr:length old-rows))
        (let size = (if (> (* 2 (arr:length old-rows)) needed) (* 2 (arr:length old-rows)) needed))
        (let fresh-rows = (arr:make size (the UFix 0)))
        (let fresh-values = (arr:make size 0.0d0))
        (let old-values = (cell:read (.vector-values s)))
        (for ((q 0 (+ q 1))) :while (< q (cell:read total))
          (arr:set! fresh-rows q (arr:aref old-rows q))
          (arr:set! fresh-values q (arr:aref old-values q)))
        (cell:write! (.vector-rows s) fresh-rows)
        (cell:write! (.vector-values s) fresh-values))
      (let vector-rows = (cell:read (.vector-rows s)))
      (let vector-values = (cell:read (.vector-values s)))
      (for ((i 0 (+ i 1))) :while (< i m)
        (when (and (== (arr:aref flags i) 1)
                   (and (/= (arr:aref buffer i) 0.0d0) (>= (abs (arr:aref buffer i)) cutoff)))
          (arr:set! vector-rows (cell:read total) i)
          (arr:set! vector-values (cell:read total) (arr:aref buffer i))
          (cell:write! total (+ (cell:read total) 1))))
      (arr:set! starts (+ p 1) (cell:read total)))
    (arr:set! st 1 d)
    (unless (prove-bounds! s) (return FindNonFinite))
    (build-kept! s)
    (arr:set! st 0 1)
    (arr:set! st 2 1)
    FindFound)

  (declare reprove! (KeptRows * csc:Matrix -> ReproveStatus))
  (define (reprove! kept matrix)
    "For a matrix of the analyzed pattern with other values: prove every kept vector's bound again against them. Nothing is searched, no vector changes and nothing is allocated; the kept set and the vectors are the standing ones, and whether they still serve is what the bounds, and then a certificate, say. Another pattern or shape raises the typed error of the Gram refill. See docs/rank-deficient.md."
    (let s = (storage kept))
    (let st = (.state s))
    (unless (== (arr:aref st 0) 1) (return ReproveNothingKept))
    (arr:set! st 2 0)
    (arr:set! st 3 0)
    (withdraw-step! st)
    (arr:set! (.scale s) 3 -1.0d0)
    (rows:check-pattern! (.analysis s) matrix)
    (take-values! s matrix)
    (unless (prove-bounds! s) (return ReproveNonFinite))
    (arr:set! st 2 1)
    Reproved)

  (declare residual-bound (KeptRows * UFix -> F64))
  (define (residual-bound kept position)
    "The bound standing on the 2-norm of J^T v for the kept vector at this position and the values the bounds were last proved for, exact product; -1 when there is none. It may be infinite."
    (let s = (storage kept))
    (if (and (== (arr:aref (.state s) 2) 1) (< position (arr:aref (.state s) 1)))
        (inline (restored (arr:aref (.bounds s) position) (arr:aref (.scale s) 0)))
        -1.0d0))

  (declare gap-bound (KeptRows -> F64))
  (define (gap-bound kept)
    "With r rows kept: an upper bound on singular value r + 1 of the matrix the bounds were last proved for, the root of the sum of the squared residual bounds, rounded upward. Zero when no row is left out; -1 when no bounds stand. It may be infinite."
    (let s = (storage kept))
    (cond
      ((/= (arr:aref (.state s) 2) 1) -1.0d0)
      ((== (arr:aref (.state s) 1) 0) 0.0d0)
      (True (inline (restored (arr:aref (.scale s) 2) (arr:aref (.scale s) 0))))))

  (declare largest-singular-bounds! (csc:Matrix * UFix * arr:LispArray F64 * arr:LispArray F64
                                     * arr:LispArray F64 -> Void))
  (define (largest-singular-bounds! matrix steps work-columns work-rows out)
    "Write into out[0] a lower bound and into out[1] an upper bound on the largest singular value of a stored matrix. The upper is (norm-1 * norm-infinity)^(1/2), rounded upward. The lower is the length of J v over that of v after steps of the power method from the vector of ones, lowered by a bound on the rounding of that one product and of the two lengths; 0 when it cannot be had. work-columns has a column's length and work-rows a row's, and both are overwritten. See docs/rank-deficient.md."
    (let m = (csc:row-count matrix))
    (let n = (csc:column-count matrix))
    (unless (and (== (arr:length work-columns) n) (and (== (arr:length work-rows) m) (>= (arr:length out) 2)))
      (throw (err:InvalidDimensions "The work vectors must have the matrix's column and row counts, and the output two entries.")))
    (when (or (unsafe-pointer-eq? work-columns work-rows)
              (or (unsafe-pointer-eq? out work-columns) (unsafe-pointer-eq? out work-rows)))
      (throw (err:InvalidAliasing "The two work vectors and the output must be three arrays.")))
    (let pointers = (csc:column-pointers matrix))
    (let indices = (csc:row-indices matrix))
    (let values = (csc:entries matrix))
    ;; Everything on the matrix divided by the power of two at its largest entry.
    (let largest = (cell:new 0.0d0))
    (for ((q 0 (+ q 1))) :while (< q (arr:length values))
      (when (> (abs (arr:aref values q)) (cell:read largest)) (cell:write! largest (abs (arr:aref values q)))))
    (fp:binade! (cell:read largest) out 0)
    (let up = (arr:aref out 0))
    (let down = (arr:aref out 1))
    ;; The upper bound: the largest column sum and the largest row sum of magnitudes.
    (let widest = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i m)
      (arr:set! work-rows i 0.0d0))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let sum = (cell:new 0.0d0))
      (for ((q (arr:aref pointers j) (+ q 1))) :while (< q (arr:aref pointers (+ j 1)))
        (let a = (abs (* (arr:aref values q) down)))
        (cell:write! sum (+ (cell:read sum) a))
        (arr:set! work-rows (arr:aref indices q) (+ (arr:aref work-rows (arr:aref indices q)) a)))
      (when (> (cell:read sum) (cell:read widest)) (cell:write! widest (cell:read sum))))
    (let tallest = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i m)
      (when (> (arr:aref work-rows i) (cell:read tallest)) (cell:write! tallest (arr:aref work-rows i))))
    (let terms = (fp:count->float (+ (+ m n) 4)))
    (let upper = (* (+ 1.0d0 (* (* 4.0d0 fp:unit-roundoff) terms))
                    (math:sqrt (* (cell:read widest) (cell:read tallest)))))
    ;; The lower bound. v starts as ones; each step is v <- J^T (J v), divided by its largest
    ;; entry so that nothing grows. The last product J v is the one the bound is read from.
    (for ((j 0 (+ j 1))) :while (< j n)
      (arr:set! work-columns j 1.0d0))
    (let product-length = (cell:new 0.0d0))
    (let product-slack = (cell:new 0.0d0))
    (let vector-length = (cell:new 0.0d0))
    (for ((step 0 (+ step 1))) :while (<= step steps)
      (for ((i 0 (+ i 1))) :while (< i m)
        (arr:set! work-rows i 0.0d0))
      (for ((j 0 (+ j 1))) :while (< j n)
        (for ((q (arr:aref pointers j) (+ q 1))) :while (< q (arr:aref pointers (+ j 1)))
          (arr:set! work-rows (arr:aref indices q)
                    (+ (arr:aref work-rows (arr:aref indices q))
                       (* (* (arr:aref values q) down) (arr:aref work-columns j))))))
      (when (== step steps)
         ;; The lengths of this J v and of this v, and what the product's rounding can have added:
         ;; each entry is within gamma(c) of the sum of its terms' magnitudes, c a row's count,
         ;; here bounded by the column count.
         (let squares = (cell:new 0.0d0))
         (for ((i 0 (+ i 1))) :while (< i m)
           (cell:write! squares (+ (cell:read squares) (* (arr:aref work-rows i) (arr:aref work-rows i)))))
         (cell:write! product-length (math:sqrt (cell:read squares)))
         (let lengths = (cell:new 0.0d0))
         (for ((j 0 (+ j 1))) :while (< j n)
           (cell:write! lengths (+ (cell:read lengths) (* (arr:aref work-columns j) (arr:aref work-columns j)))))
         (cell:write! vector-length (math:sqrt (cell:read lengths)))
         ;; |J| |v| by rows, for the slack.
         (for ((i 0 (+ i 1))) :while (< i m)
           (arr:set! work-rows i 0.0d0))
         (for ((j 0 (+ j 1))) :while (< j n)
           (for ((q (arr:aref pointers j) (+ q 1))) :while (< q (arr:aref pointers (+ j 1)))
             (arr:set! work-rows (arr:aref indices q)
                       (+ (arr:aref work-rows (arr:aref indices q))
                          (abs (* (* (arr:aref values q) down) (arr:aref work-columns j)))))))
         (let slack = (cell:new 0.0d0))
         (for ((i 0 (+ i 1))) :while (< i m)
           (cell:write! slack (+ (cell:read slack) (* (arr:aref work-rows i) (arr:aref work-rows i)))))
         (cell:write! product-slack (math:sqrt (cell:read slack))))
      (unless (== step steps)
         ;; v <- J^T (J v), then divided by its largest entry.
         (let peak = (cell:new 0.0d0))
         (for ((j 0 (+ j 1))) :while (< j n)
           (let sum = (cell:new 0.0d0))
           (for ((q (arr:aref pointers j) (+ q 1))) :while (< q (arr:aref pointers (+ j 1)))
             (cell:write! sum (+ (cell:read sum) (* (* (arr:aref values q) down) (arr:aref work-rows (arr:aref indices q))))))
           (arr:set! work-columns j (cell:read sum))
           (when (> (abs (cell:read sum)) (cell:read peak)) (cell:write! peak (abs (cell:read sum)))))
         (cond
           ((and (> (cell:read peak) 0.0d0) (inline (math:finite? (cell:read peak))))
            (for ((j 0 (+ j 1))) :while (< j n)
              (arr:set! work-columns j (/ (arr:aref work-columns j) (cell:read peak)))))
           (True
            (for ((j 0 (+ j 1))) :while (< j n)
              (arr:set! work-columns j 1.0d0))))))
    ;; sigma_1 >= |J v| / |v| for the exact product and lengths. The computed product is within
    ;; gamma(n + 2) |J| |v| of the exact one, entry by entry; the computed lengths within a
    ;; factor 1 + (k + 4) u of theirs. All three are allowed for, downward.
    (let reach = (fp:count->float (+ n 2)))
    (let relative = (/ (* reach fp:unit-roundoff) (- 1.0d0 (* reach fp:unit-roundoff))))
    (let margin = (* (* 4.0d0 fp:unit-roundoff) terms))
    (let numerator = (- (* (cell:read product-length) (- 1.0d0 margin))
                        (* (* relative (cell:read product-slack)) (+ 1.0d0 margin))))
    (let denominator = (* (cell:read vector-length) (+ 1.0d0 margin)))
    (let lower = (if (and (> numerator 0.0d0) (and (> denominator 0.0d0) (inline (math:finite? denominator))))
                     (/ numerator denominator)
                     0.0d0))
    (arr:set! out 0 (* (* lower (- 1.0d0 margin)) up))
    (arr:set! out 1 (inline (restored upper up))))

  (declare try-floor! (KeptStorage * aug:AugmentedPlan * ldlt:Symbolic * F64 -> UFix))
  (define (try-floor! s plan symbolic bound)
    "Ask the inertia certificate that every singular value of the kept rows, divided, exceeds bound, with t = s = bound: 0 proved; 1 not proved by a factorization whose own error is under an eighth of the bound; 2 not proved, and the error is not."
    (let n = (.columns s))
    (let r = (- (.rows s) (arr:aref (.state s) 1)))
    (let values = (cell:read (.kept-values s)))
    (let augmented = (cell:read (.augmented s)))
    (let factor = (ldlt:symbolic-factor symbolic))
    (let margin = (cell:new 0.0d0))
    (let outcome = (cell:new (the UFix 2)))
    (let rounds = (cell:new (the UFix 0)))
    (for () :while (< (cell:read rounds) 4)
      (cell:write! rounds (+ (cell:read rounds) 1))
      (let written = (+ bound (cell:read margin)))
      (aug:refill! plan values written (- 0.0d0 written) augmented)
      (cond
        ((/= (ldlt:factor-signed! symbolic augmented 0.0d0) ldlt:SignedSuccess)
         (cell:write! outcome 2)
         (cell:write! rounds 4)
         Unit)
        (True
         (let beta = (ldlt:factor-backward-bound factor))
         (let counted = (and (== (ldlt:positive-pivot-count factor) n) (== (ldlt:negative-pivot-count factor) r)))
         (let small = (and (inline (math:finite? beta)) (<= (* 8.0d0 beta) bound)))
         (cond
           ((not (inline (math:finite? beta)))
            (cell:write! outcome 2)
            (cell:write! rounds 4)
            Unit)
           ((not counted)
            (cell:write! outcome (if small 1 2))
            (cell:write! rounds 4)
            Unit)
           ((>= (- written bound) (* beta (+ 1.0d0 (* 4.0d0 fp:unit-roundoff))))
            (cell:write! outcome 0)
            (cell:write! rounds 4)
            Unit)
           (True
            (cell:write! outcome (if small 1 2))
            (cell:write! margin (* 2.0d0 (if (> (cell:read margin) beta) (cell:read margin) beta)))
            Unit)))))
    (cell:read outcome))

  (declare certify! (KeptRows * F64 * F64 -> CertificateStatus))
  (define (certify! kept lower-floor upper-floor)
    "Ask that no singular value of the matrix the bounds were last proved for lie between two floors, in its own units: the gap bound below the lower, and every singular value of the kept rows above the upper, the second proved by the inertia of their augmented matrix. The bound proved on the kept rows is as large as a short ladder of trials finds and is read by proved-lower-bound. See docs/rank-deficient.md."
    (let s = (storage kept))
    (let st = (.state s))
    (arr:set! st 3 0)
    (withdraw-step! st)
    (arr:set! (.scale s) 3 -1.0d0)
    (unless (and (== (arr:aref st 0) 1) (== (arr:aref st 2) 1)) (return CertificateNothingKept))
    (unless (and (> lower-floor 0.0d0)
                 (and (>= upper-floor lower-floor) (inline (math:finite? upper-floor))))
      (return CertificateBadFloor))
    (let up = (arr:aref (.scale s) 0))
    (let down = (arr:aref (.scale s) 1))
    (unless (< (inline (restored (arr:aref (.scale s) 2) up)) lower-floor) (return CertificateGapAboveFloor))
    (let plan = (match (cell:read (.plan s)) ((Some held) held) ((None) (return CertificateNothingKept))))
    (let symbolic = (match (cell:read (.symbolic s)) ((Some held) held) ((None) (return CertificateNothingKept))))
    ;; The kept rows' values, divided, in their own stored order.
    (let positions = (cell:read (.kept-positions s)))
    (let values = (cell:read (.kept-values s)))
    (for ((q 0 (+ q 1))) :while (< q (arr:length positions))
      (arr:set! values q (arr:aref (.entries s) (arr:aref positions q))))
    ;; The floor in the divided units. A ladder of bounds from the one that served last time, or
    ;; from an eighth, down by fours to the floor; the first proved is the bound.
    (let target = (* upper-floor down))
    (unless (and (> target 0.0d0) (inline (math:finite? target))) (return CertificateUnresolved))
    (let remembered = (arr:aref (.scale s) 4))
    (let trial = (cell:new (if (> remembered target) remembered 0.125d0)))
    (let verdict = (cell:new (the UFix 2)))
    (let proved = (cell:new 0.0d0))
    (for () :while (and (== (cell:read proved) 0.0d0) (> (cell:read trial) target))
      (cell:write! verdict (try-floor! s plan symbolic (cell:read trial)))
      (cond
        ((== (cell:read verdict) 0) (cell:write! proved (cell:read trial)))
        (True (cell:write! trial (* 0.25d0 (cell:read trial))))))
    (when (== (cell:read proved) 0.0d0)
      (cell:write! verdict (try-floor! s plan symbolic target))
      (when (== (cell:read verdict) 0) (cell:write! proved target)))
    (cond
      ((> (cell:read proved) 0.0d0)
       (arr:set! (.scale s) 4 (cell:read proved))
       ;; Back in the caller's units, downward: the statement is that every singular value exceeds it.
       (let bound = (* (cell:read proved) up))
       (arr:set! (.scale s) 3 (if (inline (math:finite? bound)) bound fp:greatest))
       (arr:set! st 3 1)
       Certified)
      ((== (cell:read verdict) 1) CertificateKeptNotAboveFloor)
      (True CertificateUnresolved)))

  (declare certified? (KeptRows -> Boolean))
  (define (certified? kept)
    "Whether a certificate stands: the latest certify! returned Certified and neither a search nor a reproof came since."
    (== (arr:aref (.state (storage kept)) 3) 1))

  (declare proved-lower-bound (KeptRows -> F64))
  (define (proved-lower-bound kept)
    "The bound the standing certificate proved: every singular value of the kept rows, and so the kept count's largest of the matrix, exceeds it. At least the upper floor asked for; -1 when no certificate stands."
    (arr:aref (.scale (storage kept)) 3))

  ;;; The step. See docs/rank-deficient.md, The step, and docs/design-rank-deficient-step.md.

  (derive Eq)
  (repr :enum)
  (define-type StepStatus
    "Outcome of a step on the certified kept rows."
    StepTaken
    "The step was written and its two bounds stand."
    StepNoCertificate
    "No certificate stands for the values held; nothing was written."
    StepBadSize
    "The residual has not the row count, or the output not the column count; nothing was written."
    StepNonFiniteRhs
    "An entry of the residual was not finite; nothing was written."
    StepFactorRefused
    "The system of the rows left out, or the kept rows' solve, could not be factored; nothing was written."
    StepBoundNotReached
    "A residual was not finite, the refinement was still at least halving its bound at its last correction, or four times the gap bound is not below the bound proved on the kept rows; nothing was written."
    StepNonFiniteResult
    "The step cannot be held in the caller's units; nothing was written.")

  (declare correction-limit UFix)
  (define correction-limit
    "The most corrections a step's refinement makes after its first solve: 8. A correction contracts by 2^-10 or better while it is above rounding, so six exhaust the precision and two are left for corrections that halve the bound by chance at the bottom."
    8)

  (declare solve-shift F64)
  (define solve-shift
    "The solve's bottom block over its top block, 2^-10: with the top block at the bound the certificate proved, the contraction of a correction is below 2^-10 in exact arithmetic."
    9.765625d-4)

  (inline)
  (declare rounding (UFix -> F64))
  (define (rounding terms)
    "k u / (1 - k u): what a sum of k rounded operations can be off by, relative to the sum of its terms' magnitudes."
    (let k = (fp:count->float terms))
    (/ (* k fp:unit-roundoff) (- 1.0d0 (* k fp:unit-roundoff))))

  (declare left-out-product! (KeptStorage * StepStorage * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (left-out-product! s ws source target)
    "target = W source: for each row left out, its multipliers against a vector over the kept rows."
    (let d = (arr:aref (.state s) 1))
    (let starts = (.vector-starts s))
    (let numbers = (.numbers ws))
    (let vector-rows = (cell:read (.vector-rows s)))
    (let vector-values = (cell:read (.vector-values s)))
    (for ((p 0 (+ p 1))) :while (< p d)
      (let sum = (cell:new 0.0d0))
      (for ((e (arr:aref starts p) (+ e 1))) :while (< e (arr:aref starts (+ p 1)))
        (cell:write! sum (- (cell:read sum)
                            (* (arr:aref vector-values e)
                               (arr:aref source (arr:aref numbers (arr:aref vector-rows e)))))))
      (arr:set! target p (cell:read sum))))

  (declare project! (KeptStorage * StepStorage * arr:LispArray F64 * arr:LispArray F64 -> Boolean))
  (define (project! s ws source target)
    "target = (I + W^T W)^-1 source, as source - W^T (I + W W^T)^-1 W source; the two arrays are distinct. False when the system's solve refuses."
    (let d = (arr:aref (.state s) 1))
    (let r = (- (.rows s) d))
    (for ((k 0 (+ k 1))) :while (< k r)
      (arr:set! target k (arr:aref source k)))
    (match (cell:read (.system ws))
      ((None) True)
      ((Some held)
       (left-out-product! s ws source (.out-values ws))
       (if (== (ldlt:solve! (ldlt:symbolic-factor (.symbolic held)) (.out-values ws) (.out-solved ws)) ldlt:SolveSuccess)
           (progn
             (let starts = (.vector-starts s))
             (let numbers = (.numbers ws))
             (let vector-rows = (cell:read (.vector-rows s)))
             (let vector-values = (cell:read (.vector-values s)))
             (let solved = (.out-solved ws))
             (for ((p 0 (+ p 1))) :while (< p d)
               (for ((e (arr:aref starts p) (+ e 1))) :while (< e (arr:aref starts (+ p 1)))
                 (let k = (arr:aref numbers (arr:aref vector-rows e)))
                 (arr:set! target k (+ (arr:aref target k) (* (arr:aref vector-values e) (arr:aref solved p))))))
             True)
           False))))

  (declare system-residual! (KeptStorage * StepStorage * arr:LispArray F64 -> Void))
  (define (system-residual! s ws candidate)
    "For a candidate y over the kept rows: leave C^T (r - C y), as computed, in the kept sums, and in figures[9] an upper bound on the 2-norm of the exact one, or infinity. C is the identity on the kept rows over W."
    (let m = (.rows s))
    (let d = (arr:aref (.state s) 1))
    (let r = (- m d))
    (let flags = (.flags s))
    (let numbers = (.numbers ws))
    (let left = (rows:left-out-rows (.analysis s)))
    (let starts = (.vector-starts s))
    (let vector-rows = (cell:read (.vector-rows s)))
    (let vector-values = (cell:read (.vector-values s)))
    (let residual = (.residual ws))
    (let sums = (.kept-sums ws))
    (let magnitudes = (.kept-magnitudes ws))
    (let extras = (.kept-extras ws))
    (let out-values = (.out-values ws))
    (let out-errors = (.out-errors ws))
    ;; The rows left out: r_t - (W y)_t, and what its rounding can be.
    (for ((p 0 (+ p 1))) :while (< p d)
      (let own = (arr:aref residual (arr:aref left p)))
      (let sum = (cell:new own))
      (let magnitude = (cell:new (abs own)))
      (for ((e (arr:aref starts p) (+ e 1))) :while (< e (arr:aref starts (+ p 1)))
        (let product = (* (arr:aref vector-values e) (arr:aref candidate (arr:aref numbers (arr:aref vector-rows e)))))
        (cell:write! sum (+ (cell:read sum) product))
        (cell:write! magnitude (+ (cell:read magnitude) (abs product))))
      (let terms = (+ (- (arr:aref starts (+ p 1)) (arr:aref starts p)) 1))
      (arr:set! out-values p (cell:read sum))
      (arr:set! out-errors p (+ (* (rounding (+ (* 2 terms) 2)) (cell:read magnitude))
                                (* (fp:count->float terms) fp:least-positive))))
    ;; The kept rows: (r_k - y_k) + (W^T of the above)_k.
    (for ((i 0 (+ i 1))) :while (< i m)
      (when (== (arr:aref flags i) 1)
        (let k = (arr:aref numbers i))
        (arr:set! sums k (- (arr:aref residual i) (arr:aref candidate k)))
        (arr:set! magnitudes k (+ (abs (arr:aref residual i)) (abs (arr:aref candidate k))))
        (arr:set! extras k 0.0d0)))
    (for ((p 0 (+ p 1))) :while (< p d)
      (for ((e (arr:aref starts p) (+ e 1))) :while (< e (arr:aref starts (+ p 1)))
        (let k = (arr:aref numbers (arr:aref vector-rows e)))
        (let product = (* (arr:aref vector-values e) (arr:aref out-values p)))
        (arr:set! sums k (- (arr:aref sums k) product))
        (arr:set! magnitudes k (+ (arr:aref magnitudes k) (abs product)))
        (arr:set! extras k (+ (arr:aref extras k) (* (abs (arr:aref vector-values e)) (arr:aref out-errors p))))))
    (let total = (cell:new 0.0d0))
    (for ((k 0 (+ k 1))) :while (< k r)
      (let terms = (+ (arr:aref (.uses ws) k) 2))
      (let relative = (rounding (+ (* 2 terms) 2)))
      (let entry = (+ (+ (abs (arr:aref sums k)) (* relative (arr:aref magnitudes k)))
                      (+ (* (+ 1.0d0 relative) (arr:aref extras k)) (* (fp:count->float terms) fp:least-positive))))
      (cell:write! total (+ (cell:read total) (* entry entry))))
    (let order = (fp:count->float r))
    (let padded = (+ (cell:read total) (* order fp:least-positive)))
    (arr:set! (.figures ws) 9
              (if (inline (math:finite? padded))
                  (* (+ 1.0d0 (* (* 2.0d0 fp:unit-roundoff) (+ order 10.0d0))) (math:sqrt padded))
                  fp:infinity)))

  (declare saddle-residual! (KeptStorage * StepStorage * F64 -> Void))
  (define (saddle-residual! s ws tau)
    "For the iterate [x; l] in the unknown and y: leave [0; y] - K [x; l] in the defect, K = [[tau I, J_S^T], [J_S, 0]], and in figures[8] an upper bound on the 2-norm of x - J_S^+ y: the root of the sum of the squares of the two exact residuals' norms, over tau. It may be infinite."
    (let m = (.rows s))
    (let n = (.columns s))
    (let d = (arr:aref (.state s) 1))
    (let r = (- m d))
    (let flags = (.flags s))
    (let numbers = (.numbers ws))
    (let starts = (.row-starts s))
    (let columns = (.row-columns s))
    (let positions = (.row-positions s))
    (let entries = (.entries s))
    (let unknown = (.unknown ws))
    (let defect = (.defect ws))
    (let y = (.y ws))
    (let sums = (.sums s))
    (let magnitudes = (.magnitudes s))
    (let by-rows = (+ (arr:aref (.longest ws) 0) 2))
    (let by-columns = (+ (arr:aref (.longest ws) 1) 2))
    (let row-relative = (rounding (+ (* 2 by-rows) 2)))
    (let column-relative = (rounding (+ (* 2 by-columns) 2)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let a = (* tau (arr:aref unknown j)))
      (arr:set! sums j (- 0.0d0 a))
      (arr:set! magnitudes j (abs a)))
    (let total = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i m)
      (when (== (arr:aref flags i) 1)
        (let k = (arr:aref numbers i))
        (let multiplier = (arr:aref unknown (+ n k)))
        (let sum = (cell:new (arr:aref y k)))
        (let magnitude = (cell:new (abs (arr:aref y k))))
        (for ((q (arr:aref starts i) (+ q 1))) :while (< q (arr:aref starts (+ i 1)))
          (let j = (arr:aref columns q))
          (let a = (arr:aref entries (arr:aref positions q)))
          (let above = (* a multiplier))
          (arr:set! sums j (- (arr:aref sums j) above))
          (arr:set! magnitudes j (+ (arr:aref magnitudes j) (abs above)))
          (let across = (* a (arr:aref unknown j)))
          (cell:write! sum (- (cell:read sum) across))
          (cell:write! magnitude (+ (cell:read magnitude) (abs across))))
        (arr:set! defect (+ n k) (cell:read sum))
        (let entry = (+ (+ (abs (cell:read sum)) (* row-relative (cell:read magnitude)))
                        (* (fp:count->float by-rows) fp:least-positive)))
        (cell:write! total (+ (cell:read total) (* entry entry)))))
    (for ((j 0 (+ j 1))) :while (< j n)
      (arr:set! defect j (arr:aref sums j))
      (let entry = (+ (+ (abs (arr:aref sums j)) (* column-relative (arr:aref magnitudes j)))
                      (* (fp:count->float by-columns) fp:least-positive)))
      (cell:write! total (+ (cell:read total) (* entry entry)))
      (arr:set! sums j 0.0d0)
      (arr:set! magnitudes j 0.0d0))
    (let order = (fp:count->float (+ n r)))
    (let padded = (+ (cell:read total) (* order fp:least-positive)))
    (arr:set! (.figures ws) 8
              (if (inline (math:finite? padded))
                  (/ (* (+ 1.0d0 (* (* 2.0d0 fp:unit-roundoff) (+ order 12.0d0))) (math:sqrt padded)) tau)
                  fp:infinity)))

  (declare whole-residual! (KeptStorage * StepStorage -> Void))
  (define (whole-residual! s ws)
    "For the kept iterate x: leave in figures[10] an upper bound on the 2-norm of r - J x over every row, exact product, and in figures[11] an upper bound on the largest singular value of J, the root of its 1-norm times its infinity-norm; both for the divided values, and either may be infinite."
    (let m = (.rows s))
    (let n = (.columns s))
    (let starts = (.row-starts s))
    (let columns = (.row-columns s))
    (let positions = (.row-positions s))
    (let entries = (.entries s))
    (let residual = (.residual ws))
    (let x = (.best ws))
    (let sums = (.sums s))
    (let by-rows = (+ (arr:aref (.longest ws) 0) 1))
    (let relative = (rounding (+ (* 2 by-rows) 2)))
    (let total = (cell:new 0.0d0))
    (let tallest = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i m)
      (let sum = (cell:new (arr:aref residual i)))
      (let magnitude = (cell:new (abs (arr:aref residual i))))
      (let across = (cell:new 0.0d0))
      (for ((q (arr:aref starts i) (+ q 1))) :while (< q (arr:aref starts (+ i 1)))
        (let j = (arr:aref columns q))
        (let a = (arr:aref entries (arr:aref positions q)))
        (let product = (* a (arr:aref x j)))
        (cell:write! sum (- (cell:read sum) product))
        (cell:write! magnitude (+ (cell:read magnitude) (abs product)))
        (cell:write! across (+ (cell:read across) (abs a)))
        (arr:set! sums j (+ (arr:aref sums j) (abs a))))
      (when (> (cell:read across) (cell:read tallest)) (cell:write! tallest (cell:read across)))
      (let entry = (+ (+ (abs (cell:read sum)) (* relative (cell:read magnitude)))
                      (* (fp:count->float by-rows) fp:least-positive)))
      (cell:write! total (+ (cell:read total) (* entry entry))))
    (let widest = (cell:new 0.0d0))
    (for ((j 0 (+ j 1))) :while (< j n)
      (when (> (arr:aref sums j) (cell:read widest)) (cell:write! widest (arr:aref sums j)))
      (arr:set! sums j 0.0d0))
    (let order = (fp:count->float m))
    (let padded = (+ (cell:read total) (* order fp:least-positive)))
    (arr:set! (.figures ws) 10
              (if (inline (math:finite? padded))
                  (* (+ 1.0d0 (* (* 2.0d0 fp:unit-roundoff) (+ order 10.0d0))) (math:sqrt padded))
                  fp:infinity))
    (arr:set! (.figures ws) 11
              (* (+ 1.0d0 (* (* 4.0d0 fp:unit-roundoff) (fp:count->float (+ (+ m n) 4))))
                 (math:sqrt (* (cell:read widest) (cell:read tallest))))))

  (inline)
  (declare unscaled (F64 * F64 * F64 -> F64))
  (define (unscaled value by-residual by-matrix)
    "A quantity of the divided problem in the caller's units: times the residual's power of two and over the matrix's, together where their product can be held and one after the other where it cannot."
    (let together = (* by-residual by-matrix))
    (if (or (== together 0.0d0) (not (inline (math:finite? together))))
        (* (* value by-residual) by-matrix)
        (* value together)))

  (declare step! (KeptRows * arr:LispArray F64 * arr:LispArray F64 -> StepStatus))
  (define (step! kept r out)
    "Write the step -B^+ r for the matrix the standing certificate is of: B is that matrix with each row left out replaced by its kept combination of the kept rows, and B^+ r is its minimum-norm least squares solution. Two bounds then stand: on the distance from the exact step for B, and on the distance from the step of the matrix truncated at the kept count. Needs a standing certificate; allocates nothing. See docs/rank-deficient.md."
    (let s = (storage kept))
    (let st = (.state s))
    (arr:set! st 5 0)
    (unless (== (arr:aref st 3) 1) (return StepNoCertificate))
    (let ws = (match (cell:read (.step s)) ((Some held) held) ((None) (return StepNoCertificate))))
    (let plan = (match (cell:read (.plan s)) ((Some held) held) ((None) (return StepNoCertificate))))
    (let symbolic = (match (cell:read (.symbolic s)) ((Some held) held) ((None) (return StepNoCertificate))))
    (let m = (.rows s))
    (let n = (.columns s))
    (let d = (arr:aref st 1))
    (let kept-count = (- m d))
    (unless (and (== (arr:length r) m) (== (arr:length out) n)) (return StepBadSize))
    (let largest = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i m)
      (let a = (abs (arr:aref r i)))
      (unless (inline (math:finite? a)) (return StepNonFiniteRhs))
      (when (> a (cell:read largest)) (cell:write! largest a)))
    (let figures = (.figures ws))
    (let marks = (.marks ws))
    (when (== (arr:aref marks 0) 0) (return StepFactorRefused))
    ;; The solve's factor, unless it already stands for this certificate. tau and the gap bound
    ;; are the ones the standing certificate was issued on, in the divided matrix's units.
    (let tau = (arr:aref (.scale s) 4))
    (let gap = (arr:aref (.scale s) 2))
    (let factor = (ldlt:symbolic-factor symbolic))
    (when (/= (arr:aref st 4) 1)
      (let augmented = (cell:read (.augmented s)))
      (aug:refill! plan (cell:read (.kept-values s)) tau (* tau solve-shift) augmented)
      (unless (== (ldlt:factor-signed! symbolic augmented 0.0d0) ldlt:SignedSuccess)
        (return StepFactorRefused))
      (unless (and (== (ldlt:positive-pivot-count factor) n) (== (ldlt:negative-pivot-count factor) kept-count))
        (return StepFactorRefused))
      (let beta = (ldlt:factor-backward-bound factor))
      (let eta = (/ (* 2.0d0 beta) tau))
      (arr:set! figures 2 (ldlt:factor-growth factor))
      (arr:set! figures 3 beta)
      (arr:set! figures 4 (if (< eta 1.0d0) (/ (+ solve-shift eta) (- 1.0d0 eta)) fp:infinity))
      (arr:set! st 4 1))
    ;; The residual divided by the power of two at its largest entry.
    (fp:binade! (cell:read largest) figures 5)
    (let residual = (.residual ws))
    (for ((i 0 (+ i 1))) :while (< i m)
      (arr:set! residual i (* (arr:aref r i) (arr:aref figures 6))))
    ;; y = C^+ r: z = C^T r, then (I + W^T W) y = z, and corrections while the proved residual
    ;; at least halves, the candidate with the smallest kept.
    (let flags = (.flags s))
    (let numbers = (.numbers ws))
    (let left = (rows:left-out-rows (.analysis s)))
    (let starts = (.vector-starts s))
    (let vector-rows = (cell:read (.vector-rows s)))
    (let vector-values = (cell:read (.vector-values s)))
    (let z = (.z ws))
    (let y = (.y ws))
    (let trial = (.trial ws))
    (for ((i 0 (+ i 1))) :while (< i m)
      (when (== (arr:aref flags i) 1)
        (arr:set! z (arr:aref numbers i) (arr:aref residual i))))
    (for ((p 0 (+ p 1))) :while (< p d)
      (let own = (arr:aref residual (arr:aref left p)))
      (for ((e (arr:aref starts p) (+ e 1))) :while (< e (arr:aref starts (+ p 1)))
        (let k = (arr:aref numbers (arr:aref vector-rows e)))
        (arr:set! z k (- (arr:aref z k) (* (arr:aref vector-values e) own)))))
    (unless (project! s ws z y) (return StepBoundNotReached))
    (system-residual! s ws y)
    (let system-bound = (cell:new (arr:aref figures 9)))
    (unless (inline (math:finite? (cell:read system-bound))) (return StepBoundNotReached))
    (let system-going = (cell:new True))
    (let system-corrections = (cell:new (the UFix 0)))
    (for () :while (and (cell:read system-going) (< (cell:read system-corrections) correction-limit))
      (cell:write! system-corrections (+ (cell:read system-corrections) 1))
      ;; The kept sums hold the residual of y as it stands: a candidate is taken whenever it
      ;; is the better, and the corrections go on only from a candidate that was taken.
      (let projected = (project! s ws (.kept-sums ws) trial))
      (unless projected (cell:write! system-going False))
      (when projected
        (for ((k 0 (+ k 1))) :while (< k kept-count)
          (arr:set! trial k (+ (arr:aref y k) (arr:aref trial k))))
        (system-residual! s ws trial)
        (let bound = (arr:aref figures 9))
        (let halved = (<= (* 2.0d0 bound) (cell:read system-bound)))
        (when (< bound (cell:read system-bound))
          (cell:write! system-bound bound)
          (for ((k 0 (+ k 1))) :while (< k kept-count)
            (arr:set! y k (arr:aref trial k))))
        (unless halved
          (cell:write! system-going False))))
    ;; x = J_S^+ y through the augmented matrix: a first solve, then corrections against the
    ;; matrix with no bottom block, the iterate with the smallest proved bound kept.
    (let order = (+ n kept-count))
    (let unknown = (.unknown ws))
    (let best = (.best ws))
    (let defect = (.defect ws))
    (let change = (.change ws))
    (for ((q 0 (+ q 1))) :while (< q n)
      (arr:set! defect q 0.0d0))
    (for ((k 0 (+ k 1))) :while (< k kept-count)
      (arr:set! defect (+ n k) (arr:aref y k)))
    (unless (== (ldlt:solve! factor defect unknown) ldlt:SolveSuccess) (return StepBoundNotReached))
    (saddle-residual! s ws tau)
    (let smallest = (cell:new (arr:aref figures 8)))
    (unless (inline (math:finite? (cell:read smallest))) (return StepBoundNotReached))
    (for ((q 0 (+ q 1))) :while (< q order)
      (arr:set! best q (arr:aref unknown q)))
    (let corrections = (cell:new (the UFix 0)))
    (let going = (cell:new True))
    (let unfinished = (cell:new False))
    (for () :while (and (cell:read going) (< (cell:read corrections) correction-limit))
      (unless (== (ldlt:solve! factor defect change) ldlt:SolveSuccess) (return StepBoundNotReached))
      (for ((q 0 (+ q 1))) :while (< q order)
        (arr:set! unknown q (+ (arr:aref unknown q) (arr:aref change q))))
      (cell:write! corrections (+ (cell:read corrections) 1))
      (saddle-residual! s ws tau)
      (let bound = (arr:aref figures 8))
      (unless (inline (math:finite? bound)) (return StepBoundNotReached))
      (let halved = (<= (* 2.0d0 bound) (cell:read smallest)))
      (when (< bound (cell:read smallest))
        (cell:write! smallest bound)
        (for ((q 0 (+ q 1))) :while (< q order)
          (arr:set! best q (arr:aref unknown q))))
      (when (and halved (== (cell:read corrections) correction-limit))
        (cell:write! unfinished True))
      (unless halved
        (cell:write! going False)))
    (when (cell:read unfinished) (return StepBoundNotReached))
    ;; The solve's bound: the kept rows' solve, and the error of y carried through J_S^+.
    (let margin = (+ 1.0d0 (* 64.0d0 fp:unit-roundoff)))
    (let solve-bound = (* margin (+ (cell:read smallest) (/ (cell:read system-bound) tau))))
    ;; The distance to the step of the matrix truncated at the kept count. With X bounding the
    ;; exact step's norm and rho the residual outside the range,
    ;;   delta <= 2 gap (2 X / tau + rho / tau^2) / (1 - 4 gap / tau).
    (let squares = (cell:new 0.0d0))
    (for ((j 0 (+ j 1))) :while (< j n)
      (cell:write! squares (+ (cell:read squares) (* (arr:aref best j) (arr:aref best j)))))
    (let step-norm = (* (+ 1.0d0 (* (* 2.0d0 fp:unit-roundoff) (fp:count->float (+ n 10))))
                     (math:sqrt (+ (cell:read squares) (* (fp:count->float n) fp:least-positive)))))
    (whole-residual! s ws)
    (let reach = (* margin (+ step-norm solve-bound)))
    (let outside = (* margin (+ (+ (arr:aref figures 10) (* (arr:aref figures 11) solve-bound)) (* gap reach))))
    (let ratio = (/ (* 4.0d0 gap) tau))
    (unless (< (* margin ratio) 1.0d0) (return StepBoundNotReached))
    (let truncation = (/ (* margin (* (* 2.0d0 gap) (+ (/ (* 2.0d0 reach) tau) (/ (/ outside tau) tau))))
                         (- 1.0d0 (* margin ratio))))
    (let whole = (* margin (+ solve-bound truncation)))
    (unless (inline (math:finite? whole)) (return StepBoundNotReached))
    ;; Back to the caller's units, and against the residual: nothing is written unless all of it can be.
    (let by-residual = (arr:aref figures 5))
    (let by-matrix = (arr:aref (.scale s) 1))
    (for ((j 0 (+ j 1))) :while (< j n)
      (let v = (inline (unscaled (- 0.0d0 (arr:aref best j)) by-residual by-matrix)))
      (unless (inline (math:finite? v)) (return StepNonFiniteResult))
      (arr:set! change j v))
    (for ((j 0 (+ j 1))) :while (< j n)
      (arr:set! out j (arr:aref change j)))
    (arr:set! figures 0 (inline (restored (inline (unscaled solve-bound by-residual by-matrix)) 1.0d0)))
    (arr:set! figures 1 (inline (restored (inline (unscaled whole by-residual by-matrix)) 1.0d0)))
    (arr:set! marks 1 (cell:read corrections))
    (arr:set! st 5 1)
    StepTaken)

  (declare step-taken? (KeptRows -> Boolean))
  (define (step-taken? kept)
    "Whether a step stands: the latest step! returned StepTaken and neither a search, a reproof nor a certificate came since."
    (== (arr:aref (.state (storage kept)) 5) 1))

  (declare step-figure (KeptRows * UFix * UFix -> F64))
  (define (step-figure kept slot needed)
    "A figure of the step's storage while the state at needed is 1; -1 otherwise."
    (let s = (storage kept))
    (match (cell:read (.step s))
      ((Some ws) (if (== (arr:aref (.state s) needed) 1) (arr:aref (.figures ws) slot) -1.0d0))
      ((None) -1.0d0)))

  (declare step-solve-bound (KeptRows -> F64))
  (define (step-solve-bound kept)
    "For the standing step x and the residual it was taken on: an upper bound on the 2-norm of x + B^+ r, the distance from the exact step for B. -1 when no step stands. It may be infinite."
    (step-figure kept 0 5))

  (declare step-bound (KeptRows -> F64))
  (define (step-bound kept)
    "For the standing step x: an upper bound on the 2-norm of its distance from the step of the matrix truncated at the kept count, the minimum-norm least squares step a singular value decomposition cut at the certified floor gives. It includes the solve's bound. -1 when no step stands."
    (step-figure kept 1 5))

  (declare step-corrections (KeptRows -> UFix))
  (define (step-corrections kept)
    "Corrections the standing step's refinement made after its first solve; 0 when no step stands."
    (let s = (storage kept))
    (match (cell:read (.step s))
      ((Some ws) (if (== (arr:aref (.state s) 5) 1) (arr:aref (.marks ws) 1) 0))
      ((None) 0)))

  (declare solve-growth (KeptRows -> F64))
  (define (solve-growth kept)
    "The growth of the factor the steps since the standing certificate solve with; -1 when there is none. A diagnostic: nothing is refused on it."
    (step-figure kept 2 4))

  (declare solve-backward-bound (KeptRows -> F64))
  (define (solve-backward-bound kept)
    "The backward bound of that factor, in the divided matrix's units; -1 when there is none. A diagnostic."
    (step-figure kept 3 4))

  (declare predicted-rate (KeptRows -> F64))
  (define (predicted-rate kept)
    "What that backward bound predicts a correction's contraction to be at most, (2^-10 + e) / (1 - e) with e twice the bound over the proved lower bound, or infinity where e is 1 or more; -1 when there is none. A diagnostic: it overstates by decades, and the bounds a step returns do not use it."
    (step-figure kept 4 4))

  ;;; The refresh of kept vectors. See docs/rank-deficient.md, Refreshing the kept vectors.

  (derive Eq)
  (repr :enum)
  (define-type RefreshStatus
    "Outcome of proving the kept vectors' bounds for new values and replacing the vectors that no longer serve."
    Refreshed
    "Every bound stands for the values given; refreshed-count vectors were replaced."
    RefreshNothingKept
    "No kept set stands."
    RefreshBadTarget
    "The gap bound aimed at was not positive and finite; nothing changed."
    RefreshNoShift
    "No certificate has been issued for this kept set, so there is nothing to take the solve's shifts from; the bounds stand for the values given and no vector was replaced."
    RefreshFactorRefused
    "The kept rows' solve could not be factored; the bounds stand for the values given and no vector was replaced."
    RefreshNonFinite
    "A bound was not finite; the vectors stand, the bounds do not.")

  (declare refresh-residual! (KeptStorage * StepStorage * F64 * UFix -> Void))
  (define (refresh-residual! s ws tau row)
    "For the iterate [v; w] in the unknown: leave [a; 0] - K [v; w] in the defect, a being the row given and K = [[tau I, J_S^T], [J_S, 0]], and its 2-norm as computed in figures[8]. Nothing is proved by it."
    (let m = (.rows s))
    (let n = (.columns s))
    (let flags = (.flags s))
    (let numbers = (.numbers ws))
    (let starts = (.row-starts s))
    (let columns = (.row-columns s))
    (let positions = (.row-positions s))
    (let entries = (.entries s))
    (let unknown = (.unknown ws))
    (let defect = (.defect ws))
    (let sums = (.sums s))
    (for ((j 0 (+ j 1))) :while (< j n)
      (arr:set! sums j (- 0.0d0 (* tau (arr:aref unknown j)))))
    (for ((q (arr:aref starts row) (+ q 1))) :while (< q (arr:aref starts (+ row 1)))
      (let j = (arr:aref columns q))
      (arr:set! sums j (+ (arr:aref sums j) (arr:aref entries (arr:aref positions q)))))
    (let total = (cell:new 0.0d0))
    (for ((i 0 (+ i 1))) :while (< i m)
      (when (== (arr:aref flags i) 1)
        (let k = (arr:aref numbers i))
        (let multiplier = (arr:aref unknown (+ n k)))
        (let sum = (cell:new 0.0d0))
        (for ((q (arr:aref starts i) (+ q 1))) :while (< q (arr:aref starts (+ i 1)))
          (let j = (arr:aref columns q))
          (let a = (arr:aref entries (arr:aref positions q)))
          (arr:set! sums j (- (arr:aref sums j) (* a multiplier)))
          (cell:write! sum (- (cell:read sum) (* a (arr:aref unknown j)))))
        (arr:set! defect (+ n k) (cell:read sum))
        (cell:write! total (+ (cell:read total) (* (cell:read sum) (cell:read sum))))))
    (for ((j 0 (+ j 1))) :while (< j n)
      (arr:set! defect j (arr:aref sums j))
      (cell:write! total (+ (cell:read total) (* (arr:aref sums j) (arr:aref sums j))))
      (arr:set! sums j 0.0d0))
    (arr:set! (.figures ws) 8 (math:sqrt (cell:read total))))

  (declare refresh-solve! (KeptStorage * StepStorage * ldlt:NumericFactor * F64 * UFix * F64 -> Boolean))
  (define (refresh-solve! s ws factor tau row enough)
    "Leave in the best iterate's second block the multipliers of a row against the kept rows for the values held, w = (J_S J_S^T)^-1 J_S a, by the factor given and corrections while the residual is above enough and at least halves. False when a solve refuses or a residual is not finite."
    (let n = (.columns s))
    (let order = (+ n (- (.rows s) (arr:aref (.state s) 1))))
    (let unknown = (.unknown ws))
    (let best = (.best ws))
    (let defect = (.defect ws))
    (let change = (.change ws))
    (let figures = (.figures ws))
    (for ((q 0 (+ q 1))) :while (< q order)
      (arr:set! unknown q 0.0d0))
    (refresh-residual! s ws tau row)
    (unless (== (ldlt:solve! factor defect unknown) ldlt:SolveSuccess) (return False))
    (refresh-residual! s ws tau row)
    (let smallest = (cell:new (arr:aref figures 8)))
    (unless (inline (math:finite? (cell:read smallest))) (return False))
    (for ((q 0 (+ q 1))) :while (< q order)
      (arr:set! best q (arr:aref unknown q)))
    (let corrections = (cell:new (the UFix 0)))
    (let going = (cell:new True))
    (for () :while (and (and (cell:read going) (> (cell:read smallest) enough))
                        (< (cell:read corrections) correction-limit))
      (unless (== (ldlt:solve! factor defect change) ldlt:SolveSuccess) (return False))
      (for ((q 0 (+ q 1))) :while (< q order)
        (arr:set! unknown q (+ (arr:aref unknown q) (arr:aref change q))))
      (cell:write! corrections (+ (cell:read corrections) 1))
      (refresh-residual! s ws tau row)
      (let norm = (arr:aref figures 8))
      (unless (inline (math:finite? norm)) (return False))
      (let halved = (<= (* 2.0d0 norm) (cell:read smallest)))
      (when (< norm (cell:read smallest))
        (cell:write! smallest norm)
        (for ((q 0 (+ q 1))) :while (< q order)
          (arr:set! best q (arr:aref unknown q))))
      (unless halved
        (cell:write! going False)))
    True)

  (declare refresh! (KeptRows * csc:Matrix * F64 -> RefreshStatus))
  (define (refresh! kept matrix gap-target)
    "For a matrix of the analyzed pattern with other values: prove every kept vector's bound against them, as reprove! does, and replace each vector whose bound is above the share of gap-target a vector may have, gap-target over twice the root of the number left out, by the row's multipliers against the kept rows for these values. The kept set does not change, and no certificate stands afterwards. Nothing is proved by the solves that find the multipliers: each new vector's bound is proved for the vector as stored. Another pattern or shape raises the typed error of the Gram refill. See docs/rank-deficient.md."
    (let s = (storage kept))
    (let st = (.state s))
    (unless (== (arr:aref st 0) 1) (return RefreshNothingKept))
    (unless (and (> gap-target 0.0d0) (inline (math:finite? gap-target))) (return RefreshBadTarget))
    (let ws = (match (cell:read (.step s)) ((Some held) held) ((None) (return RefreshNothingKept))))
    (let plan = (match (cell:read (.plan s)) ((Some held) held) ((None) (return RefreshNothingKept))))
    (let symbolic = (match (cell:read (.symbolic s)) ((Some held) held) ((None) (return RefreshNothingKept))))
    (let marks = (.marks ws))
    (arr:set! st 2 0)
    (arr:set! st 3 0)
    (withdraw-step! st)
    (arr:set! (.scale s) 3 -1.0d0)
    (arr:set! marks 2 0)
    (rows:check-pattern! (.analysis s) matrix)
    (take-values! s matrix)
    (unless (prove-bounds! s) (return RefreshNonFinite))
    (arr:set! st 2 1)
    (let m = (.rows s))
    (let n = (.columns s))
    (let d = (arr:aref st 1))
    (let r = (- m d))
    (let bounds = (.bounds s))
    ;; A vector may have this much, in the divided units: with every bound under it the gap
    ;; bound is under half the target.
    (let share = (/ (* gap-target (arr:aref (.scale s) 1)) (* 2.0d0 (math:sqrt (fp:count->float (+ d 1))))))
    (let stale = (cell:new (the UFix 0)))
    (for ((p 0 (+ p 1))) :while (< p d)
      (when (> (arr:aref bounds p) share) (cell:write! stale (+ (cell:read stale) 1))))
    (when (== (cell:read stale) 0) (return Refreshed))
    ;; The shift of the solve is a bound a certificate proved at an earlier call. It is a shift
    ;; and nothing more: no bound of this call rests on it.
    (let tau = (arr:aref (.scale s) 4))
    (unless (> tau 0.0d0) (return RefreshNoShift))
    (let positions = (cell:read (.kept-positions s)))
    (let values = (cell:read (.kept-values s)))
    (for ((q 0 (+ q 1))) :while (< q (arr:length positions))
      (arr:set! values q (arr:aref (.entries s) (arr:aref positions q))))
    (let augmented = (cell:read (.augmented s)))
    (aug:refill! plan values tau (* tau solve-shift) augmented)
    (unless (== (ldlt:factor-signed! symbolic augmented 0.0d0) ldlt:SignedSuccess) (return RefreshFactorRefused))
    (let factor = (ldlt:symbolic-factor symbolic))
    (unless (and (== (ldlt:positive-pivot-count factor) n) (== (ldlt:negative-pivot-count factor) r))
      (return RefreshFactorRefused))
    ;; The vectors are written afresh into the spare arrays, a replaced one from its solve and
    ;; the others as they stand, and the arrays are then exchanged.
    (let left = (rows:left-out-rows (.analysis s)))
    (let starts = (.vector-starts s))
    (let fresh-starts = (.spare-starts s))
    (let kept-list = (.kept-list ws))
    (let best = (.best ws))
    (let drop = (arr:aref (.scale s) 5))
    (let filled = (cell:new (the UFix 0)))
    (let replaced = (cell:new (the UFix 0)))
    (let reshaped = (cell:new False))
    (arr:set! fresh-starts 0 0)
    (for ((p 0 (+ p 1))) :while (< p d)
      (let old-rows = (cell:read (.vector-rows s)))
      (let old-values = (cell:read (.vector-values s)))
      (let from = (arr:aref starts p))
      (let to = (arr:aref starts (+ p 1)))
      ;; A residual a sixteenth of a vector's share is as good as the vector needs.
      (let solved = (and (> (arr:aref bounds p) share)
                         (refresh-solve! s ws factor tau (arr:aref left p) (* 0.0625d0 share))))
      ;; The largest multiplier, whether all are finite, and how many reach the drop.
      (let largest = (cell:new 0.0d0))
      (let usable = (cell:new solved))
      (when solved
        (for ((k 0 (+ k 1))) :while (< k r)
          (let w = (abs (arr:aref best (+ n k))))
          (unless (inline (math:finite? w)) (cell:write! usable False))
          (when (> w (cell:read largest)) (cell:write! largest w))))
      (let cutoff = (* drop (cell:read largest)))
      (let wanted = (cell:new (- to from)))
      (when (cell:read usable)
        (cell:write! wanted 0)
        (for ((k 0 (+ k 1))) :while (< k r)
          (let w = (abs (arr:aref best (+ n k))))
          (when (and (/= w 0.0d0) (>= w cutoff)) (cell:write! wanted (+ (cell:read wanted) 1)))))
      ;; Room in the spare arrays.
      (let needed = (+ (cell:read filled) (cell:read wanted)))
      (when (> needed (arr:length (cell:read (.spare-rows s))))
        (let before = (cell:read (.spare-rows s)))
        (let before-values = (cell:read (.spare-values s)))
        (let size = (if (> (* 2 (arr:length before)) needed) (* 2 (arr:length before)) needed))
        (let grown-rows = (arr:make size (the UFix 0)))
        (let grown-values = (arr:make size 0.0d0))
        (for ((q 0 (+ q 1))) :while (< q (cell:read filled))
          (arr:set! grown-rows q (arr:aref before q))
          (arr:set! grown-values q (arr:aref before-values q)))
        (cell:write! (.spare-rows s) grown-rows)
        (cell:write! (.spare-values s) grown-values))
      (let fresh-rows = (cell:read (.spare-rows s)))
      (let fresh-values = (cell:read (.spare-values s)))
      (when (cell:read usable)
        ;; The vector's entry at a kept row is minus the row's multiplier there.
        (let at = (cell:new from))
        (for ((k 0 (+ k 1))) :while (< k r)
          (let w = (arr:aref best (+ n k)))
          (when (and (/= w 0.0d0) (>= (abs w) cutoff))
            (let row = (arr:aref kept-list k))
            (unless (and (< (cell:read at) to) (== (arr:aref old-rows (cell:read at)) row))
              (cell:write! reshaped True))
            (arr:set! fresh-rows (cell:read filled) row)
            (arr:set! fresh-values (cell:read filled) (- 0.0d0 w))
            (cell:write! filled (+ (cell:read filled) 1))
            (cell:write! at (+ (cell:read at) 1))))
        (unless (== (cell:read at) to) (cell:write! reshaped True))
        (cell:write! replaced (+ (cell:read replaced) 1)))
      (unless (cell:read usable)
        (for ((e from (+ e 1))) :while (< e to)
          (arr:set! fresh-rows (cell:read filled) (arr:aref old-rows e))
          (arr:set! fresh-values (cell:read filled) (arr:aref old-values e))
          (cell:write! filled (+ (cell:read filled) 1))))
      (arr:set! fresh-starts (+ p 1) (cell:read filled)))
    ;; The factor just used is of an earlier shift, and is not marked as the solve's: a step
    ;; makes its own.
    (when (== (cell:read replaced) 0) (return Refreshed))
    (let spare-rows = (cell:read (.spare-rows s)))
    (let spare-values = (cell:read (.spare-values s)))
    (cell:write! (.spare-rows s) (cell:read (.vector-rows s)))
    (cell:write! (.spare-values s) (cell:read (.vector-values s)))
    (cell:write! (.vector-rows s) spare-rows)
    (cell:write! (.vector-values s) spare-values)
    (for ((p 0 (+ p 1))) :while (<= p d)
      (arr:set! starts p (arr:aref fresh-starts p)))
    (arr:set! marks 2 (cell:read replaced))
    ;; The system of the rows left out: refilled and factored again where no vector changed its
    ;; rows, analyzed again where one did.
    (let refilled =
      (match (cell:read (.system ws))
        ((Some held)
         (if (or (cell:read reshaped) (/= (arr:length (.places held)) (cell:read filled)))
             False
             (progn
               (for ((e 0 (+ e 1))) :while (< e (cell:read filled))
                 (arr:set! (.values held) (arr:aref (.places held) e) (- 0.0d0 (arr:aref spare-values e))))
               (gram:refill! (.plan held) (.values held) (.product held))
               (arr:set! marks 0 (if (== (ldlt:factor! (.symbolic held) (.product held) -1.0d0) ldlt:FactorSuccess) 1 0))
               True)))
        ((None) False)))
    (unless refilled
      (let uses = (.uses ws))
      (for ((k 0 (+ k 1))) :while (< k r)
        (arr:set! uses k 0))
      (cell:write! (.system ws) (left-out-system! s (.numbers ws) r uses marks)))
    (arr:set! st 2 0)
    (unless (prove-bounds! s) (return RefreshNonFinite))
    (arr:set! st 2 1)
    Refreshed)

  (declare refreshed-count (KeptRows -> UFix))
  (define (refreshed-count kept)
    "Vectors the latest refresh! replaced; 0 when none stands or it replaced none."
    (let s = (storage kept))
    (match (cell:read (.step s))
      ((Some ws) (if (== (arr:aref (.state s) 0) 1) (arr:aref (.marks ws) 2) 0))
      ((None) 0))))
