(cl:defpackage #:coalton-linalg/sparse/scaling
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:csc #:coalton-linalg/sparse/csc)
                    (#:err #:coalton-linalg/errors))
  (:import-from #:coalton/math #:finite?)
  (:import-from #:coalton-linalg/internal/float #:scaled-product #:greatest-power)
  (:export #:row-maxima! #:column-maxima! #:equilibrate! #:scale! #:scale-vector!
           #:DiagonalStatus #:DiagonalScaled #:DiagonalNotPositive
           #:equilibrate-symmetric! #:scale-symmetric!))
(cl:in-package #:coalton-linalg/sparse/scaling)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

;;; Scaling by powers of two. See docs/scaling.md for the contract and the derivation.

(coalton-toplevel
  (derive Eq)
  (repr :enum)
  (define-type DiagonalStatus
    "Outcome of equilibrate-symmetric!."
    DiagonalScaled
    DiagonalNotPositive)

  ;; 2^512, 2^256, ..., 2^1: every exponent up to 1023 is a sum of some of these.
  (declare powers (arr:LispArray F64))
  (define powers
    (lisp (-> (arr:LispArray F64)) ()
      (cl:make-array 10 :element-type 'cl:double-float
                        :initial-contents (cl:loop :for k :from 9 :downto 0 :collect (cl:scale-float 1d0 (cl:ash 1 k))))))

  (declare replace-by-reciprocal-power! (arr:LispArray F64 * UFix -> Void))
  (define (replace-by-reciprocal-power! a i)
    "Replace a positive finite a[i] = f 2^e, f in [1/2, 1), by the power of two 2^-e, held to 2^1023 at most; anything else by 1. Only multiplications and divisions by powers of two are used, so every step is exact and nothing is allocated."
    (let x = (arr:aref a i))
    (unless (> x 0.0d0)
      (arr:set! a i 1.0d0)
      (return (values)))
    (let y = (cell:new x))
    (let r = (cell:new 1.0d0))
    ;; Down: take out every power that fits, largest first, leaving y below 2.
    (for ((k 0 (+ k 1))) :while (< k 10)
      (let p = (arr:aref powers k))
      (when (>= (cell:read y) p)
        (cell:write! y (/ (cell:read y) p))
        (cell:write! r (/ (cell:read r) p))))
    (when (>= (cell:read y) 1.0d0)
      (cell:write! y (/ (cell:read y) 2.0d0))
      (cell:write! r (/ (cell:read r) 2.0d0)))
    ;; Up: put in every power that keeps y below 1, largest first, leaving y at least 1/2
    ;; unless all ten together, 2^1023, are not enough.
    (for ((k 0 (+ k 1))) :while (< k 10)
      (let p = (arr:aref powers k))
      (when (< (* (cell:read y) p) 1.0d0)
        (cell:write! y (* (cell:read y) p))
        (cell:write! r (* (cell:read r) p))))
    (arr:set! a i (cell:read r)))

  (declare replace-by-reciprocal-root-power! (arr:LispArray F64 * UFix -> Void))
  (define (replace-by-reciprocal-root-power! a i)
    "Replace a positive finite a[i] by the power of two d with d^2 a[i] in [1/2, 2), which is unique; d is held to 2^511 at most. Exact and allocation-free as above."
    (let y = (cell:new (arr:aref a i)))
    (let d = (cell:new 1.0d0))
    ;; Down by even powers 2^(2j), halving d's exponent each time, leaving y below 4.
    (for ((k 1 (+ k 1))) :while (< k 10)
      (let half = (arr:aref powers k))
      (when (>= (cell:read y) (* half half))
        (cell:write! y (/ (cell:read y) (* half half)))
        (cell:write! d (/ (cell:read d) half))))
    (when (>= (cell:read y) 2.0d0)
      (cell:write! y (/ (cell:read y) 4.0d0))
      (cell:write! d (/ (cell:read d) 2.0d0)))
    ;; Up by even powers while y stays below 2, leaving y at least 1/2.
    (for ((k 1 (+ k 1))) :while (< k 10)
      (let half = (arr:aref powers k))
      (when (< (* (cell:read y) (* half half)) 2.0d0)
        (cell:write! y (* (cell:read y) (* half half)))
        (cell:write! d (* (cell:read d) half))))
    (arr:set! a i (cell:read d)))

  (declare check-values! (csc:Matrix * arr:LispArray F64 -> Void))
  (define (check-values! matrix values)
    "The values belong to this matrix's pattern, entry for entry, and are finite."
    (unless (== (arr:length values) (csc:entry-count matrix))
      (throw (err:InvalidDimensions "The value count differs from the matrix's stored entries.")))
    (for ((q 0 (+ q 1))) :while (< q (arr:length values))
      (unless (finite? (arr:aref values q))
        (throw (err:NonFiniteInput "Matrix values must be finite.")))))

  (declare check-scales! (arr:LispArray F64 * UFix -> Void))
  (define (check-scales! scales expected)
    (unless (== (arr:length scales) expected)
      (throw (err:InvalidDimensions "A scale vector's length differs from the matrix dimension.")))
    (for ((i 0 (+ i 1))) :while (< i expected)
      (unless (finite? (arr:aref scales i))
        (throw (err:NonFiniteInput "Scale factors must be finite.")))))

  (declare row-maxima! (csc:Matrix * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (row-maxima! matrix values out)
    "Write the largest magnitude in each row of the matrix's pattern with these values; 0 for a row with no entry."
    (check-values! matrix values)
    (unless (== (arr:length out) (csc:row-count matrix))
      (throw (err:InvalidDimensions "The output length differs from the row count.")))
    (when (unsafe-pointer-eq? out values)
      (throw (err:InvalidAliasing "The output must be distinct from the values.")))
    (let ri = (csc:row-indices matrix))
    (for ((i 0 (+ i 1))) :while (< i (arr:length out))
      (arr:set! out i 0.0d0))
    (for ((q 0 (+ q 1))) :while (< q (arr:length values))
      (let i = (arr:aref ri q))
      (when (> (abs (arr:aref values q)) (arr:aref out i))
        (arr:set! out i (abs (arr:aref values q))))))

  (declare column-maxima! (csc:Matrix * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (column-maxima! matrix values out)
    "Write the largest magnitude in each column of the matrix's pattern with these values; 0 for a column with no entry."
    (check-values! matrix values)
    (unless (== (arr:length out) (csc:column-count matrix))
      (throw (err:InvalidDimensions "The output length differs from the column count.")))
    (when (unsafe-pointer-eq? out values)
      (throw (err:InvalidAliasing "The output must be distinct from the values.")))
    (let cp = (csc:column-pointers matrix))
    (for ((j 0 (+ j 1))) :while (< j (arr:length out))
      (arr:set! out j 0.0d0)
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (when (> (abs (arr:aref values q)) (arr:aref out j))
          (arr:set! out j (abs (arr:aref values q)))))))

  (declare equilibrate! (csc:Matrix * arr:LispArray F64 * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (equilibrate! matrix values row-scales column-scales)
    "Write powers of two r and c so that every row and every column of r[i] a[i,j] c[j] that has a nonzero has its largest magnitude in [1/2, 1), or below 1/2 under the largest factor there is where no factor reaches. See docs/scaling.md."
    (check-values! matrix values)
    (unless (and (== (arr:length row-scales) (csc:row-count matrix))
                 (== (arr:length column-scales) (csc:column-count matrix)))
      (throw (err:InvalidDimensions "A scale vector's length differs from the matrix dimension.")))
    (when (or (unsafe-pointer-eq? row-scales values)
              (unsafe-pointer-eq? column-scales values)
              (unsafe-pointer-eq? row-scales column-scales))
      (throw (err:InvalidAliasing "The two scale vectors and the values must be three arrays.")))
    (let cp = (csc:column-pointers matrix))
    (let ri = (csc:row-indices matrix))
    ;; Rows first: each row's largest magnitude is brought into [1/2, 1).
    (for ((i 0 (+ i 1))) :while (< i (arr:length row-scales))
      (arr:set! row-scales i 0.0d0))
    (for ((q 0 (+ q 1))) :while (< q (arr:length values))
      (let i = (arr:aref ri q))
      (when (> (abs (arr:aref values q)) (arr:aref row-scales i))
        (arr:set! row-scales i (abs (arr:aref values q)))))
    (for ((i 0 (+ i 1))) :while (< i (arr:length row-scales))
      (replace-by-reciprocal-power! row-scales i))
    ;; Then columns, on the row-scaled entries. Those are all below 1, so a column's factor is
    ;; at least 1 and at most what brings its own largest entry under 1: no row leaves [1/2, 1).
    ;; A row-scaled entry can be far below the normal range, where it would be rounded or lost,
    ;; so each is taken 2^1023 times larger, which is exact down to 2^-2045. A largest lifted
    ;; magnitude of f 2^e with e from 0 to 1023 asks for the factor 2^(1023 - e); one below 1/2
    ;; asks for more than there is and gets 2^1023.
    (for ((j 0 (+ j 1))) :while (< j (arr:length column-scales))
      (let largest = (cell:new 0.0d0))
      (let present = (cell:new False))
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (let magnitude = (abs (arr:aref values q)))
        (when (> magnitude 0.0d0) (cell:write! present True))
        (let lifted = (scaled-product magnitude (arr:aref row-scales (arr:aref ri q)) greatest-power))
        (when (> lifted (cell:read largest))
          (cell:write! largest lifted)))
      (cond
        ((not (cell:read present)) (arr:set! column-scales j 1.0d0))
        ((< (cell:read largest) 0.5d0) (arr:set! column-scales j greatest-power))
        (True
         (arr:set! column-scales j (cell:read largest))
         (replace-by-reciprocal-power! column-scales j)
         (arr:set! column-scales j (* (arr:aref column-scales j) greatest-power))))))

  (declare scale! (csc:Matrix * arr:LispArray F64 * arr:LispArray F64 * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (scale! matrix values row-scales column-scales out)
    "Write r[i] a[i,j] c[j] for every stored entry, in the matrix's order. Output must differ from the values; preflight preserves it and an arithmetic refusal leaves it unspecified."
    (check-values! matrix values)
    (check-scales! row-scales (csc:row-count matrix))
    (check-scales! column-scales (csc:column-count matrix))
    (unless (== (arr:length out) (arr:length values))
      (throw (err:InvalidDimensions "The output length differs from the value count.")))
    (when (or (unsafe-pointer-eq? out values)
              (unsafe-pointer-eq? out row-scales)
              (unsafe-pointer-eq? out column-scales))
      (throw (err:InvalidAliasing "The output must be distinct from the values and the scale vectors.")))
    (let cp = (csc:column-pointers matrix))
    (let ri = (csc:row-indices matrix))
    (for ((j 0 (+ j 1))) :while (< j (csc:column-count matrix))
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (arr:set! out q (scaled-product (arr:aref values q) (arr:aref row-scales (arr:aref ri q))
                                        (arr:aref column-scales j)))))
    (for ((q 0 (+ q 1))) :while (< q (arr:length out))
      (unless (finite? (arr:aref out q))
        (throw (err:NonFiniteResult "A scaled value is not finite.")))))

  (declare scale-vector! (arr:LispArray F64 * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (scale-vector! scales x out)
    "Write scales[i] x[i]. Output may be x itself and must differ from the scales; an arithmetic refusal leaves it unspecified."
    (unless (and (== (arr:length scales) (arr:length x)) (== (arr:length out) (arr:length x)))
      (throw (err:InvalidDimensions "The scale vector, the input and the output must have one length.")))
    (when (unsafe-pointer-eq? out scales)
      (throw (err:InvalidAliasing "The output must be distinct from the scale vector.")))
    (for ((i 0 (+ i 1))) :while (< i (arr:length x))
      (unless (and (finite? (arr:aref scales i)) (finite? (arr:aref x i)))
        (throw (err:NonFiniteInput "Scale factors and vector entries must be finite."))))
    (for ((i 0 (+ i 1))) :while (< i (arr:length x))
      (arr:set! out i (* (arr:aref scales i) (arr:aref x i))))
    (for ((i 0 (+ i 1))) :while (< i (arr:length out))
      (unless (finite? (arr:aref out i))
        (throw (err:NonFiniteResult "A scaled vector entry is not finite.")))))

  (declare check-lower! (csc:Matrix -> Void))
  (define (check-lower! matrix)
    "Square, and every column begins with its diagonal: the lower triangle of a symmetric matrix."
    (unless (== (csc:row-count matrix) (csc:column-count matrix))
      (throw (err:InvalidDimensions "Symmetric scaling requires a square matrix.")))
    (let cp = (csc:column-pointers matrix))
    (let ri = (csc:row-indices matrix))
    (for ((j 0 (+ j 1))) :while (< j (csc:column-count matrix))
      (unless (and (< (arr:aref cp j) (arr:aref cp (+ j 1)))
                   (== (arr:aref ri (arr:aref cp j)) j))
        (throw (err:InvalidStructure "Every column of a lower symmetric matrix must begin with its diagonal.")))))

  (declare equilibrate-symmetric! (csc:Matrix * arr:LispArray F64 * arr:LispArray F64 -> DiagonalStatus))
  (define (equilibrate-symmetric! matrix values scales)
    "For the lower triangle of a symmetric matrix with a positive diagonal, write powers of two d so that every d[i] a[i,i] d[i] is in [1/2, 2). A diagonal entry that is not positive is refused with the scales untouched. See docs/scaling.md."
    (check-lower! matrix)
    (check-values! matrix values)
    (unless (== (arr:length scales) (csc:column-count matrix))
      (throw (err:InvalidDimensions "The scale vector's length differs from the matrix order.")))
    (when (unsafe-pointer-eq? scales values)
      (throw (err:InvalidAliasing "The scale vector must be distinct from the values.")))
    (let cp = (csc:column-pointers matrix))
    (for ((j 0 (+ j 1))) :while (< j (arr:length scales))
      (unless (> (arr:aref values (arr:aref cp j)) 0.0d0)
        (return DiagonalNotPositive)))
    (for ((j 0 (+ j 1))) :while (< j (arr:length scales))
      (arr:set! scales j (arr:aref values (arr:aref cp j)))
      (replace-by-reciprocal-root-power! scales j))
    DiagonalScaled)

  (declare scale-symmetric! (csc:Matrix * arr:LispArray F64 * arr:LispArray F64 * arr:LispArray F64 -> Void))
  (define (scale-symmetric! matrix values scales out)
    "Write d[i] a[i,j] d[j] for every stored entry of a lower symmetric matrix, in its order. Output must differ from the values; preflight preserves it and an arithmetic refusal leaves it unspecified."
    (check-lower! matrix)
    (check-values! matrix values)
    (check-scales! scales (csc:column-count matrix))
    (unless (== (arr:length out) (arr:length values))
      (throw (err:InvalidDimensions "The output length differs from the value count.")))
    (when (or (unsafe-pointer-eq? out values) (unsafe-pointer-eq? out scales))
      (throw (err:InvalidAliasing "The output must be distinct from the values and the scale vector.")))
    (let cp = (csc:column-pointers matrix))
    (let ri = (csc:row-indices matrix))
    (for ((j 0 (+ j 1))) :while (< j (csc:column-count matrix))
      (for ((q (arr:aref cp j) (+ q 1))) :while (< q (arr:aref cp (+ j 1)))
        (arr:set! out q (scaled-product (arr:aref values q) (arr:aref scales (arr:aref ri q))
                                        (arr:aref scales j)))))
    (for ((q 0 (+ q 1))) :while (< q (arr:length out))
      (unless (finite? (arr:aref out q))
        (throw (err:NonFiniteResult "A scaled symmetric value is not finite."))))))
