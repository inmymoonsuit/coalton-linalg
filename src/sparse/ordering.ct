(cl:defpackage #:coalton-linalg/sparse/ordering
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:arr #:coalton/lisparray) (#:cell #:coalton/cell)
                    (#:ht #:coalton/hashtable) (#:iter #:coalton/iterator)
                    (#:math #:coalton/math) (#:err #:coalton-linalg/errors))
  (:export #:GraphOrdering #:minimum-degree))
(cl:in-package #:coalton-linalg/sparse/ordering)
(cl:declaim (cl:optimize (cl:speed 3) (cl:safety #.(cl:if (cl:member :coalton-linalg-safety-zero cl:*features*) 0 1))))

(coalton-toplevel
  (define-struct GraphOrdering
    "Private symbolic intermediate. Neighbor columns contain sorted original vertex indices."
    (permutation (arr:LispArray UFix))
    (inverse (arr:LispArray UFix))
    (neighbors (arr:LispArray (arr:LispArray UFix))))

  (declare precedes? (arr:LispArray UFix * UFix * UFix -> Boolean))
  (define (precedes? key a b)
    "Heap order: smaller key first, then smaller original index. A key is a live degree, raised while its vertex is held."
    (let da = (arr:aref key a))
    (let db = (arr:aref key b))
    (or (< da db) (and (== da db) (< a b))))

  (declare heap-swap! (arr:LispArray UFix * arr:LispArray UFix * UFix * UFix -> Void))
  (define (heap-swap! heap positions a b)
    (let va = (arr:aref heap a))
    (let vb = (arr:aref heap b))
    (arr:set! heap a vb)
    (arr:set! heap b va)
    (arr:set! positions va b)
    (arr:set! positions vb a))

  (declare sift-up! (arr:LispArray UFix * arr:LispArray UFix * arr:LispArray UFix * UFix -> Void))
  (define (sift-up! heap positions degree start)
    (let at = (cell:new start))
    (for () :while (> (cell:read at) 0)
      (let parent = (math:quot (- (cell:read at) 1) 2))
      (unless (precedes? degree (arr:aref heap (cell:read at)) (arr:aref heap parent))
        (return (values)))
      (heap-swap! heap positions (cell:read at) parent)
      (cell:write! at parent)))

  (declare sift-down! (arr:LispArray UFix * arr:LispArray UFix * arr:LispArray UFix * UFix * UFix -> Void))
  (define (sift-down! heap positions degree count start)
    (let at = (cell:new start))
    (for () :while (< (cell:read at) (math:quot count 2))
      (let left = (+ (* 2 (cell:read at)) 1))
      (let right = (+ left 1))
      (let best =
        (if (and (< right count)
                 (precedes? degree (arr:aref heap right) (arr:aref heap left)))
            right left))
      (unless (precedes? degree (arr:aref heap best) (arr:aref heap (cell:read at)))
        (return (values)))
      (heap-swap! heap positions (cell:read at) best)
      (cell:write! at best)))

  (declare repair! (arr:LispArray UFix * arr:LispArray UFix * arr:LispArray UFix * UFix * UFix -> Void))
  (define (repair! heap positions degree count vertex)
    "Restore an ordered heap after changing exactly one live vertex's key."
    (let at = (arr:aref positions vertex))
    (if (and (> at 0)
             (precedes? degree vertex (arr:aref heap (math:quot (- at 1) 2))))
        (sift-up! heap positions degree at)
        (sift-down! heap positions degree count at)))

  (declare minimum-degree
    (UFix * arr:LispArray UFix * arr:LispArray UFix * UFix * UFix -> GraphOrdering))
  (define (minimum-degree n columns rows maximum-entries leading)
    "Order validated lower CSC by exact live degree, then original index. The caller bounds n and initial entries; growth counts factor entries including the unit diagonal. Vertices from leading on are held back; each eliminated vertex below leading releases one held neighbour, the one of least degree; leading = n holds nothing."
    (let degree = (arr:make n (the UFix 0)))
    (for ((j 0 (+ j 1))) :while (< j n)
      (for ((q (+ (arr:aref columns j) 1) (+ q 1))) :while (< q (arr:aref columns (+ j 1)))
        (let i = (arr:aref rows q))
        (arr:set! degree i (+ (arr:aref degree i) 1))
        (arr:set! degree j (+ (arr:aref degree j) 1))))
    (let empty-table = (the (ht:HashTable UFix Unit) (ht:with-capacity 0)))
    (let graph = (arr:make n empty-table))
    (for ((i 0 (+ i 1))) :while (< i n)
      (when (> (arr:aref degree i) 0)
        (arr:set! graph i (ht:with-capacity (into (arr:aref degree i))))))
    (for ((j 0 (+ j 1))) :while (< j n)
      (for ((q (+ (arr:aref columns j) 1) (+ q 1))) :while (< q (arr:aref columns (+ j 1)))
        (let i = (arr:aref rows q))
        (ht:set! (arr:aref graph i) j Unit)
        (ht:set! (arr:aref graph j) i Unit)))
    ;; A held vertex's key is its degree plus n + 1, more than any degree, so every free vertex
    ;; precedes every held one and held vertices are still taken, least degree first, when no
    ;; free vertex is left.
    (let hold = (arr:make n (the UFix 0)))
    (let key = (arr:make n (the UFix 0)))
    (for ((i 0 (+ i 1))) :while (< i n)
      (when (>= i leading) (arr:set! hold i (+ n 1)))
      (arr:set! key i (+ (arr:aref degree i) (arr:aref hold i))))
    (let heap = (arr:make n (the UFix 0)))
    (let positions = (arr:make n (the UFix 0)))
    (let permutation = (arr:make n (the UFix 0)))
    (let inverse = (arr:make n (the UFix 0)))
    (let neighbors = (arr:make n (arr:make 0 (the UFix 0))))
    (let entries = (cell:new (arr:length rows)))
    (for ((i 0 (+ i 1))) :while (< i n)
      (arr:set! heap i i)
      (arr:set! positions i i))
    (let remaining-parents = (cell:new (math:quot n 2)))
    (for () :while (> (cell:read remaining-parents) 0)
      (cell:write! remaining-parents (- (cell:read remaining-parents) 1))
      (sift-down! heap positions key n (cell:read remaining-parents)))
    (for ((k 0 (+ k 1))) :while (< k n)
      (let v = (arr:aref heap 0))
      (let remaining = (- (- n k) 1))
      (when (> remaining 0)
        (let last = (arr:aref heap remaining))
        (arr:set! heap 0 last)
        (arr:set! positions last 0)
        (sift-down! heap positions key remaining 0))
      (arr:set! positions v n)
      (let adj = (arr:make (arr:aref degree v) (the UFix 0)))
      (let cursor = (cell:new (the UFix 0)))
      (iter:for-each!
        (fn (neighbor)
          (arr:set! adj (cell:read cursor) neighbor)
          (cell:write! cursor (+ (cell:read cursor) 1))
          (values))
        (ht:keys (arr:aref graph v)))
      (lisp (-> Void) (adj) (cl:sort adj #'cl:<) (cl:values))
      (arr:set! permutation k v)
      (arr:set! inverse v k)
      (arr:set! neighbors k adj)
      (arr:set! graph v empty-table)
      (for ((a 0 (+ a 1))) :while (< a (arr:length adj))
        (ht:remove! (arr:aref graph (arr:aref adj a)) v))
      (for ((a 0 (+ a 1))) :while (< a (arr:length adj))
        (let i = (arr:aref adj a))
        (let table = (arr:aref graph i))
        (for ((b (+ a 1) (+ b 1))) :while (< b (arr:length adj))
          (let j = (arr:aref adj b))
          (match (ht:get table j)
            ((Some _) (values))
            ((None)
             (when (>= (cell:read entries) maximum-entries)
               (throw (err:AnalysisStorageExceeded
                       (+ (the Integer (into (cell:read entries))) 1)
                       maximum-entries)))
             (cell:write! entries (+ (cell:read entries) 1))
             (ht:set! table j Unit)
             (ht:set! (arr:aref graph j) i Unit)))))
      ;; Only one heap key changes before each repair; the other keys remain ordered.
      ;; n stands for no held neighbour seen yet.
      (let chosen = (cell:new n))
      (for ((a 0 (+ a 1))) :while (< a (arr:length adj))
        (let i = (arr:aref adj a))
        (arr:set! degree i (unwrap-into (ht:count (arr:aref graph i))))
        (arr:set! key i (+ (arr:aref degree i) (arr:aref hold i)))
        (repair! heap positions key remaining i)
        (when (and (< v leading) (> (arr:aref hold i) 0))
          (when (or (== (cell:read chosen) n)
                    (< (arr:aref degree i) (arr:aref degree (cell:read chosen))))
            (cell:write! chosen i))))
      ;; Eliminating a vertex below leading releases one neighbour it held, the one of least
      ;; degree and, among equals, of least index: no two rows are released by the same column.
      (when (< (cell:read chosen) n)
        (let released = (cell:read chosen))
        (arr:set! hold released 0)
        (arr:set! key released (arr:aref degree released))
        (repair! heap positions key remaining released)))
    (GraphOrdering permutation inverse neighbors)))
